---
/**
 * DIRECTION B — "The Line"
 *
 * Thesis: the town is named for a creek, and the church is named for the
 * cross. One coral line does both jobs. It enters at the top of the page and
 * runs the whole length of it, meandering like water finding its way down a
 * hill, drawn just ahead of wherever you have read to. At the scripture it has
 * already straightened, and it grows an arm — becoming the cross from the
 * church's own mark.
 *
 * Light rather than dark, on purpose: the brief asked for bold, and everyone
 * reaches for black to get there.
 *
 * The line is generated in JS at real pixel dimensions against the document
 * (not the viewport) so the meander, the stroke weight, and the crossbar all
 * hold their proportions at any size — and so the crossbar can be placed at the
 * exact y where the scripture lands. See the script at the bottom.
 */
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/public-sans';
import '@fontsource/jetbrains-mono/400.css';
import BrooksideMark from '../../components/BrooksideMark.astro';
import data from '../../data/sermons.json';

const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const longDate = (iso: string) => {
	const [y, m, d] = iso.split('-');
	return `${months[Number(m) - 1]} ${Number(d)}, ${y}`;
};
const shortDate = (iso: string) => {
	const [, m, d] = iso.split('-');
	return `${months[Number(m) - 1].slice(0, 3)} ${Number(d)}`;
};

const latest = data.recent[0];
const previous = data.recent.slice(1, 5);
const years = new Date(data.newest).getFullYear() - new Date(data.oldest).getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Direction B · The Line</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<!--
			The line. Spans the document in the left rail, draws itself just ahead
			of your reading position, and grows a crossbar at the scripture.
			Geometry is written by the script below; this is only the shell.
		-->
		<svg class="thread" aria-hidden="true" fill="none">
			<path id="thread-path" stroke="#FF5757" stroke-linecap="butt" />
			<path id="thread-bar" stroke="#FF5757" stroke-linecap="butt" />
		</svg>

		<header class="chrome">
			<a class="chrome__brand" href="/directions/">
				<BrooksideMark class="chrome__mark" letter="#101010" cross="#FF5757" />
				<span class="chrome__word">Brookside</span>
			</a>
			<nav class="chrome__nav">
				<a href="#">Visit</a>
				<a href="#">Watch</a>
				<a href="#">About</a>
				<a class="chrome__give" href="#">Give</a>
			</nav>
		</header>

		<main>
			<section class="bay hero">
				<p class="eyebrow">200 Cardiff Street · Brookside, Alabama</p>
				<h1 class="hero__title" data-split>
					Preaching<br />Christ<br /><em>crucified</em>
				</h1>
				<div class="hero__foot">
					<p class="hero__lede">
						One church on Cardiff Street, working through the Bible a passage at a
						time. Come as you are, sit where you like, leave knowing what the text
						said.
					</p>
					<dl class="hours">
						<div><dt>Sunday School</dt><dd>9:45 AM</dd></div>
						<div><dt>Sunday Worship</dt><dd>10:45 AM</dd></div>
						<div><dt>Wednesday</dt><dd>6:30 PM</dd></div>
					</dl>
				</div>
				<div class="actions">
					<a class="btn btn--solid" href="#">Plan your visit</a>
					<a class="btn btn--line" href="#">Hear this week's sermon</a>
				</div>
			</section>

			<section class="bay rule latest">
				<p class="eyebrow">This week</p>
				<div class="latest__lead">
					<h2 class="latest__title">{latest.title}</h2>
					<p class="latest__by">
						Brad Lindsey · {longDate(latest.date)}
					</p>
					<a class="link" href="#">Listen to this sermon &rarr;</a>
				</div>
				<ol class="prior">
					{previous.map((s) => (
						<li>
							<a href="#">
								<span class="prior__date">{shortDate(s.date)}</span>
								<span class="prior__title">{s.title}</span>
							</a>
						</li>
					))}
				</ol>
				<a class="link link--quiet" href="#">All {data.total} sermons &rarr;</a>
			</section>

			<section class="bay verse">
				<blockquote>
					<p>
						For I determined not to know any thing among you, save Jesus Christ,
						and him <em>crucified</em>.
					</p>
					<cite>1 Corinthians 2:2</cite>
				</blockquote>
			</section>

			<section class="bay rule grid">
				<article>
					<h3>New here?</h3>
					<p>
						Park anywhere, come in the front doors, and someone will point you the
						rest of the way. Nobody will ask you to stand up.
					</p>
					<a class="link" href="#">What a Sunday looks like &rarr;</a>
				</article>
				<article>
					<h3>{data.total} sermons</h3>
					<p>
						{years} years of preaching, all of it free, on Apple Podcasts, Spotify,
						and right here.
					</p>
					<a class="link" href="#">Browse the archive &rarr;</a>
				</article>
				<article>
					<h3>Kids on Sunday</h3>
					<p>
						Nursery and Kids Church both run during the 10:45 service, staffed by
						people the church knows.
					</p>
					<a class="link" href="#">Kids and childcare &rarr;</a>
				</article>
			</section>
		</main>

		<footer class="bay rule rule--heavy foot">
			<div class="foot__brand">
				<BrooksideMark class="foot__mark" letter="#101010" cross="#FF5757" />
				<p class="foot__name">Brookside<br />Church of God</p>
			</div>
			<div class="foot__cols">
				<div>
					<h4>Find us</h4>
					<p>200 Cardiff Street<br />Brookside, Alabama 35036</p>
					<a class="link" href="#">Directions &rarr;</a>
				</div>
				<div>
					<h4>Reach us</h4>
					<p><a href="tel:+12056750703">(205) 675-0703</a><br /><a href="mailto:info@brooksidecog.com">info@brooksidecog.com</a></p>
				</div>
				<div>
					<h4>Follow</h4>
					<p>
						<a href="#">Facebook</a><br /><a href="#">Instagram</a><br /><a href="#">YouTube</a>
					</p>
				</div>
			</div>
		</footer>

		<style is:global>
			:root {
				--paper: #fafaf8;
				--ink: #101010;
				--iron: #2f2f2f;
				--ash: #d9d9d9;
				--coral: #ff5757;
				--display: 'Bricolage Grotesque Variable', system-ui, sans-serif;
				--body: 'Public Sans Variable', system-ui, sans-serif;
				--mono: 'JetBrains Mono', ui-monospace, monospace;

				/* The spine. Everything on the page is measured off these two. */
				--rail: clamp(2.25rem, 6vw, 5rem);
				--gutter: clamp(0.875rem, 2.4vw, 2.25rem);
				--edge: calc(var(--rail) + var(--gutter));
				--flank: clamp(1.25rem, 5vw, 5rem);
			}
			* { box-sizing: border-box; }
			body {
				margin: 0; background: var(--paper); color: var(--ink);
				font-family: var(--body); -webkit-font-smoothing: antialiased;
			}
			a { color: inherit; text-decoration: none; }
			:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
			em { font-style: normal; color: var(--coral); }

			.thread {
				position: absolute; top: 0; left: 0;
				width: var(--rail);
				z-index: 0; pointer-events: none; overflow: visible;
			}
			main, .foot { position: relative; z-index: 1; }

			/*
				One rule owns the horizontal placement of every band on the page, so
				the spine can never drift out of sync with the content. Sections set
				padding-block only — never padding or padding-left — or they would
				silently cancel this out.
			*/
			.bay {
				padding-left: var(--edge);
				padding-right: var(--flank);
				max-width: calc(var(--edge) + 1180px);
			}

			/*
				Section rules start at the content edge rather than the viewport edge,
				so the line runs the height of the page without being chopped into
				segments by every horizontal it passes.
			*/
			.rule { position: relative; }
			.rule::before {
				content: ''; position: absolute; top: 0;
				left: var(--edge); right: var(--flank);
				border-top: 1px solid var(--ash);
			}
			.rule--heavy::before { border-top: 2px solid var(--ink); }

			/* ---------- chrome ---------- */
			.chrome {
				display: flex; align-items: center; justify-content: space-between;
				gap: 1rem;
				padding: 1.05rem var(--flank) 1.05rem var(--edge);
				/* Above main, which also creates a stacking context — at equal
				   z-index the later element in the DOM would paint over the header. */
				position: sticky; top: 0; z-index: 10;
				background: color-mix(in srgb, var(--paper) 96%, transparent);
				backdrop-filter: blur(10px);
			}
			.chrome__brand { display: flex; align-items: center; gap: 0.55rem; }
			.chrome__mark { width: 27px; height: 27px; display: block; }
			.chrome__word {
				font-family: var(--display); font-variation-settings: 'wght' 700;
				font-size: 1.08rem; letter-spacing: -0.03em;
			}
			.chrome__nav { display: flex; align-items: center; gap: clamp(0.9rem, 2vw, 2rem); }
			.chrome__nav a { font-size: 0.9rem; color: var(--iron); }
			.chrome__nav a:hover { color: var(--ink); }
			.chrome__nav .chrome__give {
				color: var(--coral); font-weight: 600;
				border-bottom: 2px solid var(--coral); padding-bottom: 2px;
			}

			.eyebrow {
				font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.16em;
				text-transform: uppercase; color: var(--iron); margin: 0 0 1.15rem;
			}

			/* ---------- hero ---------- */
			.hero { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(3rem, 7vw, 4.5rem); }
			.hero__title {
				margin: 0; font-family: var(--display);
				font-size: clamp(3.1rem, 12.5vw, 10.5rem);
				font-variation-settings: 'wght' 800, 'opsz' 48;
				line-height: 0.86; letter-spacing: -0.045em;
			}
			.hero__foot {
				display: flex; flex-wrap: wrap; gap: clamp(1.75rem, 5vw, 4.5rem);
				align-items: start; margin-top: clamp(2rem, 4vw, 3rem);
			}
			.hero__lede {
				margin: 0; max-width: 42ch; flex: 1 1 24rem;
				font-size: clamp(1.02rem, 1.4vw, 1.18rem); line-height: 1.6; color: var(--iron);
			}
			/* Service times as a definition list: the label and the time are a pair,
			   and the times align on their own column so they read as a schedule. */
			.hours {
				margin: 0 0 0 auto; flex: 0 1 auto; min-width: 15rem;
				border-top: 2px solid var(--ink); padding-top: 0.85rem;
			}
			.hours div {
				display: flex; justify-content: space-between; gap: 2.5rem;
				padding: 0.42rem 0; border-bottom: 1px solid var(--ash);
			}
			.hours div:last-child { border-bottom: 0; }
			.hours dt { font-size: 0.88rem; color: var(--iron); }
			.hours dd {
				margin: 0; font-family: var(--mono); font-size: 0.88rem;
				font-variant-numeric: tabular-nums; color: var(--ink);
			}
			.actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: clamp(2rem, 4vw, 2.75rem); }
			.btn {
				display: inline-flex; align-items: center; padding: 0.9rem 1.7rem;
				border-radius: 999px; font-size: 0.92rem; font-weight: 600;
				transition: background 0.2s, color 0.2s, border-color 0.2s;
			}
			.btn--solid { background: var(--ink); color: var(--paper); }
			.btn--solid:hover { background: var(--coral); color: #1a0505; }
			.btn--line { border: 1.5px solid var(--ash); color: var(--ink); }
			.btn--line:hover { border-color: var(--ink); }

			/* ---------- this week ---------- */
			.latest {
				padding-block: clamp(3rem, 7vw, 5rem);
				display: grid; gap: clamp(1.5rem, 2.5vw, 2.25rem) clamp(1.75rem, 4vw, 3.5rem);
				grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
				align-items: start;
			}
			.latest .eyebrow { grid-column: 1 / -1; margin-bottom: 0; }
			.latest__title {
				margin: 0; font-family: var(--display);
				font-size: clamp(2rem, 4.6vw, 3.5rem);
				font-variation-settings: 'wght' 600, 'opsz' 36;
				line-height: 1.02; letter-spacing: -0.035em; text-wrap: balance;
			}
			.latest__by { margin: 0.9rem 0 1.25rem; color: var(--iron); font-size: 0.95rem; }
			.prior { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ash); }
			.prior a {
				display: flex; gap: 1.1rem; align-items: baseline;
				padding: 0.7rem 0; border-bottom: 1px solid var(--ash);
			}
			.prior a:hover .prior__title { color: var(--coral); }
			.prior__date {
				flex: none; width: 3.6rem; font-family: var(--mono);
				font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
				color: var(--iron);
			}
			.prior__title { font-size: 0.95rem; transition: color 0.18s; text-wrap: balance; }
			.link {
				font-weight: 600; color: var(--coral);
				border-bottom: 1.5px solid transparent; transition: border-color 0.2s;
			}
			.link:hover { border-color: var(--coral); }
			.link--quiet { grid-column: 1 / -1; justify-self: start; font-size: 0.92rem; }

			/* ---------- verse ---------- */
			.verse { padding-block: clamp(4.5rem, 11vw, 8rem); }
			.verse blockquote { margin: 0; }
			.verse p {
				/* The measure has to live on the element that carries the display
				   size — a ch on the blockquote would resolve against body text and
				   crush this to a one-word column. */
				margin: 0; max-width: 17ch; font-family: var(--display);
				font-size: clamp(1.9rem, 5.2vw, 3.9rem);
				font-variation-settings: 'wght' 500, 'opsz' 36;
				line-height: 1.06; letter-spacing: -0.03em; text-wrap: pretty;
			}
			.verse cite {
				display: block; margin-top: 1.6rem; font-style: normal;
				font-family: var(--mono); font-size: 0.7rem;
				letter-spacing: 0.18em; text-transform: uppercase; color: var(--iron);
			}

			/* ---------- grid ---------- */
			.grid {
				display: grid; gap: clamp(1.75rem, 3.5vw, 3rem);
				grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
				padding-block: clamp(3rem, 6vw, 4.5rem);
			}
			.grid h3 {
				margin: 0 0 0.7rem; font-family: var(--display);
				font-size: 1.35rem; font-variation-settings: 'wght' 700;
				letter-spacing: -0.025em;
			}
			.grid p { margin: 0 0 0.9rem; color: var(--iron); line-height: 1.6; font-size: 0.96rem; }

			/* ---------- footer ---------- */
			.foot {
				padding-block: clamp(3rem, 6vw, 4.5rem) clamp(3.5rem, 7vw, 5.5rem);
				display: grid; gap: clamp(2rem, 4vw, 3.5rem);
				grid-template-columns: minmax(10rem, 0.6fr) minmax(0, 2.4fr);
				align-items: start;
			}
			.foot__brand { display: flex; align-items: center; gap: 0.65rem; }
			.foot__mark { width: 34px; height: 34px; display: block; flex: none; }
			.foot__name {
				margin: 0; font-family: var(--display); font-size: 1.02rem;
				font-variation-settings: 'wght' 700; letter-spacing: -0.03em;
				line-height: 1.15;
			}
			.foot__cols {
				display: grid; gap: clamp(1.5rem, 3vw, 2.5rem);
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			}
			.foot h4 {
				margin: 0 0 0.7rem; font-family: var(--mono); font-weight: 400;
				font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
				color: var(--iron);
			}
			.foot p { margin: 0 0 0.7rem; font-size: 0.95rem; line-height: 1.65; color: var(--iron); }
			.foot__cols a:not(.link):hover { color: var(--coral); }

			/* Narrow phones: the wordmark steps out and the mark carries the brand
			   on its own, which is the whole reason it has to read at 27px. */
			@media (max-width: 600px) {
				.chrome__word { display: none; }
				.chrome__nav { gap: 1rem; }
			}

			@media (max-width: 720px) {
				.latest { grid-template-columns: 1fr; }
				.foot { grid-template-columns: 1fr; }
				.hours { width: 100%; }
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 0.001ms !important;
					transition-duration: 0.001ms !important;
				}
			}
		</style>

		<script>
			import gsap from 'gsap';
			import ScrollTrigger from 'gsap/ScrollTrigger';
			import SplitText from 'gsap/SplitText';
			import Lenis from 'lenis';

			gsap.registerPlugin(ScrollTrigger, SplitText);
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const svg = document.querySelector<SVGSVGElement>('.thread');
			const path = document.querySelector<SVGPathElement>('#thread-path');
			const bar = document.querySelector<SVGPathElement>('#thread-bar');
			const verse = document.querySelector<HTMLElement>('.verse');

			/** Length along the path at which the crossbar sits, and its own length. */
			let pathLen = 0;
			let barLen = 0;
			let lenAtBar = 0;
			/** length-at-y lookup, sampled once per build. */
			let samples: { len: number; y: number }[] = [];
			let barDrawn = false;
			/** Set once the scripture is actually on screen. */
			let barArmed = false;
			/** True while the opening draw-in owns the line; scroll leaves it alone. */
			let intro = false;
			let introPlayed = false;
			/** How far below the reading position the head of the line sits. */
			const HEAD = 0.96;

			/**
			 * Writes the line's geometry at real pixel dimensions against the
			 * document. Doing this in JS rather than a fixed viewBox is what lets the
			 * meander, the stroke, and the crossbar all keep their proportions at any
			 * viewport — and lets the crossbar be placed at the exact y where the
			 * scripture lands, so the cross forms on the beat instead of near it.
			 */
			function build() {
				if (!svg || !path || !bar || !verse) return;

				const docH = document.documentElement.scrollHeight;
				const vh = window.innerHeight;
				// Measured off the element, not read off the custom property:
				// getComputedStyle hands back an unresolved clamp() for --rail.
				const rail = svg.getBoundingClientRect().width;
				if (!rail || !docH) return;
				const cx = rail / 2;
				const stroke = Math.min(9, Math.max(5, rail * 0.17));
				// Held well inside the rail on both sides: swinging the full width
				// makes the line read as unruly rather than as the page's spine, and
				// it goes tangent to the viewport edge at the widest bends.
				const amp = rail * 0.28;

				svg.style.height = `${docH}px`;
				svg.setAttribute('viewBox', `0 0 ${rail} ${docH}`);
				path.setAttribute('stroke-width', String(stroke));
				bar.setAttribute('stroke-width', String(stroke));

				// Put the crossbar where the scripture will be sitting in the upper
				// third of the screen — the proportion that reads as a latin cross
				// rather than a lowercase t.
				const verseMid = verse.offsetTop + verse.offsetHeight / 2;
				const barY = Math.min(docH - stroke, Math.max(vh * 0.5, verseMid - vh * 0.18));
				// The line must already be straight well before it gets there.
				const meanderEnd = Math.max(vh * 0.6, barY - vh * 0.42);

				// Serpentine: vertical tangents at every node, so it reads as water
				// rather than as a zigzag. Bend count follows the distance covered.
				const bends = Math.min(7, Math.max(3, Math.round(meanderEnd / 620)));
				let d = `M${cx} 0`;
				let px = cx;
				let py = 0;
				for (let i = 0; i < bends; i++) {
					const y = (meanderEnd * (i + 1)) / bends;
					const x = i === bends - 1 ? cx : i % 2 === 0 ? cx + amp : cx - amp;
					const dy = (y - py) * 0.55;
					d += ` C${px} ${py + dy}, ${x} ${y - dy}, ${x} ${y}`;
					px = x;
					py = y;
				}
				d += ` L${cx} ${docH}`;
				path.setAttribute('d', d);

				// Kept inside the rail: an arm long enough to overhang the viewport
				// edge gets clipped, which reads as a broken cross.
				const arm = Math.max(stroke * 2, cx - stroke / 2 - 4);
				bar.setAttribute('d', `M${cx - arm} ${barY} L${cx + arm} ${barY}`);

				pathLen = path.getTotalLength();
				barLen = bar.getTotalLength();

				// Sample the path so scroll position can be converted to draw length.
				samples = [];
				const steps = 240;
				for (let i = 0; i <= steps; i++) {
					const len = (pathLen * i) / steps;
					samples.push({ len, y: path.getPointAtLength(len).y });
				}
				lenAtBar = lengthAtY(barY);

				path.style.strokeDasharray = `${pathLen}`;
				bar.style.strokeDasharray = `${barLen}`;
				if (reduced) {
					path.style.strokeDashoffset = '0';
					bar.style.strokeDashoffset = '0';
					barDrawn = true;
				} else if (!introPlayed) {
					// The line enters with the page rather than snapping into place.
					introPlayed = true;
					intro = true;
					const target = pathLen - Math.min(pathLen, lengthAtY(window.scrollY + window.innerHeight * HEAD));
					bar.style.strokeDashoffset = `${barLen}`;
					gsap.fromTo(path,
						{ strokeDashoffset: pathLen },
						{
							strokeDashoffset: target, duration: 1.5, ease: 'power2.out', delay: 0.15,
							onComplete: () => { intro = false; drawToScroll(); },
						},
					);
				} else {
					if (!barDrawn) bar.style.strokeDashoffset = `${barLen}`;
					drawToScroll();
				}
			}

			/** Distance along the path at which it first reaches a given y. */
			function lengthAtY(y: number) {
				for (let i = 1; i < samples.length; i++) {
					if (samples[i].y >= y) {
						const a = samples[i - 1];
						const b = samples[i];
						const t = b.y === a.y ? 0 : (y - a.y) / (b.y - a.y);
						return a.len + (b.len - a.len) * t;
					}
				}
				return pathLen;
			}

			/**
			 * The head of the line sits a little below where you have read to, so the
			 * line is always being drawn just ahead of you rather than trailing.
			 */
			function drawToScroll() {
				if (!path || intro) return;
				// The lead shrinks to nothing as you reach the end of the document, so
				// the line finishes exactly at the foot of the page instead of
				// stopping a little short of it.
				const vh = window.innerHeight;
				const maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
				const t = Math.min(1, window.scrollY / maxScroll);
				const head = window.scrollY + vh * (HEAD + (1 - HEAD) * t);
				const drawn = Math.min(pathLen, lengthAtY(head));
				path.style.strokeDashoffset = `${pathLen - drawn}`;

				// The cross forms on two conditions, not one: the scripture has to be
				// on screen to read, and the line has to have already run past the
				// crossbar. Firing on the line alone puts the moment a screen early;
				// firing on the scripture alone can grow an arm off nothing.
				if (!barDrawn && barArmed && drawn >= lenAtBar && bar) {
					barDrawn = true;
					gsap.to(bar, { strokeDashoffset: 0, duration: 0.75, ease: 'power3.inOut' });
				}
			}

			if (reduced) {
				build();
			} else {
				const lenis = new Lenis({ duration: 1.05 });
				lenis.on('scroll', ScrollTrigger.update);
				gsap.ticker.add((t) => lenis.raf(t * 1000));
				gsap.ticker.lagSmoothing(0);

				build();
				ScrollTrigger.create({
					trigger: document.body,
					start: 'top top',
					end: 'bottom bottom',
					onUpdate: drawToScroll,
					onRefresh: build,
				});

				ScrollTrigger.create({
					trigger: '.verse',
					start: 'top 60%',
					once: true,
					onEnter: () => { barArmed = true; drawToScroll(); },
				});

				const heading = document.querySelector<HTMLElement>('[data-split]');
				if (heading) {
					const split = new SplitText(heading, { type: 'lines', linesClass: 'line', mask: 'lines' });
					gsap.from(split.lines, {
						yPercent: 130, duration: 1.1, ease: 'power4.out', stagger: 0.09, delay: 0.1,
					});
				}

				gsap.from('.hero .eyebrow, .hero__foot, .actions', {
					opacity: 0, y: 16, duration: 0.75, ease: 'power2.out', stagger: 0.1, delay: 0.4,
				});

				// Reveals start high in the viewport so anything below the fold is
				// already on screen by the time it plays — nothing sits at zero
				// opacity waiting for a trigger that might never fire.
				gsap.utils.toArray<HTMLElement>('.latest__lead, .prior, .verse blockquote, .grid > article, .foot > *').forEach((el) => {
					gsap.from(el, {
						opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
						scrollTrigger: { trigger: el, start: 'top 92%', once: true },
					});
				});

				let resizeTimer: number;
				window.addEventListener('resize', () => {
					window.clearTimeout(resizeTimer);
					resizeTimer = window.setTimeout(() => {
						build();
						ScrollTrigger.refresh();
					}, 160);
				});
				document.fonts?.ready.then(() => { build(); ScrollTrigger.refresh(); });
			}
		</script>
	</body>
</html>
