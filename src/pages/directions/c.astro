---
/**
 * DIRECTION C — "The Word"
 *
 * Thesis: the church's tagline is a verse, so set the verse itself at a scale
 * you cannot ignore and let it be the surface of the page. Three layers of
 * 1 Corinthians 2:2 move at different speeds behind the content. Exactly one
 * word on the page is coral, and it is the word the church is named for.
 *
 * Condensed American gothic rather than a serif — Brookside is a coal town,
 * and the letterforms should have that weight rather than a literary one.
 */
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/inter-tight';
import '@fontsource/jetbrains-mono/400.css';
import BrooksideMark from '../../components/BrooksideMark.astro';
import data from '../../data/sermons.json';

const latest = data.recent[0];
const next = data.recent.slice(1, 5);
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const short = (iso: string) => {
	const [, m, d] = iso.split('-');
	return `${months[Number(m) - 1]} ${Number(d)}`;
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Direction C · The Word</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<header class="chrome">
			<a class="chrome__brand" href="/directions/">
				<BrooksideMark class="chrome__mark" letter="#D9D9D9" cross="#FF5757" />
				<span class="chrome__word">Brookside</span>
			</a>
			<nav class="chrome__nav">
				<a href="#">Visit</a>
				<a href="#">Watch</a>
				<a href="#">About</a>
				<a href="#" class="chrome__give">Give</a>
			</nav>
		</header>

		<main>
			<section class="stage">
				<!-- The verse, as the surface. Three layers, three speeds. -->
				<div class="layers" aria-hidden="true">
					<div class="layer layer--back" data-speed="0.12">
						<span>FOR I DETERMINED</span><span>NOT TO KNOW</span>
					</div>
					<div class="layer layer--mid" data-speed="0.3">
						<span>ANY THING AMONG YOU</span><span>SAVE JESUS CHRIST</span>
					</div>
					<div class="layer layer--front" data-speed="0.55">
						<span>AND HIM <em>CRUCIFIED</em></span>
					</div>
				</div>

				<p class="verse-ref" aria-hidden="true">1 Corinthians 2:2</p>

				<div class="stage__panel">
					<h1 class="sr-only">Brookside Church of God</h1>
					<p class="panel__where">200 Cardiff Street · Brookside, Alabama</p>
					<dl class="panel__times">
						<div><dt>Sunday School</dt><dd>9:45 AM</dd></div>
						<div><dt>Worship</dt><dd>10:45 AM</dd></div>
						<div><dt>Wednesday</dt><dd>6:30 PM</dd></div>
					</dl>
					<div class="panel__actions">
						<a class="btn btn--solid" href="#">Plan your visit</a>
						<a class="btn btn--ghost" href="#">Listen to a sermon</a>
					</div>
				</div>

				<p class="scroll-cue" aria-hidden="true">Scroll</p>
			</section>

			<section class="latest">
				<p class="eyebrow">Preached this week</p>
				<h2 class="latest__title">{latest.title}</h2>
				<p class="latest__by">Brad Lindsey · {short(latest.date)}</p>
				<a class="btn btn--solid" href="#">Listen now</a>

				<ul class="latest__more">
					{next.map((s) => (
						<li>
							<span class="latest__date">{short(s.date)}</span>
							<span class="latest__name">{s.title}</span>
						</li>
					))}
				</ul>
				<a class="link" href="#">All {data.total} sermons &rarr;</a>
			</section>
		</main>

		<style is:global>
			:root {
				--ink: #000000;
				--iron: #2f2f2f;
				--ash: #d9d9d9;
				--coral: #ff5757;
				--bone: #f2f0ed;
				--display: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
				--body: 'Inter Tight Variable', system-ui, sans-serif;
				--mono: 'JetBrains Mono', ui-monospace, monospace;
			}
			* { box-sizing: border-box; }
			body {
				margin: 0; background: var(--ink); color: var(--ash);
				font-family: var(--body); -webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}
			a { color: inherit; text-decoration: none; }
			:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
			.sr-only {
				position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
				overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
			}

			/* ---------- chrome ---------- */
			.chrome {
				position: fixed; top: 0; left: 0; right: 0; z-index: 30;
				display: flex; align-items: center; justify-content: space-between;
				padding: 1.1rem clamp(1rem, 4vw, 3rem);
				mix-blend-mode: difference;
			}
			.chrome__brand { display: flex; align-items: center; gap: 0.55rem; }
			.chrome__mark { width: 24px; height: 24px; display: block; }
			.chrome__word {
				font-family: var(--body); font-weight: 700; font-size: 1.02rem;
				letter-spacing: -0.02em; color: var(--bone);
			}
			.chrome__nav { display: flex; align-items: center; gap: clamp(0.85rem, 2vw, 1.9rem); }
			.chrome__nav a { font-size: 0.86rem; color: var(--ash); }
			.chrome__give { color: var(--coral) !important; font-weight: 600; }

			/* ---------- the stage ---------- */
			.stage {
				position: relative; min-height: 100svh; overflow: hidden;
				display: flex; align-items: flex-end;
				padding: 6rem clamp(1rem, 4vw, 3rem) clamp(2rem, 5vw, 3.5rem);
			}
			.layers {
				position: absolute; inset: 0; z-index: 0;
				display: flex; flex-direction: column; justify-content: center;
				/* Hold the verse clear of the details panel that sits at the foot. */
				padding-bottom: clamp(9rem, 22vh, 15rem);
				pointer-events: none; user-select: none;
			}
			.layer {
				display: flex; flex-direction: column;
				font-family: var(--display);
				line-height: 0.82; letter-spacing: -0.01em; white-space: nowrap;
			}
			.layer span { display: block; }
			.layer--back {
				font-size: clamp(3.4rem, 11vw, 11rem); font-variation-settings: 'wght' 500;
				color: #101010; margin-left: 1vw;
			}
			.layer--mid {
				font-size: clamp(3rem, 9.5vw, 9.5rem); font-variation-settings: 'wght' 600;
				color: #1c1c1c; margin-left: 5vw; margin-top: -1.5vw;
			}
			.layer--front {
				font-size: clamp(3.4rem, 11.5vw, 11.5rem); font-variation-settings: 'wght' 800;
				color: var(--bone); margin-left: 2vw; margin-top: -1vw;
			}
			.layer--front em { font-style: normal; color: var(--coral); }

			.verse-ref {
				position: absolute; top: 50%; right: clamp(1rem, 4vw, 3rem);
				transform: translateY(-50%) rotate(90deg); transform-origin: right center;
				margin: 0; font-family: var(--mono); font-size: 0.68rem;
				letter-spacing: 0.24em; text-transform: uppercase; color: #5c5c5c; z-index: 2;
			}

			.stage__panel {
				position: relative; z-index: 3;
				background: color-mix(in srgb, var(--ink) 72%, transparent);
				backdrop-filter: blur(6px);
				border-top: 2px solid var(--coral);
				padding: 1.6rem clamp(1.1rem, 2.5vw, 2rem);
				max-width: 660px;
			}
			.panel__where {
				margin: 0 0 1.1rem; font-family: var(--mono); font-size: 0.68rem;
				letter-spacing: 0.16em; text-transform: uppercase; color: #8f8f8f;
			}
			.panel__times {
				display: flex; flex-wrap: wrap; gap: 1.75rem; margin: 0 0 1.4rem;
			}
			.panel__times dt {
				font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase;
				color: #8f8f8f;
			}
			.panel__times dd {
				margin: 0.2rem 0 0; font-family: var(--display);
				font-size: 1.9rem; font-variation-settings: 'wght' 700;
				color: var(--bone); line-height: 1;
			}
			.panel__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
			.btn {
				display: inline-flex; align-items: center; padding: 0.78rem 1.5rem;
				font-size: 0.88rem; font-weight: 600; letter-spacing: 0.01em;
				transition: background 0.2s, color 0.2s, border-color 0.2s;
			}
			.btn--solid { background: var(--coral); color: #170606; }
			.btn--solid:hover { background: var(--bone); }
			.btn--ghost { border: 1px solid #3d3d3d; color: var(--ash); }
			.btn--ghost:hover { border-color: var(--ash); color: var(--bone); }

			.scroll-cue {
				position: absolute; bottom: 1.4rem; right: clamp(1rem, 4vw, 3rem);
				margin: 0; font-family: var(--mono); font-size: 0.64rem;
				letter-spacing: 0.24em; text-transform: uppercase; color: #5c5c5c; z-index: 3;
			}

			/* ---------- latest ---------- */
			.latest {
				padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 4vw, 3rem);
				max-width: 1180px; margin: 0 auto;
			}
			.eyebrow {
				margin: 0 0 1rem; font-family: var(--mono); font-size: 0.68rem;
				letter-spacing: 0.18em; text-transform: uppercase; color: var(--coral);
			}
			.latest__title {
				margin: 0; font-family: var(--display);
				font-size: clamp(3rem, 10vw, 8rem); font-variation-settings: 'wght' 800;
				line-height: 0.88; letter-spacing: -0.02em; color: var(--bone);
				text-transform: uppercase;
			}
			.latest__by { margin: 1rem 0 1.75rem; color: #8f8f8f; font-size: 0.98rem; }
			.latest__more {
				list-style: none; margin: 3.5rem 0 1.75rem; padding: 0;
				border-top: 1px solid #1c1c1c;
			}
			.latest__more li {
				display: flex; gap: 1.5rem; align-items: baseline;
				padding: 0.95rem 0; border-bottom: 1px solid #1c1c1c;
			}
			.latest__date {
				font-family: var(--mono); font-size: 0.7rem; color: #6f6f6f;
				min-width: 4.5rem; letter-spacing: 0.06em;
			}
			.latest__name {
				font-family: var(--display); font-size: clamp(1.3rem, 2.6vw, 1.9rem);
				font-variation-settings: 'wght' 600; text-transform: uppercase;
				letter-spacing: -0.01em; color: var(--ash);
			}
			.latest__more li:hover .latest__name { color: var(--coral); }
			.link {
				font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.16em;
				text-transform: uppercase; color: var(--coral);
				border-bottom: 1px solid currentColor; padding-bottom: 0.25rem;
			}

			@media (max-width: 700px) {
				.verse-ref { display: none; }
				.panel__times { gap: 1.1rem; }
			}
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 0.001ms !important;
					transition-duration: 0.001ms !important;
				}
			}
		</style>

		<script>
			import gsap from 'gsap';
			import ScrollTrigger from 'gsap/ScrollTrigger';
			import Lenis from 'lenis';

			gsap.registerPlugin(ScrollTrigger);
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reduced) {
				const lenis = new Lenis({ duration: 1.05 });
				lenis.on('scroll', ScrollTrigger.update);
				gsap.ticker.add((t) => lenis.raf(t * 1000));
				gsap.ticker.lagSmoothing(0);

				// Each layer of the verse drifts at its own rate, both on load and on scroll.
				gsap.utils.toArray<HTMLElement>('.layer').forEach((layer, i) => {
					const speed = Number(layer.dataset.speed ?? 0.2);
					gsap.from(layer, {
						xPercent: -8 * (i + 1), opacity: 0,
						duration: 1.5, ease: 'power3.out', delay: 0.1 * i,
					});
					gsap.to(layer, {
						xPercent: -14 * speed * 6, ease: 'none',
						scrollTrigger: { trigger: '.stage', start: 'top top', end: 'bottom top', scrub: 0.5 },
					});
				});

				gsap.from('.stage__panel', {
					y: 32, opacity: 0, duration: 1, ease: 'power3.out', delay: 0.55,
				});

				gsap.from('.latest__title', {
					opacity: 0, y: 40, duration: 0.9, ease: 'power3.out',
					scrollTrigger: { trigger: '.latest', start: 'top 78%', once: true },
				});
				gsap.from('.latest__more li', {
					opacity: 0, x: -24, duration: 0.6, ease: 'power2.out', stagger: 0.08,
					scrollTrigger: { trigger: '.latest__more', start: 'top 85%', once: true },
				});
			}
		</script>
	</body>
</html>
