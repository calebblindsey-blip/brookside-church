---
/**
 * Visit, in Codex's design (Round 3 of the port). Layout follows app/visit/page.tsx
 * in brookside-church-website. Folded in from the Astro site:
 *
 *   - The contact path stays ABOVE THE FOLD. The old Squarespace /contact-us took
 *     607 sessions and had nothing to contact through; this page must never
 *     repeat that by leaving the phone number at the foot. Both hrefs come from
 *     church.ts, never inlined: the number was hardcoded in five files once,
 *     which is how the wrong one ended up on Facebook and Yelp.
 *   - The children's programme in the church's own confirmed wording (Caleb
 *     Lindsey, 2026-07-28; Compass church-facts.md). Do not add to it without
 *     the same kind of source. The section keeps id="kids" for inbound links.
 *   - The building photograph, shot from Cardiff Street so it matches what a
 *     visitor sees from the road, and the mailing address, because mail does not
 *     come to the building.
 *   - "Ask anything first", the closing invitation to call or email before Sunday.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import Times from '../components/Times.astro';
import { CHURCH } from '../data/church';

const appleMaps = `https://maps.apple.com/?q=${encodeURIComponent(CHURCH.addressLine)}`;
const mailing = 'P.O. Box 24, Brookside, AL 35036';
---

<SiteLayout
	title="Visit"
	description={`Plan a visit to Brookside Church of God. Sunday School 9:45 AM, Morning Worship 10:45 AM, Wednesday Classes 6:30 PM, at ${CHURCH.addressLine}.`}
>
	<InteriorHero eyebrow="Plan a visit · Brookside, Alabama">
		<Fragment slot="title">A church you<br />can <em>walk into.</em></Fragment>
		<Fragment slot="intro">
			<p>Everyone is welcome. There is nothing to sign up for, and nobody needs to know you are coming. Morning Worship starts at 10:45 and we are usually done around 12:15.</p>
			<div class="inline-links">
				<a href={CHURCH.phoneHref}>{CHURCH.phone}</a>
				<a href={CHURCH.emailHref}>Email us</a>
			</div>
		</Fragment>
		<Fragment slot="aside"><p class="eyebrow">When we meet</p><Times /></Fragment>
	</InteriorHero>

	<section class="inner-section inner-blue" id="kids" aria-labelledby="kids-heading">
		<div>
			<p class="eyebrow">Bringing children</p>
			<h2 id="kids-heading">Yes, bring them.</h2>
			<p class="lead">Nobody has to sit through a service wondering whether their child is welcome. Here is exactly what happens on Sunday morning.</p>
		</div>
		<div class="detail-list">
			<article><span>01</span><h3>Nursery</h3><p>Every Sunday, and open through both Sunday School and Morning Worship. Bring your babies.</p></article>
			<article><span>02</span><h3>Kids Church</h3><p>Starts at 10:45. The children stay in the sanctuary with everyone else for worship, then are dismissed together once the singing is over.</p></article>
			<article><span>03</span><h3>Corporate Sunday</h3><p>Every fourth Sunday the children stay in for the whole service, and the whole church is in one room.</p></article>
			<article><span>04</span><h3>Sunday School</h3><p>9:45, with classes for every age: nursery, kids, youth and adults.</p></article>
		</div>
	</section>

	<section class="inner-section split-section" aria-labelledby="where-heading">
		<div>
			<p class="eyebrow">Where we are</p>
			<h2 id="where-heading">{CHURCH.street}.</h2>
			<p class="lead">Brookside sits just northwest of Birmingham, off I&#8209;22. Mail does not come to the building; anything posted to the church goes to the P.O. Box.</p>
		</div>
		<div>
			<figure class="where-shot">
				<img src="/building.webp" width="1600" height="900" alt="Brookside Church of God from Cardiff Street: red brick with a white gable, a bell tower, and two crosses." loading="lazy" decoding="async" />
				<figcaption>Look for the two crosses and the blue doors.</figcaption>
			</figure>
			<div class="address-card">
				<strong>{CHURCH.name}</strong>
				<p>{CHURCH.street}<br />{CHURCH.locality}, Alabama {CHURCH.postalCode}</p>
				<div class="card-actions">
					<a class="button button-light" href={CHURCH.mapsUrl}>Google Maps <span class="arrow" aria-hidden="true">↗</span></a>
					<a class="text-link" href={appleMaps}>Apple Maps <span class="arrow" aria-hidden="true">↗</span></a>
				</div>
				<small>Mail: {mailing}</small>
			</div>
		</div>
	</section>

	<section class="inner-section inner-copper split-section" aria-labelledby="ask-heading">
		<div><p class="eyebrow">Before Sunday</p><h2 id="ask-heading">Ask anything first, if that is easier.</h2></div>
		<div>
			<p class="lead">Some people would rather know a thing or two before walking in than find out on the doorstep. That is a completely reasonable way to come to church, and either of these reaches somebody. Or simply show up on Sunday.</p>
			<div class="card-actions">
				<a class="button button-light" href={CHURCH.phoneHref}>{CHURCH.phone} <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link" href={CHURCH.emailHref}>{CHURCH.email} <span class="arrow" aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>
</SiteLayout>
