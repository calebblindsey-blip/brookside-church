---
/**
 * Visit: the page for the one person on this site who has not decided yet.
 *
 * Every other page serves someone who already chose to be here. This one
 * serves somebody working out whether to walk into a small church where they
 * know nobody, so its only job is to remove reasons not to come.
 *
 * WHAT IS NOT HERE, AND WHY. The previous version of this page was written by
 * a design tool and almost none of it was reported. The church publishes ten
 * real pages (the other 292 URLs in its sitemap are podcast episodes) and
 * across all ten there is no visit page, no service-structure page, no kids
 * page and no "what to expect" page. So these claims, all on the old page,
 * had no source and are gone:
 *
 *   - that the service "lands around 12:15 or 12:30"
 *   - that Pastor Brad "preaches expositionally"
 *   - that music is contemporary, that a live band leads, that lyrics are on
 *     screen
 *   - that there are greeters at the door
 *   - that parking is on-site with "plenty of space" and no overflow
 *   - a paragraph on what people wear
 *   - the kids programme names "Children's Nursery" and "Kids Church"
 *   - the frequency of communion and whether the table is open
 *
 * Several of these are probably true, and anyone who attends could confirm
 * them in a sentence. That is the point: they need confirming, not composing.
 * This is the same failure that put an invented 1948 founding on the About
 * page. Add them back the moment somebody at the church says them, and not
 * one moment sooner.
 *
 * One correction rather than a cut: the old page called Wednesday "Bible
 * Study" and described "adult Bible study plus a parallel study for kids."
 * The church calls it "Wednesday Classes" and says nothing about a kids
 * track. The church's wording wins.
 *
 * The structural device is the time. Watch runs the year down a sticky rail
 * to count backwards through the archive; here the times run down the page to
 * count forward through one morning, which is the thing a nervous visitor is
 * actually trying to work out. Same instrument, opposite direction.
 *
 * The headline is the church's own invitation, from its home page, not a line
 * written for it. (Their original reads "come be apart of our family" — the
 * typo is theirs and is not reproduced.)
 *
 * No crossAt: the crossbar is Home's payoff and repeating it spends it.
 */
import SiteLayout from '../layouts/SiteLayout.astro';

/**
 * Verbatim from the church's own /contact-us, including its naming. Do not
 * retitle these: "Morning Worship" and "Wednesday Classes" are what the church
 * calls them, not "Sunday service" and "Bible study".
 *
 * Grouped by day rather than tagged per row. A day tag beside every slot reads
 * "Wednesday Classes WEDNESDAY", and the day is the thing two of the three
 * names already contain. As a group heading it says each day once and gives
 * the page the same shape as Watch, where the year heads its own stack.
 */
const days = [
	{
		day: 'Sunday',
		slots: [
			{ time: '9:45', meridiem: 'AM', name: 'Sunday School' },
			{ time: '10:45', meridiem: 'AM', name: 'Morning Worship' },
		],
	},
	{
		day: 'Wednesday',
		slots: [{ time: '6:30', meridiem: 'PM', name: 'Wednesday Classes' }],
	},
];

const ADDRESS = '200 Cardiff Street, Brookside, AL 35036';
const GOOGLE = `https://maps.google.com/?q=${encodeURIComponent(ADDRESS)}`;
const APPLE = `https://maps.apple.com/?q=${encodeURIComponent(ADDRESS)}`;
const PHONE = '(205) 675-0703';
const EMAIL = 'info@brooksidecog.com';
---

<SiteLayout
	title="Visit"
	description={`Plan a visit to Brookside Church of God. Sunday School 9:45 AM, Morning Worship 10:45 AM, Wednesday Classes 6:30 PM, at ${ADDRESS}.`}
>
	<section class="bay vtop">
		<p class="eyebrow">Plan a visit &middot; Brookside Church of God</p>
		<h1 class="display" data-split>
			Come and see<br />what all the<br /><em>fuss</em> is about
		</h1>
		<div class="vtop__foot">
			<p class="lede">
				Those are the church's own words. Everyone is welcome, there is
				nothing to sign up for, and nobody needs to know you are coming.
				Morning Worship starts at 10:45 and we are usually done by around
				12:15.
			</p>
		</div>
	</section>

	{/*
		The device. Times in display type running down the page, which is the
		one thing on here somebody genuinely needs before Sunday. Set as a
		description list because that is what it is: a term and its time.
	*/}
	<section class="bay rule when" aria-labelledby="when-heading">
		<p class="eyebrow" id="when-heading">When we meet</p>
		{days.map((g) => (
			<div class="stack" aria-labelledby={`d-${g.day}`}>
				<h2 class="stack__day" id={`d-${g.day}`}>{g.day}</h2>
				<dl class="stack__list">
					{g.slots.map((s) => (
						<div class="slot">
							<dt class="slot__mark">
								<span class="slot__time">{s.time}</span>
								<span class="slot__mer">{s.meridiem}</span>
							</dt>
							<dd class="slot__body">
								<span class="slot__name">{s.name}</span>
							</dd>
						</div>
					))}
				</dl>
			</div>
		))}
	</section>

	{/*
		Kids. This section is why the home page's "Kids and childcare" link
		existed with nowhere to go: the programme names were cut from this page
		for having no source, and the link was never repointed. Every claim here
		was confirmed by Caleb Lindsey (Worship Pastor) on 2026-07-28 and is
		recorded in Compass at projects/personal/brookside-church-website/
		church-facts.md. Do not add to it without the same kind of source.
	*/}
	<section class="bay rule kids" id="kids" aria-labelledby="kids-heading">
		<p class="eyebrow" id="kids-heading">Bringing children</p>
		<h2 class="headline kids__head">Yes, bring them.</h2>
		<p class="lede kids__lede">
			Nobody has to sit through a service worrying about whether their child is
			welcome, so here is exactly what happens to them on a Sunday morning.
		</p>
		<dl class="kids__list">
			<div>
				<dt>Nursery</dt>
				<dd>
					Every Sunday, and open through both Sunday School and Morning
					Worship. Bring your babies.
				</dd>
			</div>
			<div>
				<dt>Kids Church</dt>
				<dd>
					Starts at 10:45. The children stay in the sanctuary with everyone
					else for worship, then are dismissed together once the singing is
					over.
				</dd>
			</div>
			<div>
				<dt>Corporate Sunday</dt>
				<dd>
					Every fifth Sunday the children stay in for the whole service, and
					the whole church is in one room.
				</dd>
			</div>
			<div>
				<dt>Sunday School</dt>
				<dd>
					9:45, with classes for every age: nursery, kids, youth and adults.
				</dd>
			</div>
		</dl>
	</section>

	<section class="bay rule where" aria-labelledby="where-heading">
		<p class="eyebrow" id="where-heading">Where we are</p>
		<div class="where__grid">
			<div>
				<h2 class="headline">200 Cardiff Street.</h2>
				{/*
					Address links out rather than embedding a map. A map iframe is a
					third-party request and a tracking surface on a page whose whole
					job is to lower a stranger's guard, and it can render broken for
					reasons outside this site. Two links cannot.
				*/}
				<address class="where__addr">
					Brookside Church of God<br />
					200 Cardiff Street<br />
					Brookside, Alabama 35036
				</address>
				<div class="actions where__actions">
					<a class="btn btn--solid" href={GOOGLE} target="_blank" rel="noopener">Google Maps</a>
					<a class="btn btn--line" href={APPLE} target="_blank" rel="noopener">Apple Maps</a>
				</div>
			</div>
			<div class="where__note">
				{/*
					The one photograph on the site, and it earns its place here rather
					than on the home page: the job of this page is to remove reasons not
					to come, and "will I know the building when I get there" is one of
					them. Shot from Cardiff Street, so it matches what a visitor sees
					from the road.

					Source: the brand package's hero-1600 webp, adopted 2026-07-29.
					1600x900 at 210KB rather than the 1920x1080 JPEG at 415KB, because
					this slot is column-constrained and renders around 313px wide, so
					`max-height: 30rem` never engages. Half the bytes for an image
					nobody can tell apart at this size.

					Note for anyone comparing it to the original: the packaged photo is
					AI-reprocessed. Same building, same composition, but the stained
					glass is sharpened into swirls the real windows do not have and the
					siding is softened. Caleb chose it knowing that. The faithful
					original is in Compass at
					branding/brookside-church/photography/source/building-exterior-original.jpg
					at 2656x2742 if it is ever wanted back.
				*/}
				<figure class="where__shot">
					<img
						src="/building.webp"
						width="1600"
						height="900"
						alt="Brookside Church of God from Cardiff Street: red brick with a white gable, a bell tower, and two crosses."
						loading="lazy"
						decoding="async"
					/>
					<figcaption>Look for the two crosses and the blue doors.</figcaption>
				</figure>
				<p class="prose">
					Brookside sits just north west of Birmingham, off I&#8209;22.
				</p>
				<p class="prose">
					Mail does not come here. Anything posted to the church goes to
					P.O. Box 24, Brookside, AL 35036.
				</p>
			</div>
		</div>
	</section>

	<section class="bay rule ask" aria-labelledby="ask-heading">
		<p class="eyebrow" id="ask-heading">Before Sunday</p>
		<h2 class="headline ask__head">Ask anything first, if that is easier.</h2>
		<p class="lede ask__lede">
			Some people would rather know a thing or two before walking in than find
			out on the doorstep. That is a completely reasonable way to come to
			church, and either of these reaches somebody.
		</p>
		<dl class="reach">
			<div>
				<dt>Call</dt>
				<dd><a class="link" href="tel:+12056750703">{PHONE}</a></dd>
			</div>
			<div>
				<dt>Email</dt>
				<dd><a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
			</div>
			<div>
				<dt>Or simply</dt>
				<dd>Turn up on a Sunday.</dd>
			</div>
		</dl>
	</section>
</SiteLayout>

<style is:global>
	/* Page-level composition only. Anything reusable belongs in site.css. */

	.vtop { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4rem); }
	.vtop__foot { margin-top: clamp(2rem, 4vw, 3rem); }

	/* ---------- when ---------- */

	.when { padding-block: clamp(2.5rem, 6vw, 4rem); }

	/*
		Same two-column grid as Watch's archive, so the two pages' rails line up:
		a reader moving between them sees one system, not two. The day sits where
		Watch puts the year.
	*/
	.stack {
		display: grid; grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		padding-top: clamp(1.25rem, 3vw, 2rem);
	}
	.stack__day {
		margin: 0; align-self: start; padding-top: 0.75rem;
		font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em;
		text-transform: uppercase; color: var(--iron); font-weight: 400;
	}
	.stack__list { margin: 0; max-width: 44rem; }

	.slot {
		display: grid; grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
		gap: clamp(0.75rem, 2vw, 1.75rem);
		align-items: baseline;
		padding: clamp(0.85rem, 2vw, 1.3rem) 0;
		border-top: 1px solid var(--ash);
	}
	/* Bottom edge comes from the next section's rule. A border here as well puts
	   two hairlines a few pixels apart at the foot of the list. */

	.slot__mark { display: flex; align-items: baseline; gap: 0.5rem; }
	.slot__time {
		font-family: var(--display);
		font-size: clamp(2.1rem, 5vw, 3.4rem);
		font-variation-settings: 'wght' 800, 'opsz' 36;
		line-height: 0.9; letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
	}
	.slot__mer {
		font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em;
		text-transform: uppercase; color: var(--iron);
	}

	.slot__body { margin: 0; }
	.slot__name {
		font-family: var(--display); font-size: clamp(1.15rem, 2.4vw, 1.5rem);
		font-variation-settings: 'wght' 600, 'opsz' 24; letter-spacing: -0.025em;
	}

	/* ---------- where ---------- */

	.where { padding-block: clamp(2.5rem, 6vw, 4rem); }
	.where__grid {
		display: grid; gap: clamp(1.75rem, 4vw, 3.5rem);
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		align-items: start;
	}
	.where__addr {
		margin: 1.25rem 0 0; font-style: normal;
		font-size: 1.02rem; line-height: 1.7; color: var(--iron);
	}
	.where__actions { margin-top: 1.75rem; }
	.where__note { max-width: 32ch; padding-top: 0.4rem; }

	/* ---------- ask ---------- */

	/* Square-ish crop, not the full 2:3, so the photo sits beside the address
	   rather than towering over it. No radius and no shadow: the system has
	   neither anywhere else. */
	.where__shot { margin: 0 0 1.5rem; }
	/*
		object-position was 50% 32% when this slot held a 1200x1800 portrait and
		had to bias upward to keep the gable in a landscape crop. The brand
		package photo is 1920x1080 and already composed on the building, so it
		centres. Revisit only if the source aspect changes again.
	*/
	.where__shot img {
		display: block; width: 100%; height: auto;
		max-height: 30rem; object-fit: cover; object-position: 50% 50%;
		background: color-mix(in srgb, var(--ash) 26%, var(--paper));
	}
	.where__shot figcaption {
		margin-top: 0.6rem; font-family: var(--mono); font-size: 0.68rem;
		letter-spacing: 0.14em; text-transform: uppercase; color: var(--iron);
	}

	.kids { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
	.kids__head { max-width: 14ch; }
	.kids__lede { margin-top: 1.1rem; }
	/* Fixed two columns, not auto-fit. These are paragraphs rather than labels,
	   so the auto-fit row the .reach list uses crushes them to a three-word
	   measure, and with four items it lands 3 + 1 and orphans the last one. */
	.kids__list {
		margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
		display: grid; gap: clamp(1.25rem, 2.5vw, 2rem) clamp(1.5rem, 3.5vw, 3.5rem);
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 2px solid var(--ink); padding-top: 1.25rem;
	}
	@media (max-width: 720px) { .kids__list { grid-template-columns: 1fr; } }
	.kids__list dt {
		font-family: var(--display); font-variation-settings: 'wght' 700;
		font-size: 1.12rem; letter-spacing: -0.02em; margin-bottom: 0.3rem;
	}
	.kids__list dd { margin: 0; color: var(--iron); font-size: 0.96rem; line-height: 1.6; }

	.ask { padding-block: clamp(2.5rem, 5vw, 3.5rem) clamp(3rem, 6vw, 4.5rem); }
	.ask__head { max-width: 18ch; }
	.ask__lede { margin-top: 1.1rem; }

	.reach {
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		display: grid; gap: 0.5rem clamp(1.5rem, 3.5vw, 3rem);
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
		border-top: 2px solid var(--ink); padding-top: 1.25rem;
	}
	.reach dt {
		font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em;
		text-transform: uppercase; color: var(--iron); margin-bottom: 0.4rem;
	}
	.reach dd {
		margin: 0 0 1rem; font-family: var(--display);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		font-variation-settings: 'wght' 600, 'opsz' 24; letter-spacing: -0.02em;
	}

	/* ---------- responsive ---------- */

	@media (max-width: 860px) {
		.where__grid { grid-template-columns: 1fr; }
		.where__note { max-width: none; }
	}

	@media (max-width: 720px) {
		/* The day becomes a label above its times rather than a column, matching
		   how Watch's year bar behaves at this width. */
		.stack { grid-template-columns: 1fr; gap: 0.5rem; }
		.stack__day { padding-top: 0; }
		/* The time keeps its own line rather than shrinking to fit beside the
		   name: at this width a 3.4rem numeral and a 1.5rem name on one row
		   force the name to wrap mid-phrase. */
		.slot { grid-template-columns: 1fr; gap: 0.35rem; }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import SplitText from 'gsap/SplitText';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const lenis = new Lenis({ duration: 1.05 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((t) => lenis.raf(t * 1000));
		gsap.ticker.lagSmoothing(0);

		const heading = document.querySelector<HTMLElement>('[data-split]');
		if (heading) {
			const split = new SplitText(heading, { type: 'lines', linesClass: 'line', mask: 'lines' });
			gsap.from(split.lines, {
				yPercent: 130, duration: 1.1, ease: 'power4.out', stagger: 0.09, delay: 0.1,
			});
		}

		gsap.from('.vtop .eyebrow, .vtop__foot', {
			opacity: 0, y: 16, duration: 0.75, ease: 'power2.out', stagger: 0.1, delay: 0.4,
		});

		// Reveals start high in the viewport so anything below the fold is already
		// on screen by the time it plays, rather than sitting at zero opacity
		// waiting for a trigger that may never fire.
		gsap.utils.toArray<HTMLElement>(
			'.when .eyebrow, .slot, .kids > *, .where > *, .ask > *, .foot > *',
		).forEach((el) => {
			gsap.from(el, {
				opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
				scrollTrigger: { trigger: el, start: 'top 92%', once: true },
			});
		});
	}
</script>
