---
/**
 * Knowing Christ, in Codex's design (Round 4 of the port). Layout follows
 * app/knowing-christ/page.tsx: four movements each with a heading, a body and a
 * verse, then four steps, then what happens next. The bodies and steps are the
 * Astro page's fuller wording, which Codex had trimmed; the scripture is the same
 * translation on both and is carried in full.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import { CHURCH } from '../data/church';

const movements = [
	{ term: 'God’s plan is peace and life', body: 'God is not distant and He is not indifferent. He made you, He loves you, and what He wants for you is life rather than the wearing-down most people settle for.', verse: 'For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life.', ref: 'John 3:16' },
	{ term: 'Our problem is separation', body: 'People choose their own way instead of God’s, and that choice puts distance between us and Him. It is not a matter of being worse than the person next to you. It is true of every one of us, and no amount of effort closes the gap from our side.', verse: 'For all have sinned and fall short of the glory of God.', ref: 'Romans 3:23' },
	{ term: 'God’s remedy is the cross', body: 'God closed the gap Himself. Jesus paid the penalty for our sin by dying in our place, and then walked out of the grave. This is what this church means when it says it preaches Christ crucified.', verse: 'But God demonstrates his own love for us in this: While we were still sinners, Christ died for us.', ref: 'Romans 5:8' },
	{ term: 'The response is to receive Him', body: 'Knowing all of this is not the same as receiving it. What God offers has to be taken, and it is taken by trusting Christ and asking Him to be Lord of your life.', verse: 'Yet to all who received him, to those who believed in his name, he gave the right to become children of God.', ref: 'John 1:12' },
];
const steps = [
	'Admit your need. You are a sinner, the same as everyone who has ever walked into this building.',
	'Be willing to turn from your sin. That is what repentance means, and it is a change of direction rather than a change of mood.',
	'Believe that Jesus Christ died for you on the cross and rose from the grave, and say so out loud.',
	'In prayer, ask Jesus Christ to come into your life and to lead it, as Lord and Savior.',
];
---

<SiteLayout
	title="Knowing Christ"
	description="How a person comes to Christ: God’s plan, our problem, the cross, and how to receive Him. Written plainly by Brookside Church of God."
>
	<InteriorHero eyebrow="Knowing Christ">
		<Fragment slot="title">How a person<br />comes to <em>Christ.</em></Fragment>
		<p slot="intro">This church exists to preach one message, and this page is that message written down rather than preached. It takes about three minutes to read. Nothing on it is complicated, and none of it depends on you cleaning yourself up first.</p>
	</InteriorHero>

	<section class="inner-section gospel-section" aria-labelledby="move-heading">
		<div><p class="eyebrow">The message</p><h2 id="move-heading">Four things the Bible says, in order.</h2></div>
		<div class="gospel-grid">
			{movements.map((m, i) => (
				<article>
					<span>{String(i + 1).padStart(2, '0')}</span>
					<h3>{m.term}</h3>
					<p>{m.body}</p>
					<blockquote>{m.verse}<cite>{m.ref}</cite></blockquote>
				</article>
			))}
		</div>
	</section>

	<section class="inner-section inner-copper" aria-labelledby="steps-heading">
		<div><p class="eyebrow">How to receive Christ</p><h2 id="steps-heading">There are four steps, and they are all honest ones.</h2></div>
		<div>
			<ol class="step-list">
				{steps.map((s, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
			</ol>
			<p class="lead">There are no particular words that have to be used. God is not listening for a formula, He is listening for somebody who means it.</p>
		</div>
	</section>

	<section class="inner-section split-section" aria-labelledby="next-heading">
		<div><p class="eyebrow">What happens next</p><h2 id="next-heading">Tell somebody, and do not do this alone.</h2></div>
		<div>
			<p class="lead">If you prayed that, this church would count it a privilege to hear about it and to help you take the next step. Come on a Sunday and say so, or email ahead if walking in cold is easier. Either reaches a real person, and nobody will make a spectacle of you.</p>
			<div class="card-actions">
				<a class="button button-light" href="/visit/">Plan a visit <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link" href={CHURCH.emailHref}>Email the church <span class="arrow" aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>
</SiteLayout>
