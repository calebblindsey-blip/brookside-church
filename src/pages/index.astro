---
/**
 * Home, in Codex's design (Round 2 of the port). Markup follows app/page.tsx in
 * brookside-church-website section for section: hero with the ribbon field and
 * gather card, the scripture, vision and mission as layered cards, the visit
 * band, the watch band, the mission grid, and the page current that Motion.astro
 * lays out from the hero's creek to the cross of the footer lockup.
 *
 * One thing folded in from the Astro site that Codex's build had dropped: the
 * watch band names THIS WEEK'S SERMON from the feed rather than a static line.
 * The speaker comes from the feed too, never hardcoded: about one Sunday in five
 * is a guest, and a fixed name here credits the senior pastor for other people's
 * preaching on the page most visitors land on first. When the feed names nobody,
 * the date stands alone.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import { CHURCH } from '../data/church';
import data from '../data/sermons.json';

const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const longDate = (iso: string) => {
	const [y, m, d] = iso.split('-');
	return `${months[Number(m) - 1]} ${Number(d)}, ${y}`;
};
const latest = data.recent[0];
const youtubeLive = `${CHURCH.profiles[2]}/live`;

/* A placeholder shape; Motion.astro rewrites `d` from the real section
   positions before the current is shown (.page-current starts at opacity 0). */
const currentPath = 'M1050 750 C1050 1100 100 1200 100 1800 S1080 2300 1080 3000 S100 3600 100 4200 S1060 5000 1060 6000';
const ribbon = (line: number) =>
	`M${350 + line * 15} -100 C${-80 + line * 15} 180 ${890 + line * 15} 230 ${410 + line * 15} 500 S${190 + line * 15} 820 ${770 + line * 15} 1000`;
---

<SiteLayout class="home">
	<Fragment slot="decoration">
		<div class="page-current" aria-hidden="true">
			<svg viewBox="0 0 1200 6000" preserveAspectRatio="none">
				<defs>
					<linearGradient id="current-to-cross" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color="#176bb3" />
						<stop offset=".84" stop-color="#176bb3" />
						<stop offset=".94" stop-color="#667d8f" />
						<stop offset="1" stop-color="#ac432b" />
					</linearGradient>
				</defs>
				<path class="current-shallows" d="M0 0" />
				<path class="current-bank" pathLength="1" d={currentPath} />
				<path class="current-track" pathLength="1" d={currentPath} />
				<path class="current-progress" pathLength="1" d={currentPath} />
			</svg>
		</div>
	</Fragment>

	<section id="top" class="hero">
		<div class="hero-flow" aria-hidden="true">
			<svg viewBox="0 0 1000 900" preserveAspectRatio="xMidYMid slice">
				<g class="flow-lines">
					{Array.from({ length: 22 }, (_, line) => <path data-ribbon={line} d={ribbon(line)} />)}
				</g>
			</svg>
		</div>
		<div class="hero-content">
			<p class="eyebrow light">{CHURCH.street} · {CHURCH.locality}, Alabama</p>
			<h1><span class="hero-line"><span>Preaching</span></span><span class="hero-line hero-christ"><span>Christ</span></span><em class="hero-line"><span>Crucified</span></em></h1>
			<p class="hero-intro">A Christ-centered church family in the heart of Brookside. Come as you are. Sit wherever you like.</p>
			<div class="hero-actions">
				<a class="button button-light" href="#visit">Plan your visit <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link light" href="#watch">Watch online <span class="arrow" aria-hidden="true">↗</span></a>
			</div>
		</div>
		<aside class="gather-card" aria-label="Weekly gathering times">
			<p class="eyebrow">We gather</p>
			<dl>
				{CHURCH.gatherings.map((g) => <div><dt>{g.name}</dt><dd>{g.time}</dd></div>)}
			</dl>
		</aside>
		<a class="scroll-note" href="#about"><span>Follow the current</span><i aria-hidden="true"></i></a>
	</section>

	<section id="about" class="scripture-section section-pad">
		<p class="eyebrow">Christ · Our center</p>
		<blockquote>
			“For I determined not to know any thing among you, save Jesus Christ, and him <em>crucified.</em>”
			<cite>1 Corinthians 2:2</cite>
		</blockquote>
		<div class="scripture-note">
			<p>Everything we do returns to one message: Jesus Christ died and rose again so people could come home to God.</p>
			<a class="text-link" href="/knowing-christ/">Read the Gospel plainly <span class="arrow" aria-hidden="true">↗</span></a>
		</div>
	</section>

	<section class="family-section section-pad">
		<div class="family-heading">
			<p class="eyebrow">Family · Our life together</p>
			<h2>Rooted in Christ.<br /><em>Alive in the Spirit.</em></h2>
		</div>
		<div class="belief-stack">
			<div class="vision-card layered-card">
				<span>Vision</span>
				<p>To see a family of believers rooted in Christ, alive in the Spirit, and carrying the hope of the Gospel from Brookside to the world.</p>
			</div>
			<div class="mission-card layered-card">
				<span>Mission</span>
				<p>We gather to worship, seek God through prayer, grow in Scripture, live in authentic community, and equip every believer to serve wherever Christ calls them.</p>
			</div>
		</div>
		<ul class="family-practices" aria-label="Our shared practices">
			<li>Worship</li><li>Prayer</li><li>Scripture</li><li>Community</li><li>Calling</li>
		</ul>
	</section>

	<section id="visit" class="visit-section section-pad">
		<div class="visit-rings" aria-hidden="true"><i></i><i></i><i></i></div>
		<div class="visit-copy">
			<p class="eyebrow light">Your first Sunday</p>
			<h2>A church you can<br /><em>walk into.</em></h2>
			<p>Everyone is welcome. There is nothing to sign up for, and nobody needs to know you are coming. Morning Worship starts at 10:45 and we are usually done around 12:15.</p>
			<a class="button button-copper" href={CHURCH.mapsUrl}>Get directions <span class="arrow" aria-hidden="true">↗</span></a>
		</div>
		<div class="visit-details">
			<article>
				<span>01</span><h3>Come as you are</h3>
				<p>You do not need to know anybody here or have anything figured out first. Walk in whenever you are ready, and we will be glad you did.</p>
			</article>
			<article>
				<span>02</span><h3>Bring the kids</h3>
				<p>Nursery is open through Sunday School and worship. Kids Church begins at 10:45 after children worship with everyone.</p>
			</article>
			<article>
				<span>03</span><h3>Look for the crosses</h3>
				<p>Find us at {CHURCH.street}. Look for the two crosses and the blue doors.</p>
			</article>
		</div>
	</section>

	<section id="watch" class="watch-section section-pad">
		<div class="watch-top">
			<div>
				<p class="eyebrow light">Church, wherever you are</p>
				<h2>Hear the<br /><em>message.</em></h2>
			</div>
			<div class="live-orbit" aria-hidden="true"><span>Sunday<br />10:45</span></div>
		</div>
		<div class="watch-feature">
			<div class="play-mark" aria-hidden="true"><span>▶</span></div>
			<div>
				{/*
					Date and speaker on their own line under the title rather than in
					the eyebrow: with the full date the eyebrow wrapped to two lines of
					tracked capitals on a phone. Same meta pattern as /watch. The blurb
					is desktop-only; the orbit above and the YouTube link below already
					say when the service streams, so on a phone it was the third copy.
				*/}
				<p class="eyebrow light">This week’s sermon</p>
				<h3>{latest.title}</h3>
				<p class="watch-meta">{latest.speaker && (<><span>{latest.speaker}</span><span aria-hidden="true">·</span></>)}<span>Posted {longDate(latest.date)}</span></p>
				<p class="watch-blurb">Every sermon since {new Date(data.oldest).getUTCFullYear()} plays right here, and Sunday worship streams live at 10:45 AM.</p>
			</div>
			<a class="button button-light" href="/watch/">Listen to this sermon <span class="arrow" aria-hidden="true">↗</span></a>
		</div>
		<div class="platform-links">
			<a href={CHURCH.applePodcastsUrl}><span>Listen on</span>Apple Podcasts <span class="arrow" aria-hidden="true">↗</span></a>
			<a href={CHURCH.spotifyUrl}><span>Listen on</span>Spotify <span class="arrow" aria-hidden="true">↗</span></a>
			<a href={youtubeLive}><span>Sunday 10:45 AM</span>Watch live on YouTube <span class="arrow" aria-hidden="true">↗</span></a>
		</div>
	</section>

	<section class="mission-section section-pad">
		<p class="eyebrow">Mission · Our direction</p>
		<h2>From Brookside<br />to the <em>world.</em></h2>
		<div class="mission-grid">
			<p>Our mission is to preach and support the Gospel of Jesus Christ both locally and abroad, opening the door for lives to be transformed through His power.</p>
			<ul class="places" aria-label="Places where Brookside supports ministry">
				<li>Brookside</li><li>Romania</li><li>Moldova</li><li>Honduras</li><li>Guatemala</li><li>Israel</li>
			</ul>
		</div>
		<div class="water-words" aria-hidden="true">go · tell · serve · love · go · tell · serve · love</div>
	</section>
</SiteLayout>
