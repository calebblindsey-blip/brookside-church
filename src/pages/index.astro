---
import SiteLayout from '../layouts/SiteLayout.astro';
import data from '../data/sermons.json';

const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const longDate = (iso: string) => {
	const [y, m, d] = iso.split('-');
	return `${months[Number(m) - 1]} ${Number(d)}, ${y}`;
};
const shortDate = (iso: string) => {
	const [, m, d] = iso.split('-');
	return `${months[Number(m) - 1].slice(0, 3)} ${Number(d)}`;
};

const latest = data.recent[0];
const previous = data.recent.slice(1, 5);
const years = new Date(data.newest).getFullYear() - new Date(data.oldest).getFullYear();
---

<SiteLayout crossAt=".verse">
	<section class="bay hero">
		<p class="eyebrow">200 Cardiff Street · Brookside, Alabama</p>
		<h1 class="display" data-split>
			Preaching<br />Christ<br /><em>crucified</em>
		</h1>
		<div class="hero__foot">
			<p class="lede">
				Everyone is welcome here, and we would love you to be part of our
				family. Morning Worship is at 10:45 and we are usually done by around
				12:15. Come as you are and sit wherever you like.
			</p>
			<dl class="hours">
				<div><dt>Sunday School</dt><dd>9:45 AM</dd></div>
				<div><dt>Morning Worship</dt><dd>10:45 AM</dd></div>
				<div><dt>Wednesday Classes</dt><dd>6:30 PM</dd></div>
			</dl>
		</div>
		<div class="actions hero__actions">
			<a class="btn btn--solid" href="/visit/">Plan your visit</a>
			<a class="btn btn--line" href="/watch/">Hear this week's sermon</a>
		</div>
	</section>

	<section class="bay rule latest" aria-labelledby="this-week">
		<p class="eyebrow" id="this-week">This week</p>
		<div class="latest__lead">
			<h2 class="headline">{latest.title}</h2>
			<p class="latest__by">Brad Lindsey · {longDate(latest.date)}</p>
			<a class="link" href="/watch/">Listen to this sermon &rarr;</a>
		</div>
		<ol class="prior">
			{previous.map((s) => (
				<li>
					<a href="/watch/">
						<span class="prior__date">{shortDate(s.date)}</span>
						<span class="prior__title">{s.title}</span>
					</a>
				</li>
			))}
		</ol>
		<a class="link link--quiet" href="/watch/">All {data.total} sermons &rarr;</a>
	</section>

	<section class="bay verse" aria-label="Scripture">
		<blockquote>
			<p>
				For I determined not to know any thing among you, save Jesus Christ,
				and him <em>crucified</em>.
			</p>
			<cite>1 Corinthians 2:2</cite>
		</blockquote>
	</section>

	<section class="bay rule mission" aria-labelledby="mission-heading">
		<p class="eyebrow" id="mission-heading">Why we are here</p>
		<p class="mission__text">
			To preach and support the Gospel of Jesus Christ both locally and abroad,
			opening the door for lives to be changed and transformed through the power
			of Jesus Christ.
		</p>
		<p class="prose mission__where">
			"Abroad" is not a figure of speech. Brookside supports work in Romania,
			Moldova, Honduras, Guatemala and Israel, and it does not stop there.
		</p>
	</section>

	<section class="bay rule grid" aria-label="Start here">
		<article>
			<h3 class="subhead">New here?</h3>
			<p class="prose">
				There is a band, and the music is a mix of contemporary and traditional.
				Come in the front doors and someone will point you the rest of the way.
				Nobody will ask you to stand up.
			</p>
			<a class="link" href="/visit/">What a Sunday looks like &rarr;</a>
		</article>
		<article>
			<h3 class="subhead">{data.total} sermons</h3>
			<p class="prose">
				{years} years of preaching, all of it free, on Apple Podcasts, Spotify,
				and right here.
			</p>
			<a class="link" href="/watch/">Browse the archive &rarr;</a>
		</article>
		<article>
			<h3 class="subhead">Kids on Sunday</h3>
			<p class="prose">
				Nursery runs every Sunday, through both Sunday School and the main
				service. Kids Church starts at 10:45, and the children stay in with
				everyone for worship before heading out together.
			</p>
			<a class="link" href="/visit/#kids">Kids and childcare &rarr;</a>
		</article>
	</section>
</SiteLayout>

<style is:global>
	/* Page-level composition only. Anything reusable belongs in site.css. */
	.hero { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(3rem, 7vw, 4.5rem); }
	.hero__foot {
		display: flex; flex-wrap: wrap; gap: clamp(1.75rem, 5vw, 4.5rem);
		align-items: start; margin-top: clamp(2rem, 4vw, 3rem);
	}
	.hero__foot .lede { flex: 1 1 24rem; }
	.hero__foot .hours { margin-left: auto; flex: 0 1 auto; min-width: 15rem; }
	.hero__actions { margin-top: clamp(2rem, 4vw, 2.75rem); }

	.latest {
		padding-block: clamp(3rem, 7vw, 5rem);
		display: grid; gap: clamp(1.5rem, 2.5vw, 2.25rem) clamp(1.75rem, 4vw, 3.5rem);
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		align-items: start;
	}
	.latest .eyebrow { grid-column: 1 / -1; margin-bottom: 0; }
	.latest__by { margin: 0.9rem 0 1.25rem; color: var(--iron); font-size: 0.95rem; }
	.link--quiet { grid-column: 1 / -1; justify-self: start; font-size: 0.92rem; }

	.verse { padding-block: clamp(4.5rem, 11vw, 8rem); }
	.verse blockquote { margin: 0; }
	.verse p {
		/* The measure has to live on the element carrying the display size: a ch
		   on the blockquote resolves against body text and crushes this into a
		   one-word column. */
		margin: 0; max-width: 17ch; font-family: var(--display);
		font-size: clamp(1.9rem, 5.2vw, 3.9rem);
		font-variation-settings: 'wght' 500, 'opsz' 36;
		line-height: 1.06; letter-spacing: -0.03em; text-wrap: pretty;
	}
	.verse cite {
		display: block; margin-top: 1.6rem; font-style: normal;
		font-family: var(--mono); font-size: 0.7rem;
		letter-spacing: 0.18em; text-transform: uppercase; color: var(--iron);
	}

	.mission { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
	.mission__text {
		margin: 0; max-width: 34ch; font-family: var(--display);
		font-size: clamp(1.3rem, 2.6vw, 2rem);
		font-variation-settings: 'wght' 500, 'opsz' 24;
		line-height: 1.25; letter-spacing: -0.025em; text-wrap: pretty;
	}
	/* The countries sit under the mission statement rather than beside it: the
	   claim comes first, the evidence second. */
	.mission__where { margin: 1.5rem 0 0; max-width: 46ch; }

	.grid {
		display: grid; gap: clamp(1.75rem, 3.5vw, 3rem);
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		padding-block: clamp(3rem, 6vw, 4.5rem);
	}

	@media (max-width: 720px) {
		.latest { grid-template-columns: 1fr; }
		.hero__foot .hours { width: 100%; margin-left: 0; }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import SplitText from 'gsap/SplitText';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const lenis = new Lenis({ duration: 1.05 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((t) => lenis.raf(t * 1000));
		gsap.ticker.lagSmoothing(0);

		const heading = document.querySelector<HTMLElement>('[data-split]');
		if (heading) {
			const split = new SplitText(heading, { type: 'lines', linesClass: 'line', mask: 'lines' });
			gsap.from(split.lines, {
				yPercent: 130, duration: 1.1, ease: 'power4.out', stagger: 0.09, delay: 0.1,
			});
		}

		gsap.from('.hero .eyebrow, .hero__foot, .hero__actions', {
			opacity: 0, y: 16, duration: 0.75, ease: 'power2.out', stagger: 0.1, delay: 0.4,
		});

		// Reveals start high in the viewport so anything below the fold is already
		// on screen by the time it plays: nothing sits at zero opacity waiting for
		// a trigger that might never fire.
		gsap.utils.toArray<HTMLElement>(
			'.latest__lead, .prior, .verse blockquote, .mission__text, .grid > article, .foot > *',
		).forEach((el) => {
			gsap.from(el, {
				opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
				scrollTrigger: { trigger: el, start: 'top 92%', once: true },
			});
		});
	}
</script>
