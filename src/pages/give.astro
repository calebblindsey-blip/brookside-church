---
/**
 * Give, in Codex's design (Round 4 of the port). Layout follows app/give/page.tsx.
 * Every payment path the Astro page listed is kept: Planning Center, PayPal (the
 * church's hosted button), the Church Center app on both stores, in person, and
 * the P.O. Box. The street address is NOT interchangeable with the box; mail to
 * the street may not arrive.
 *
 * `data-ga-event="give_click"` marks the three links that leave the site to give.
 * They are the last observable moment of giving intent, and the delegated
 * listener in SiteLayout reads the attribute. The two app-store links are
 * deliberately not give_click: installing an app is a different intent from
 * giving today, and folding them in would inflate the number that decides
 * whether this page works. verify-brookside-analytics.mjs counts these.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import { CHURCH } from '../data/church';

const CHURCH_CENTER = 'https://brooksidechurchofgod.churchcenter.com/giving';
const PAYPAL = 'https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&hosted_button_id=FART3Y3N8DTHA';
const APP_IOS = 'https://apps.apple.com/us/app/church-center-app/id1357742931';
const APP_ANDROID = 'https://play.google.com/store/apps/details?id=com.ministrycentered.churchcenter';
---

<SiteLayout
	title="Give"
	description="Give to Brookside Church of God online through Planning Center or PayPal, in the Church Center app, in person on a Sunday, or by mail."
>
	<InteriorHero eyebrow="Give · Brookside Church of God">
		<Fragment slot="title">One church,<br /><em>kept going</em><br />by its people.</Fragment>
		<p slot="intro">Giving here pays for the ministry of this church and supports the Gospel beyond it. However you choose to give, it goes to the same place.</p>
		<a slot="aside" class="button button-copper" data-ga-event="give_click" href={CHURCH_CENTER} target="_blank" rel="noopener">Give securely online <span class="arrow" aria-hidden="true">↗</span></a>
	</InteriorHero>

	<section class="inner-section inner-blue" aria-labelledby="ways-heading">
		<div><p class="eyebrow">Four ways to give</p><h2 id="ways-heading">Simple and secure.</h2></div>
		<div class="method-grid">
			<article>
				<span>01</span>
				<h3>Online</h3>
				<p>Our secure giving portal runs on Planning Center, the same system the church uses for its groups and scheduling. Give once or set giving to repeat, with a card or straight from a bank account.</p>
				<a class="text-link" data-ga-event="give_click" href={CHURCH_CENTER} target="_blank" rel="noopener">Planning Center <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link" data-ga-event="give_click" href={PAYPAL} target="_blank" rel="noopener">PayPal <span class="arrow" aria-hidden="true">↗</span></a>
			</article>
			<article>
				<span>02</span>
				<h3>Church Center app</h3>
				<p>The same giving, on your phone, along with the church directory and groups. Sign in once and giving takes a few seconds after that.</p>
				<a href={APP_IOS} target="_blank" rel="noopener">iPhone <span class="arrow" aria-hidden="true">↗</span></a><br />
				<a href={APP_ANDROID} target="_blank" rel="noopener">Android <span class="arrow" aria-hidden="true">↗</span></a>
			</article>
			<article>
				<span>03</span>
				<h3>In person</h3>
				<p>Envelopes are in the foyers at weekend and midweek services. Cash or check, into the offering containers. Nobody passes a plate down the row and nobody is put on the spot.</p>
			</article>
			<article>
				<span>04</span>
				<h3>By mail</h3>
				<p>Checks can be mailed to the church office.</p>
				<address class="method-addr">Brookside COG<br />P.O. Box 24<br />Brookside, AL 35036</address>
			</article>
		</div>
	</section>

	<section class="inner-section split-section" aria-labelledby="terms-heading">
		<div><p class="eyebrow">Tithes and offerings</p><h2 id="terms-heading">Giving with purpose.</h2></div>
		<div class="definition-stack">
			<article><h3>Tithe</h3><p>Ten percent of our income, contributed to the church on a regular basis.</p></article>
			<article><h3>Offering</h3><p>What we give when we feel called to give over and above the tithe.</p></article>
		</div>
	</section>

	<section class="inner-section inner-copper split-section" aria-labelledby="ask-heading">
		<div><p class="eyebrow">Questions about giving</p><h2 id="ask-heading">Ask, and someone will actually answer.</h2></div>
		<div>
			<p class="lead">Giving statements, recurring gifts, correcting something that went through wrong, or giving toward something specific. Call the office or send an email.</p>
			<div class="card-actions">
				<a class="button button-light" href={CHURCH.phoneHref}>{CHURCH.phone} <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link" href={CHURCH.emailHref}>{CHURCH.email} <span class="arrow" aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>
</SiteLayout>
