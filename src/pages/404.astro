---
/**
 * 404, in Codex's design (Round 4 of the port). The interior opener with the
 * gather card, then the Astro page's four doors: the whole site in one screen,
 * for a reader who arrived on an address that did not survive the 2026 rebuild.
 * Each door names its destination and says what is there, so a bare list of
 * words never happens.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import Times from '../components/Times.astro';
import { CHURCH } from '../data/church';

const doors = [
	{ href: '/watch/', name: 'Sermons', note: 'Every sermon the church has recorded, back to 2020, and all of them play here.' },
	{ href: '/visit/', name: 'Plan a visit', note: 'Service times, the address on Cardiff Street, and how to ask a question first.' },
	{ href: '/about/', name: 'About the church', note: 'What this church believes and who leads it.' },
	{ href: '/give/', name: 'Give', note: 'Online, in the Church Center app, in person on a Sunday, or by mail.' },
];
---

<SiteLayout
	title="Page not found"
	noindex
	description="That address is not on this site. The sermon archive, service times, what the church believes, and giving are all one link away."
>
	<InteriorHero eyebrow="404 · Page not found">
		<Fragment slot="title">Nothing at<br />that <em>address.</em></Fragment>
		<p slot="intro">This site was rebuilt in 2026 and a few of the old addresses did not survive the move. Nothing was lost, it just lives somewhere else now.</p>
		<Fragment slot="aside"><p class="eyebrow">We gather</p><Times /></Fragment>
	</InteriorHero>

	<section class="inner-section inner-blue" aria-labelledby="doors-heading">
		<div>
			<p class="eyebrow">The whole site</p>
			<h2 id="doors-heading">Everything is one link away.</h2>
			<div class="card-actions">
				<a class="button button-light" href="/">Back to the home page <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link" href={CHURCH.phoneHref}>Call the church <span class="arrow" aria-hidden="true">↗</span></a>
			</div>
		</div>
		<div class="platform-cards">
			{doors.map((d) => <a href={d.href}><span>{d.note}</span><strong>{d.name}</strong><span class="arrow" aria-hidden="true">↗</span></a>)}
		</div>
	</section>
</SiteLayout>
