---
/**
 * 404.
 *
 * This page exists because of the cutover, not because of typos. The old
 * Squarespace site published 302 URLs and this one publishes six, so for a
 * while the most common visitor here will be somebody following a link that
 * worked last week — a saved sermon, a search result, a link in a Facebook
 * post from 2019.
 *
 * The known old URLs are redirected in public/_redirects and never reach this
 * page. What reaches it is the long tail nobody enumerated, so the page's job
 * is to say plainly that the address is dead and hand over the whole site in
 * one screen, rather than apologise and leave the reader to find the nav.
 *
 * Four destinations, each with the one sentence that tells somebody whether it
 * is the one they wanted. No search box: six pages do not need searching, and a
 * box that returns nothing is worse than a list that cannot.
 *
 * No crossAt. The crossbar is Home's payoff and this is not the page to spend
 * it on.
 *
 * Keep this page taller than the viewport. The line is drawn against scroll
 * position, and a page a hair shorter than the window can leave it stopping
 * just short of the bottom with no scroll available to finish it.
 */
import SiteLayout from '../layouts/SiteLayout.astro';

const doors = [
	{
		href: '/watch',
		name: 'Sermons',
		note: 'Every sermon the church has recorded, back to 2020, and all of them play here.',
	},
	{
		href: '/visit',
		name: 'Plan a visit',
		note: 'Service times, the address on Cardiff Street, and how to ask a question first.',
	},
	{
		href: '/about',
		name: 'About the church',
		note: 'What this church believes and who leads it.',
	},
	{
		href: '/give',
		name: 'Give',
		note: 'Online, in the Church Center app, in person on a Sunday, or by post.',
	},
];
---

<SiteLayout
	title="Page not found"
	description="That address is not on this site. The sermon archive, service times, what the church believes, and giving are all one link away."
>
	<section class="bay ntop">
		<p class="eyebrow">404 &middot; Brookside Church of God</p>
		<h1 class="display" data-split>
			Nothing<br />at that<br /><em>address</em>
		</h1>
		<div class="ntop__foot">
			<p class="lede">
				This site was rebuilt in 2026 and a few of the old addresses did not
				survive the move. Nothing was lost, it just lives somewhere else now.
			</p>
		</div>
	</section>

	<section class="bay rule doors" aria-labelledby="doors-heading">
		<p class="eyebrow" id="doors-heading">The whole site</p>
		<ul class="doors__list">
			{doors.map((d) => (
				<li class="door">
					<a class="door__hit" href={d.href}>
						<span class="door__name">{d.name}</span>
						<span class="door__note">{d.note}</span>
					</a>
				</li>
			))}
		</ul>
		<div class="actions doors__actions">
			<a class="btn btn--solid" href="/">Back to the home page</a>
			<a class="btn btn--line" href="tel:+12056750703">Call the church</a>
		</div>
	</section>
</SiteLayout>

<style is:global>
	/* Page-level composition only. Anything reusable belongs in site.css. */

	.ntop { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4rem); }
	.ntop__foot { margin-top: clamp(2rem, 4vw, 3rem); max-width: 46rem; }

	.doors { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3rem, 7vw, 5rem); }
	.doors__list { list-style: none; margin: 0; padding: 0; max-width: 52rem; }

	/*
		Same two-column row as Watch's archive and Visit's times: the name in the
		left column, the sentence beside it. A reader who arrives here by accident
		still sees the system the rest of the site is built on.
	*/
	.door { border-top: 1px solid var(--ash); }
	.door:last-child { border-bottom: 1px solid var(--ash); }

	.door__hit {
		display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
		gap: clamp(0.75rem, 2vw, 1.75rem);
		align-items: baseline;
		padding: clamp(1rem, 2.4vw, 1.5rem) 0;
		color: inherit; text-decoration: none;
	}
	.door__name {
		font-family: var(--display); font-size: clamp(1.15rem, 2.4vw, 1.55rem);
		font-variation-settings: 'wght' 600, 'opsz' 24; letter-spacing: -0.025em;
	}
	.door__note { color: var(--iron); line-height: 1.6; font-size: 0.96rem; }

	/* Coral marks the line being pointed at, the same job it does everywhere
	   else on the site, rather than becoming a hover colour of its own. */
	.door__hit:hover .door__name,
	.door__hit:focus-visible .door__name { color: var(--coral); }
	.door__hit:focus-visible { outline: 2px solid var(--coral); outline-offset: 4px; }

	.doors__actions { margin-top: clamp(2rem, 4vw, 3rem); }

	@media (max-width: 720px) {
		.door__hit { grid-template-columns: 1fr; gap: 0.35rem; }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import SplitText from 'gsap/SplitText';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const lenis = new Lenis({ duration: 1.05 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((t) => lenis.raf(t * 1000));
		gsap.ticker.lagSmoothing(0);

		const heading = document.querySelector<HTMLElement>('[data-split]');
		if (heading) {
			const split = new SplitText(heading, { type: 'lines', linesClass: 'line', mask: 'lines' });
			gsap.from(split.lines, {
				yPercent: 110, duration: 1.1, ease: 'power4.out', stagger: 0.09, delay: 0.1,
			});
		}

		gsap.from('.ntop .eyebrow, .ntop__foot', {
			opacity: 0, y: 16, duration: 0.75, ease: 'power2.out', stagger: 0.1, delay: 0.4,
		});

		// Reveals start high in the viewport so anything below the fold is already
		// on screen by the time it plays, rather than sitting at zero opacity
		// waiting for a trigger that may never fire.
		gsap.utils.toArray<HTMLElement>(
			'.doors .eyebrow, .door, .doors__actions, .foot > *',
		).forEach((el) => {
			gsap.from(el, {
				opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
				scrollTrigger: { trigger: el, start: 'top 92%', once: true },
			});
		});
	}
</script>
