---
/**
 * Watch: the archive's page.
 *
 * The generic version of this page is a black video hero, a card grid of
 * "recent sermons", and a search box with a magnifying glass. The material that
 * is actually specific to Brookside is the archive itself: 291 sermons running
 * back to March 2020. So the archive IS the page, and the structural device is
 * the year, which is real information rather than decoration.
 *
 * Two content rules, both learned the hard way and both load-bearing:
 *   - The archive is NOT unbroken. 291 sermons across 332 weeks with nine gaps
 *     over three weeks (longest 62 days, spring 2020). Never write "every
 *     Sunday" or "every week without a gap" anywhere on this page.
 *   - The third column is the RUNTIME, not a season/episode tag. The old
 *     Squarespace feed carried S/E numbers and the migration dropped them; the
 *     numbering was incoherent anyway (S2 was 2022, S3 was 2020) and Anchor
 *     emits none, so every future episode would have rendered blank at the top
 *     of the list. Do not reintroduce them from the old snapshot.
 *
 * Rows play. One <audio> for the whole page, driven from a deck pinned to the
 * bottom of the viewport, rather than a player per row: 291 media elements is
 * both a memory problem and a page that reads as a control panel instead of an
 * archive. The row is a cue, the deck is the instrument.
 *
 * No crossAt: the line runs as a plain spine here. The crossbar is Home's
 * payoff and repeating it on every page spends it.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import PodcastSchema from '../components/PodcastSchema.astro';
import InteriorHero from '../components/InteriorHero.astro';
import data from '../data/sermons.json';
import live from '../data/live.json';

const APPLE = 'https://podcasts.apple.com/us/podcast/id1094539094';
const SPOTIFY = 'https://open.spotify.com/show/6KxGfsUUCpUN6xyVMPEy76';
const YOUTUBE = 'https://www.youtube.com/channel/UCFVvTNQHSyICAekmJdQ47Eg';
const YOUTUBE_LIVE = `${YOUTUBE}/live`;

const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const longDate = (iso: string) => {
	const [y, m, d] = iso.split('-');
	return `${months[Number(m) - 1]} ${Number(d)}, ${y}`;
};
const rowDate = (iso: string) => {
	const [, m, d] = iso.split('-');
	return `${months[Number(m) - 1].slice(0, 3)} ${String(Number(d)).padStart(2, '0')}`;
};
const monthYear = (iso: string) => {
	const [y, m] = iso.split('-');
	return `${months[Number(m) - 1]} ${y}`;
};

type Episode = (typeof data.episodes)[number];

const episodes: Episode[] = data.episodes;
const latest = episodes[0];
const firstEver = episodes[episodes.length - 1];

/** Clock time, not prose: the column is scanned down, so it has to stay narrow
    and tabular. One sermon runs 1:17, so the hour slot cannot be assumed away. */
const clock = (s: number) => {
	const h = Math.floor(s / 3600);
	const m = Math.floor((s % 3600) / 60);
	const sec = s % 60;
	return h
		? `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`
		: `${m}:${String(sec).padStart(2, '0')}`;
};

/** Spoken form for the button's accessible name. "44:12" is read as a time of
    day by most screen readers, which is not what a runtime means. */
const spoken = (s: number) => {
	const h = Math.floor(s / 3600);
	const m = Math.round((s % 3600) / 60);
	const hp = h ? `${h} hour${h === 1 ? '' : 's'} ` : '';
	return `${hp}${m} minute${m === 1 ? '' : 's'}`;
};

// Grouped in a single pass rather than by filtering per year: the feed is
// already sorted newest-first, so a year change is just a boundary.
const years: { year: string; items: Episode[] }[] = [];
for (const ep of episodes) {
	const y = ep.date.slice(0, 4);
	const open = years[years.length - 1];
	if (open && open.year === y) open.items.push(ep);
	else years.push({ year: y, items: [ep] });
}

// Spelled out rather than set as a numeral: at display size "6 years" reads as
// a stat, and the eyebrow already carries the counts. Recomputed from the feed
// so it stays true as the archive grows.
const WORDS = ['zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve'];
const span = Number(data.newest.slice(0, 4)) - Number(data.oldest.slice(0, 4));
const spanWord = WORDS[span] ?? String(span);

/*
	The most recent completed live stream, from src/data/live.json, rebuilt by
	`npm run live`. Every field is optional on purpose: if the poster pull found
	nothing it could stand behind, it writes nothing, and the card has to render
	as the flat ink panel it was before rather than as a broken image.

	The date is formatted from actualStartTime, which is the moment the broadcast
	actually began. It is NOT publishedAt: YouTube reported the August 23 service
	as published on August 24, so publishedAt would print the wrong Sunday.

	Two timezones have to be pinned down here and neither can be left to default.
	actualStartTime is UTC, so slicing the string dates a Wednesday 6:30 PM
	service (00:30 UTC) to Thursday. Passing it through a bare Date uses the BUILD
	MACHINE's zone, so the same build produces different copy on a laptop in a
	different state. America/Chicago is named explicitly because that is the zone
	the service actually happened in, which is the only one a reader cares about.
*/
const inChicago = new Intl.DateTimeFormat('en-US', {
	month: 'long', day: 'numeric', timeZone: 'America/Chicago',
});
const streamDate = live.startedAt ? inChicago.format(new Date(live.startedAt)) : null;
---

<SiteLayout
	title="Watch"
	description={`All ${data.total} sermons Brookside Church of God has recorded since ${monthYear(data.oldest)}, plus the Sunday livestream. Worship streams live at 10:45 AM.`}
>
	{/*
		In the body rather than the head, which JSON-LD permits and Google reads
		either way. Props rather than a second import of sermons.json inside the
		component: the page already holds the numbers, so the schema cannot
		disagree with the eyebrow directly above it.
	*/}
	<PodcastSchema
		total={data.total}
		oldest={data.oldest}
		newest={data.newest}
		feed={data.feed}
		profiles={[APPLE, SPOTIFY, YOUTUBE]}
	/>

	<InteriorHero eyebrow={`Watch & listen · ${data.total} sermons`}>
		<Fragment slot="title">{spanWord} years of<br />preaching.<br /><em>One subject.</em></Fragment>
		<p slot="intro">Sunday worship streams live at 10:45 AM. Everything before it is here, back to the first recording in {monthYear(data.oldest)}. Search the archive, then listen right here or wherever you already listen.</p>
		<Fragment slot="aside">
			<p class="eyebrow">Live Sunday</p>
			<p class="broadcast-time">10:45<small>AM</small></p>
			<a class="button button-light" href={YOUTUBE_LIVE} target="_blank" rel="noopener">Watch live <span class="arrow" aria-hidden="true">↗</span></a>
			<a class="text-link inner-aside-link" href="#live">Watch on this page</a>
		</Fragment>
	</InteriorHero>

	{/*
		Two different things side by side, on purpose: the left column is the
		newest podcast EPISODE from the feed, the right is the newest full SERVICE
		from the channel. The channel carries both, so in a given week they can
		legitimately name different things.
	*/}
	<section class="inner-section live-section" id="live" aria-labelledby="latest-heading">
		<div class="feature__lead">
			<p class="eyebrow" id="latest-heading">Most recent sermon</p>
			<h2 class="feature-title">{latest.title}</h2>
			{/*
				The speaker comes from the feed, never hardcoded. About one Sunday in
				five is a guest, so a fixed name here credits the pastor for other
				people's preaching regularly. When the feed names nobody the line is
				dropped rather than filled in with an assumption.
			*/}
			<p class="feature__meta">
				{latest.speaker && (<><span>{latest.speaker}</span><span aria-hidden="true">·</span></>)}
				<span>{longDate(latest.date)}</span>
				<span aria-hidden="true">·</span>
				<span class="feature__tag">{clock(latest.seconds)}</span>
			</p>
			<div class="card-actions feature__actions">
				<button
					class="button button-light"
					type="button"
					data-cue
					data-src={latest.url}
					data-label={latest.title}
					data-when={longDate(latest.date)}
				>Play this sermon <span class="arrow" aria-hidden="true">▶</span></button>
				<a class="text-link" href={APPLE} target="_blank" rel="noopener">Apple Podcasts <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link" href={SPOTIFY} target="_blank" rel="noopener">Spotify <span class="arrow" aria-hidden="true">↗</span></a>
			</div>
		</div>
		{/*
			Click-to-play rather than a bare iframe, and this is the load-bearing
			property of the panel: no third-party request and no YouTube cookie until
			a visitor asks, and the page cannot be made to look broken by something
			outside our control. The poster is a frame of THIS room, pulled at build
			time by scripts/pull-live.mjs and served from our own origin. The script
			replaces the button with the iframe on click, inside .live-player.
		*/}
		<figure class="live-figure feature__media">
			<div class="live-player">
				<button
					class="screen"
					class:list={[{ 'screen--posterless': !live.poster }]}
					type="button"
					data-play
					data-video={live.videoId}
					aria-label={streamDate ? `Watch the service from ${streamDate}` : 'Watch the service'}
				>
					{live.poster && (
						<img
							class="screen__poster"
							src={live.poster}
							alt=""
							width={live.posterWidth}
							height={live.posterHeight}
							loading="lazy"
							decoding="async"
						/>
					)}
					<span class="screen-play" aria-hidden="true"><span>▶</span></span>
					<span class="screen__state" aria-live="polite" data-state>
						{streamDate ? `Most recent service · ${streamDate}` : 'Live Sundays, 10:45 AM'}
					</span>
					<span class="screen__cue" data-cue-text>Watch the service</span>
					<span class="screen__note" data-note>Live on Sunday morning. The rest of the week, the most recent one.</span>
				</button>
			</div>
			<figcaption class="live-note">Nothing loads from YouTube until you press play. <a class="feature__past" href={YOUTUBE} target="_blank" rel="noopener">Every service on YouTube</a>.</figcaption>
		</figure>
	</section>

	<section class="inner-section archive-section" aria-labelledby="archive-heading">
		<div>
			<p class="eyebrow" id="archive-heading">Sermon archive · {data.total} messages</p>
			<h2>Find a message.</h2>
			<p class="lead">Search by title, filter by year, then press play. Every sermon since {monthYear(data.oldest)} plays right here.</p>
		</div>
		<div class="archive-panel">
			<div class="seek">
				<label class="seek__field" for="seek">Search sermons</label>
				<input type="search" id="seek" placeholder="Search by title" autocomplete="off" spellcheck="false" />
				<p class="seek__count" role="status" aria-live="polite" data-count>
					<span data-shown>{data.total}</span> of {data.total}
				</p>
				<div class="seek__years" role="group" aria-label="Filter by year">
					<button type="button" class="chip" data-year="all" aria-pressed="true">All</button>
					{years.map((g) => (
						<button type="button" class="chip" data-year={g.year} aria-pressed="false">{g.year}</button>
					))}
				</div>
			</div>
			<div class="roll" data-roll>
				{years.map((g) => (
					<section class="stack" data-group={g.year} aria-labelledby={`y-${g.year}`}>
						<div class="stack__mark">
							<h3 class="stack__year" id={`y-${g.year}`}>{g.year}</h3>
							<p class="stack__count">{g.items.length} sermons</p>
						</div>
						{/* The button is inside the li rather than the li being the control, so the list keeps its semantics. */}
						<ol class="stack__list">
							{g.items.map((e) => (
								<li class="row" data-title={e.title.toLowerCase()} data-year={g.year}>
									<button
										class="row__hit"
										type="button"
										data-cue
										data-src={e.url}
										data-label={e.title}
										data-when={longDate(e.date)}
										aria-label={`Play “${e.title}”, ${longDate(e.date)}, ${spoken(e.seconds)}`}
									>
										<span class="row__date">{rowDate(e.date)}</span>
										<span class="row__title">{e.title}</span>
										<span class="row__time">{clock(e.seconds)}</span>
									</button>
								</li>
							))}
						</ol>
					</section>
				))}
				<p class="roll__empty" data-empty hidden></p>
			</div>
			<p class="roll__origin">
				The archive begins with <em>{longDate(firstEver.date)}</em>, “{firstEver.title}”.
			</p>
		</div>
	</section>

	<section class="inner-section inner-blue media-section" aria-labelledby="subscribe-heading">
		<div>
			<p class="eyebrow">Take it with you</p>
			<h2 id="subscribe-heading">The message goes with you.</h2>
			<p class="lead">The complete archive goes back to {monthYear(data.oldest)} and is free on the platforms you already use.</p>
		</div>
		<div class="platform-cards">
			<a class="port" href={APPLE} target="_blank" rel="noopener"><span class="port__note">The full archive, back to 2020.</span><strong class="port__name">Apple Podcasts</strong><span class="arrow" aria-hidden="true">↗</span></a>
			<a class="port" href={SPOTIFY} target="_blank" rel="noopener"><span class="port__note">The same archive, without leaving the app.</span><strong class="port__name">Spotify</strong><span class="arrow" aria-hidden="true">↗</span></a>
			<a class="port" href={YOUTUBE} target="_blank" rel="noopener"><span class="port__note">Where the Sunday service streams live.</span><strong class="port__name">YouTube</strong><span class="arrow" aria-hidden="true">↗</span></a>
		</div>
	</section>

	{/*
		The gospel link, the highest-intent position on the whole site: somebody
		at the bottom of the sermon archive has just listened to preaching. No
		hours figure: a draft said "nine hundred hours", which was invented.
	*/}
	<section class="inner-section inner-copper split-section" aria-labelledby="appeal-heading">
		<div><p class="eyebrow">The message behind all of it</p><h2 id="appeal-heading">Every one of these sermons is about the same thing.</h2></div>
		<div>
			<p class="lead">{spanWord} years of preaching comes back to one subject, and it is not a complicated one. If you would rather read it than listen to it, it is written out plainly.</p>
			<a class="button button-light" href="/knowing-christ/">How a person comes to Christ <span class="arrow" aria-hidden="true">↗</span></a>
		</div>
	</section>

	{/*
		The deck. Rendered inert and empty; the script fills it on the first play
		and it is removed from the a11y tree until then. aria-live on the
		now-playing line rather than role="status" on the whole deck: the scrub
		position updates four times a second.
	*/}
	<div class="deck" data-deck hidden>
		<div class="deck__in">
			<button class="deck__toggle" type="button" data-toggle aria-label="Pause">
				<span class="deck__glyph" data-glyph aria-hidden="true"></span>
			</button>
			<div class="deck__body">
				<p class="deck__now" aria-live="polite">
					<span class="deck__title" data-deck-title></span>
					<span class="deck__when" data-deck-when></span>
				</p>
				<label class="deck__scrub">
					<span class="deck__scrub-label">Seek</span>
					<input type="range" data-seek min="0" max="1000" value="0" step="1" />
				</label>
			</div>
			<p class="deck__time">
				<span data-at>0:00</span><span class="deck__slash" aria-hidden="true">/</span><span data-dur>0:00</span>
			</p>
			<button class="deck__close" type="button" data-close aria-label="Close player">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" fill="none" />
				</svg>
			</button>
		</div>
		<audio data-audio preload="none"></audio>
	</div>
</SiteLayout>

<style is:global>
	/*
		Watch, page-level composition in Codex's language, drawn around the hooks
		the deck script depends on ([data-cue], [data-play], [data-deck], .row,
		.stack, .chip, #seek). Anything reusable belongs in site.css.
	*/
	:root { --chrome-h: 96px; }

	/* ---------- most recent + live ---------- */
	.live-section { align-items: start; }
	.inner-section h2.feature-title { font-size: clamp(1.9rem, 3.6vw, 3.2rem); line-height: 1.08; letter-spacing: -.04em; font-weight: 550; }
	.feature__meta { display: flex; flex-wrap: wrap; gap: 0 .6rem; margin: 0 0 26px; color: #587083; font-size: .95rem; }
	.feature__tag { font-variant-numeric: tabular-nums; }
	.screen { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: .3rem; width: 100%; margin: 0; padding: clamp(18px, 2.5vw, 30px); background: #10283b; border: 0; color: #fff; text-align: left; font: inherit; cursor: pointer; overflow: hidden; }
	.screen__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; transition: transform .4s cubic-bezier(.22, 1, .36, 1); }
	.screen:hover .screen__poster { transform: scale(1.02); }
	.screen::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, #10283bd9 0%, #10283b8c 38%, #10283b1f 70%, transparent 100%); }
	.screen--posterless::after { display: none; }
	.screen > span { position: relative; z-index: 1; }
	.screen-play { position: absolute; left: 50%; top: 42%; translate: -50% -50%; z-index: 1; width: clamp(64px, 8vw, 96px); aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: var(--bone); color: var(--water); font-size: 1.4rem; box-shadow: 0 12px 40px #00000055; transition: scale .3s; }
	.screen-play > span { margin-left: 4px; }
	.screen:hover .screen-play, .screen:focus-visible .screen-play { scale: 1.06; }
	.screen__state { display: flex; align-items: center; gap: .5rem; margin-bottom: auto; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 650; color: #c7dfef; }
	.screen__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--copper); flex: none; }
	.screen[data-live] .screen__dot { animation: screen-pulse 1.8s ease-in-out infinite; }
	.screen__cue { font-size: clamp(1.15rem, 2.2vw, 1.7rem); font-weight: 550; letter-spacing: -.02em; line-height: 1.15; }
	.screen__note { font-size: .9rem; color: #dbe9f3; }
	@keyframes screen-pulse { 50% { opacity: .35; } }
	.feature__past { color: var(--water); font-weight: 650; text-decoration: underline; text-underline-offset: 4px; }

	/* ---------- archive ---------- */
	.archive-section { align-items: start; }
	.seek input::-webkit-search-cancel-button { -webkit-appearance: none; }
	.seek__count [data-shown] { color: var(--ink); font-weight: 600; }
	.seek__years { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; }
	.chip { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 6px 14px; border: 1px solid #99b9ce; border-radius: 999px; background: #fff; color: #294f6b; cursor: pointer; font: 500 .8rem/1 var(--font-sans), sans-serif; font-variant-numeric: tabular-nums; transition: border-color .18s, color .18s, background .18s; }
	.chip:hover { border-color: var(--water); color: var(--water); }
	.chip[aria-pressed='true'] { background: var(--water); border-color: var(--water); color: #fff; }
	.stack { display: grid; grid-template-columns: minmax(0, 7rem) minmax(0, 1fr); gap: 16px 28px; padding-top: 24px; }
	.stack[hidden] { display: none; }
	.stack__mark { position: sticky; top: calc(var(--chrome-h) + 12px); align-self: start; }
	.stack__year { margin: 0; color: var(--water); font: 400 clamp(2rem, 4vw, 3rem)/1 var(--font-serif), serif; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
	.stack__count { margin: 6px 0 0; color: #587083; font-size: .8rem; }
	.stack__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
	.row { position: relative; border-bottom: 1px solid var(--line); }
	.row[hidden] { display: none; }
	.row__hit { display: grid; grid-template-columns: 4.2rem minmax(0, 1fr) auto; gap: 18px; align-items: baseline; width: 100%; margin: 0; padding: 14px 0; background: none; border: 0; border-radius: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; }
	.row__hit:hover .row__title { color: var(--water); }
	.row__hit:focus-visible { outline-offset: -2px; }
	.row[data-playing] { background: var(--foam); margin-inline: -12px; padding-inline: 12px; }
	.row[data-playing] .row__title { color: var(--water); font-weight: 600; }
	.row__date { color: #587083; font-size: .8rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.row__title { font-size: .98rem; line-height: 1.35; text-wrap: pretty; transition: color .18s; }
	.row__time { color: #7b93a5; font-size: .8rem; font-variant-numeric: tabular-nums; }
	.row mark { background: none; color: var(--water); font-weight: 600; }
	.roll__empty { margin: 28px 0 0; padding: 28px; background: var(--foam); }
	.roll__origin { margin: 32px 0 0; padding-top: 18px; border-top: 1px solid var(--line); color: #587083; font-size: .95rem; line-height: 1.6; }
	.roll__origin em { color: var(--copper); }

	/* ---------- deck ---------- */
	/* Floating card, pinned beside the motion toggle on desktop and above it on phones. */
	body.has-deck { padding-bottom: calc(var(--deck-h, 76px) + 40px); }
	.deck { position: fixed; z-index: 45; left: 18px; right: 190px; bottom: 18px; max-width: 900px; background: #fffffff6; border: 1px solid #a5bece; border-radius: 16px; box-shadow: 0 12px 40px #30587326; backdrop-filter: blur(12px); transform: translateY(calc(100% + 24px)); transition: transform .38s cubic-bezier(.22, 1, .36, 1); }
	.deck[data-open] { transform: none; }
	.deck__in { display: flex; align-items: center; gap: 14px; padding: 12px 14px; }
	.deck__toggle { flex: none; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; background: var(--water); color: #fff; border: 0; border-radius: 50%; cursor: pointer; }
	.deck__glyph { width: 12px; height: 13px; background: currentColor; clip-path: polygon(0 0, 100% 50%, 0 100%); margin-left: 2px; }
	.deck[data-state='playing'] .deck__glyph { clip-path: none; background: linear-gradient(90deg, currentColor 0 38%, transparent 38% 62%, currentColor 62%); margin-left: 0; }
	.deck__body { flex: 1 1 auto; min-width: 0; }
	.deck__now { margin: 0 0 6px; display: flex; gap: 10px; align-items: baseline; min-width: 0; font-size: .9rem; }
	.deck__title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
	.deck__when { color: #587083; white-space: nowrap; font-size: .8rem; }
	.deck[data-error] .deck__when { color: var(--copper); }
	.deck__scrub { display: block; }
	.deck__scrub-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
	.deck__scrub input { -webkit-appearance: none; appearance: none; display: block; width: 100%; height: 44px; margin: -15px 0; background: none; cursor: pointer; }
	.deck__scrub input::-webkit-slider-runnable-track { height: 3px; background: #c5dae7; border-radius: 2px; }
	.deck__scrub input::-moz-range-track { height: 3px; background: #c5dae7; border-radius: 2px; }
	.deck__scrub input::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 16px; height: 16px; margin-top: -7px; border: 0; border-radius: 50%; background: var(--water); }
	.deck__scrub input::-moz-range-thumb { width: 16px; height: 16px; border: 0; border-radius: 50%; background: var(--water); }
	.deck__scrub input:focus-visible { outline-offset: 2px; }
	.deck__time { margin: 0; flex: none; color: #587083; font-size: .8rem; font-variant-numeric: tabular-nums; }
	.deck__slash { padding: 0 .35rem; opacity: .5; }
	.deck__close { flex: none; width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border: 1px solid #a5bece; border-radius: 50%; background: #fff; color: #294f6b; cursor: pointer; }

	@media (max-width: 800px) {
		:root { --chrome-h: 82px; }
		.stack { grid-template-columns: 1fr; gap: 10px; }
		.stack__mark { position: static; display: flex; align-items: baseline; gap: 12px; }
		.stack__count { margin: 0; }
		.row__hit { grid-template-columns: 3.4rem minmax(0, 1fr) auto; gap: 12px; }
		.deck { right: 18px; bottom: 76px; }
		.deck__slash, .deck__time [data-dur], .deck__when { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.deck { transition: none; }
		.screen[data-live] .screen__dot { animation: none; }
		.screen__poster, .screen-play { transition: none; }
		.screen:hover .screen__poster { transform: none; }
	}
</style>

<script>
	import { track } from '../lib/analytics';

	/* ---------- archive filter ---------- */

	const input = document.querySelector<HTMLInputElement>('#seek');
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
	const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));
	const shown = document.querySelector<HTMLElement>('[data-shown]');
	const empty = document.querySelector<HTMLElement>('[data-empty]');
	const origin = document.querySelector<HTMLElement>('.roll__origin');

	// Cached once: reading dataset for 291 rows on every keystroke is the
	// difference between instant and laggy on a phone.
	const index = rows.map((el) => ({
		el,
		title: el.dataset.title || '',
		year: el.dataset.year || '',
		label: el.querySelector<HTMLElement>('.row__title'),
		text: el.querySelector<HTMLElement>('.row__title')?.textContent || '',
	}));

	let year = 'all';

	/** Marks the matched run inside the title so the hit is visible, not just implied. */
	function paint(item: (typeof index)[number], q: string) {
		if (!item.label) return;
		if (!q) {
			if (item.label.firstElementChild) item.label.textContent = item.text;
			return;
		}
		const at = item.title.indexOf(q);
		if (at < 0) return;
		const t = item.text;
		item.label.replaceChildren(
			document.createTextNode(t.slice(0, at)),
			Object.assign(document.createElement('mark'), { textContent: t.slice(at, at + q.length) }),
			document.createTextNode(t.slice(at + q.length)),
		);
	}

	function apply() {
		const q = (input?.value || '').trim().toLowerCase();
		let count = 0;

		for (const item of index) {
			const hit = (!q || item.title.includes(q)) && (year === 'all' || item.year === year);
			item.el.hidden = !hit;
			if (hit) {
				count++;
				paint(item, q);
			}
		}

		// A year heading with nothing under it reads as a bug, so groups fold too.
		for (const g of groups) {
			g.hidden = !g.querySelector<HTMLElement>('.row:not([hidden])');
		}

		if (shown) shown.textContent = String(count);

		// The message has to name the filter that is actually narrowing things.
		// Telling someone to clear a year filter they never set sends them looking
		// for a control that is already off.
		if (empty) {
			empty.hidden = count > 0;
			empty.textContent =
				year === 'all'
					? 'No sermon titles match that. Try a shorter word.'
					: `No sermon titles from ${year} match that. Try a shorter word, or search across all years.`;
		}
		// A closing line under an empty list reads as a stray sentence.
		if (origin) origin.hidden = count === 0;

	}

	let debounce: number;
	input?.addEventListener('input', () => {
		window.clearTimeout(debounce);
		debounce = window.setTimeout(apply, 90);
	});

	for (const chip of chips) {
		chip.addEventListener('click', () => {
			year = chip.dataset.year || 'all';
			for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
			apply();
		});
	}

	/* ---------- deck ---------- */

	/*
		One <audio> for all 291 rows. Per-row elements would each hold their own
		buffer and network state, and the browser caps concurrent media elements
		well below 291 anyway, so rows past the cap would silently refuse to play.

		preload="none" is deliberate: nothing is fetched until somebody actually
		asks for a sermon. The archive is ~60MB an episode.
	*/

	const deck = document.querySelector<HTMLElement>('[data-deck]');
	const audio = deck?.querySelector<HTMLAudioElement>('[data-audio]');
	const glyphBtn = deck?.querySelector<HTMLButtonElement>('[data-toggle]');
	const seek = deck?.querySelector<HTMLInputElement>('[data-seek]');
	const deckTitle = deck?.querySelector<HTMLElement>('[data-deck-title]');
	const deckWhen = deck?.querySelector<HTMLElement>('[data-deck-when]');
	const atEl = deck?.querySelector<HTMLElement>('[data-at]');
	const durEl = deck?.querySelector<HTMLElement>('[data-dur]');

	/** Mirrors the clock() helper in the frontmatter. Kept in sync by hand; the
	    two run in different scopes and sharing would mean shipping a module for
	    nine lines. */
	function clock(total: number) {
		if (!Number.isFinite(total) || total < 0) return '0:00';
		const s = Math.floor(total);
		const h = Math.floor(s / 3600);
		const m = Math.floor((s % 3600) / 60);
		const r = s % 60;
		const pad = (n: number) => String(n).padStart(2, '0');
		return h ? `${h}:${pad(m)}:${pad(r)}` : `${m}:${pad(r)}`;
	}

	if (deck && audio && glyphBtn && seek) {
		let current: HTMLElement | null = null;
		let scrubbing = false;

		/** The deck is fixed, so the last rows would sit under it. Measured rather
		    than guessed: the bar's height changes with the responsive rules. */
		function reserve() {
			document.body.style.setProperty('--deck-h', `${deck!.offsetHeight}px`);
		}

		function open() {
			if (deck!.hasAttribute('data-open')) return;
			deck!.hidden = false;
			document.body.classList.add('has-deck');
			reserve();
			// Two frames: unhiding and transforming in the same frame gives the
			// browser one style resolution and the slide-up never runs.
			requestAnimationFrame(() => requestAnimationFrame(() => {
				deck!.setAttribute('data-open', '');
				reserve();
			}));
		}

		function mark(state: 'playing' | 'paused') {
			deck!.setAttribute('data-state', state);
			glyphBtn!.setAttribute('aria-label', state === 'playing' ? 'Pause' : 'Play');
		}

		function fail(message: string) {
			deck!.setAttribute('data-error', '');
			if (deckWhen) deckWhen.textContent = message;
			mark('paused');
		}

		function cue(btn: HTMLElement) {
			// Same sermon: the row is a play/pause toggle, not a restart button.
			if (current === btn) {
				if (audio!.paused) audio!.play().catch(() => fail('Could not play. Try Apple Podcasts.'));
				else audio!.pause();
				return;
			}

			current?.closest('.row')?.removeAttribute('data-playing');
			current = btn;
			btn.closest('.row')?.setAttribute('data-playing', '');

			deck!.removeAttribute('data-error');
			if (deckTitle) deckTitle.textContent = btn.dataset.label || '';
			if (deckWhen) deckWhen.textContent = btn.dataset.when || '';
			if (atEl) atEl.textContent = '0:00';
			if (durEl) durEl.textContent = '0:00';
			seek!.value = '0';
			deck!.style.setProperty('--p', '0');

			/*
				A <source> with an explicit type rather than audio.src, because the
				origin serves Content-Type: application/octet-stream on all 291 files
				even though the RSS enclosures declare audio/mpeg. Chrome and WebKit
				both sniff past that and play, but sniffing is not a promise, and the
				people most likely to be on an old browser here are the ones most
				likely to be listening to sermons. Declaring the type means the
				browser never has to guess.

				The cost is that a media error now fires on the <source>, not on the
				<audio>, so the failure listener has to be attached per source.
			*/
			const source = document.createElement('source');
			source.type = 'audio/mpeg';
			source.src = btn.dataset.src || '';
			source.addEventListener('error', () => fail('Could not play. Try Apple Podcasts.'));
			audio!.replaceChildren(source);
			audio!.load();

			open();
			audio!.play().catch(() => fail('Could not play. Try Apple Podcasts.'));

			/*
				sermon_play, fired here rather than in the toggle branch above, so
				it counts sermons STARTED and not pause/resume taps. A visitor who
				pauses to answer the door and resumes is one play, not three.

				Optional-called for the same reason the SiteLayout listener is: an
				extension blocking the tag must not be able to break playback. The
				sermon plays whether or not anyone is counting it.
			*/
			track('sermon_play', {
				medium: 'audio',
				sermon_title: btn.dataset.label || '',
				page_path: window.location.pathname,
			});
		}

		for (const btn of document.querySelectorAll<HTMLElement>('[data-cue]')) {
			btn.addEventListener('click', () => cue(btn));
		}

		glyphBtn.addEventListener('click', () => {
			if (audio.paused) audio.play().catch(() => fail('Could not play. Try Apple Podcasts.'));
			else audio.pause();
		});

		deck.querySelector<HTMLButtonElement>('[data-close]')?.addEventListener('click', () => {
			audio.pause();
			// Dropping the source stops a part-finished download dead: clearing the
			// children and reloading puts the element in NETWORK_EMPTY and aborts
			// the fetch. Never assign src = '' to stop playback — an empty src
			// resolves against the page URL and re-requests the document itself.
			audio.replaceChildren();
			audio.load();
			current?.closest('.row')?.removeAttribute('data-playing');
			current = null;
			deck.removeAttribute('data-open');
			document.body.classList.remove('has-deck');
			const done = () => { deck.hidden = true; };
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) done();
			else deck.addEventListener('transitionend', done, { once: true });
		});

		audio.addEventListener('play', () => mark('playing'));
		audio.addEventListener('pause', () => mark('paused'));
		audio.addEventListener('ended', () => mark('paused'));
		// Kept alongside the per-<source> listener above: which of the two fires
		// is engine-dependent, and a silent failure here looks identical to a
		// sermon that simply has not buffered yet.
		audio.addEventListener('error', () => {
			if (audio.querySelector('source')) fail('Could not play. Try Apple Podcasts.');
		});

		audio.addEventListener('loadedmetadata', () => {
			if (durEl) durEl.textContent = clock(audio.duration);
		});

		audio.addEventListener('timeupdate', () => {
			if (atEl) atEl.textContent = clock(audio.currentTime);
			if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
			const p = audio.currentTime / audio.duration;
			deck.style.setProperty('--p', String(p));
			// Writing .value mid-drag fights the pointer and the thumb stutters.
			if (!scrubbing) seek.value = String(Math.round(p * 1000));
		});

		const scrubTo = () => {
			if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
			const p = Number(seek.value) / 1000;
			deck.style.setProperty('--p', String(p));
			audio.currentTime = p * audio.duration;
			if (atEl) atEl.textContent = clock(audio.currentTime);
		};
		seek.addEventListener('pointerdown', () => { scrubbing = true; });
		seek.addEventListener('input', scrubTo);
		seek.addEventListener('change', () => { scrubTo(); scrubbing = false; });
		// Keyboard arrows fire input/change with no pointer events at all.
		seek.addEventListener('keydown', () => { scrubbing = true; });
		seek.addEventListener('keyup', () => { scrubbing = false; });

		window.addEventListener('resize', () => { if (!deck.hidden) reserve(); });
	}

	/* ---------- live stream ---------- */

	/*
		The channel's auto-generated uploads playlist, NOT embed/live_stream.
		This is not a preference, live_stream is dead: it renders YouTube's grey
		"This video is unavailable" panel even when the channel IS live. Verified
		by rendering both in Chromium from a real http origin, with a control
		channel proven live at that moment failing identically. YouTube stopped
		supporting permanent live embeds for external sites in 2023.

		The uploads playlist is the replacement and needs no live detection at
		all: YouTube puts the broadcast at position 1 the moment it starts, and
		leaves the newest upload there the rest of the week. One static URL,
		correct in both states.

		Two things that will break this if changed:
		 - Do NOT set referrerpolicy="no-referrer" here, or Referrer-Policy:
		   no-referrer on the page. An embed with no Referer is rejected as
		   EMBEDDER_IDENTITY_MISSING_REFERRER and renders "Error 153".
		 - The playlist id is the channel id with UC swapped for UU. Deriving it
		   keeps the two from drifting apart.
	*/
	const CHANNEL = 'UCFVvTNQHSyICAekmJdQ47Eg';
	const UPLOADS = `UU${CHANNEL.slice(2)}`;

	const screen = document.querySelector<HTMLButtonElement>('[data-play]');

	/*
		What the button will actually play.

		The uploads playlist stays as the FALLBACK, not the default, and the
		distinction matters. Playlist position 1 is the newest upload, and the
		channel posts cut sermons as well as full services — measured 2026-08-26,
		position 1 was "How To Process The Pain", a 47 minute sermon, while the
		card said "Watch the service" and the most recent service was the
		August 23 broadcast. So the playlist alone made the card play something
		other than what it named, most weeks.

		With a poster naming a specific service, the click has to follow it. The
		playlist is still exactly right whenever we do NOT know better, because it
		is correct in both states, so it is what an unknown id or a failed
		/api/live falls back to.
	*/
	const playlistUrl = `https://www.youtube-nocookie.com/embed/videoseries?list=${UPLOADS}&autoplay=1`;
	const videoUrl = (id: string) => `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;

	let target = screen?.dataset.video ? videoUrl(screen.dataset.video) : playlistUrl;

	screen?.addEventListener('click', (ev) => {
		const btn = ev.currentTarget as HTMLButtonElement;

		/*
			The same key event as the audio rows, separated by `medium` rather
			than given a second name. Both answer one question — did anyone
			actually watch or listen to a sermon — and splitting the name would
			mean every report has to remember to add the two together.

			`live` is read off the card's own state, so the number can tell a
			Sunday-morning stream apart from someone catching up on Tuesday.
		*/
		track('sermon_play', {
			medium: 'video',
			/*
				The video id, not only the cue text. The cue starts as the generic
				"Watch the service" and is rewritten to the specific service by the
				/api/live handler below, so a visitor who clicks before that fetch
				resolves would otherwise be recorded against a label that names
				nothing. The id is in the markup at build time and never moves.
			*/
			video_id: btn.dataset.video || 'uploads-playlist',
			sermon_title: btn.querySelector('[data-cue-text]')?.textContent?.trim() || '',
			live: btn.hasAttribute('data-live') ? 'yes' : 'no',
			page_path: window.location.pathname,
		});

		const frame = document.createElement('iframe');
		// nocookie host: no YouTube cookie is set unless the visitor actually plays.
		frame.src = target;
		frame.title = 'Brookside Church of God, live stream and recent services';
		frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; web-share';
		frame.allowFullscreen = true;
		btn.replaceWith(frame);
		frame.focus();
	});

	/*
		Live state, from our own edge. See functions/api/live.js.

		Same-origin on purpose: asking googleapis.com from here would put a
		third-party request on every page load and expose the API key, and the
		whole point of this panel is that nothing leaves for YouTube until a
		visitor clicks. The poster is self-hosted for the same reason, which is
		also why a live broadcast keeps showing the last service's frame: there is
		no way to fetch the live thumbnail without breaking that promise, and a
		LIVE NOW badge over last Sunday's room reads correctly anyway.

		Every failure path here is silent and leaves the card in its offline
		state. `npm run dev` serves the Astro dev server, which does not run Pages
		Functions at all, so /api/live 404s locally and this must be a non-event.
	*/
	const stateEl = screen?.querySelector<HTMLElement>('[data-state]');
	const cueEl = screen?.querySelector<HTMLElement>('[data-cue-text]');
	const noteEl = screen?.querySelector<HTMLElement>('[data-note]');

	// The offline copy, captured before anything overwrites it, so going off air
	// while somebody has the tab open restores exactly what was rendered rather
	// than a second copy of the same strings maintained by hand.
	const offline = {
		state: stateEl?.textContent ?? '',
		cue: cueEl?.textContent ?? '',
		note: noteEl?.textContent ?? '',
		label: screen?.getAttribute('aria-label') ?? '',
	};

	function paintLive(on: boolean, videoId?: string) {
		if (!screen || !stateEl || !cueEl || !noteEl) return;

		if (!on) {
			if (!screen.hasAttribute('data-live')) return;
			screen.removeAttribute('data-live');
			stateEl.textContent = offline.state;
			cueEl.textContent = offline.cue;
			noteEl.textContent = offline.note;
			screen.setAttribute('aria-label', offline.label);
			target = screen.dataset.video ? videoUrl(screen.dataset.video) : playlistUrl;
			return;
		}

		screen.setAttribute('data-live', '');
		// Rebuilt rather than set with innerHTML: the dot is an element, and this
		// text comes from an API response.
		stateEl.replaceChildren(
			Object.assign(document.createElement('span'), { className: 'screen__dot' }),
			document.createTextNode('Live now'),
		);
		stateEl.querySelector('.screen__dot')?.setAttribute('aria-hidden', 'true');
		cueEl.textContent = 'Watch live';
		noteEl.textContent = 'The service is on the air right now.';
		screen.setAttribute('aria-label', 'Watch the service, live now');
		// An id from the API is better than the playlist, but the playlist is
		// still correct while live, so a response without one is not a problem.
		target = videoId ? videoUrl(videoId) : playlistUrl;
	}

	async function checkLive() {
		try {
			const res = await fetch('/api/live', { headers: { accept: 'application/json' } });
			if (!res.ok) return;
			const data = await res.json();
			paintLive(Boolean(data?.live), data?.videoId);
		} catch {
			// Offline, blocked, or no Function behind this path. Card stays as built.
		}
	}

	if (screen) {
		checkLive();
		/*
			Polling exists for one specific person: somebody who opens /watch at
			10:40 on a Sunday and waits. Without it they would sit on a card that
			says "most recent service" while the service starts behind it.

			Sixty seconds against a response the edge caches for five minutes, so
			nearly every one of these is served from cache and costs no quota.
			Gated on visibility so a forgotten tab is not polling all week, and
			capped at an hour, which outlasts the gap between someone arriving
			early and the stream starting.
		*/
		let polls = 0;
		setInterval(() => {
			if (document.visibilityState !== 'visible') return;
			if (++polls > 60) return;
			checkLive();
		}, 60_000);
	}

	/* Motion (reveals, ribbons, the pause toggle) is Motion.astro's job now; this
	   script owns playback, search and the live card only. */
</script>
