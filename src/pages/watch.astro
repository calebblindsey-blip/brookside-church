---
/**
 * Watch: the archive's page.
 *
 * The generic version of this page is a black video hero, a card grid of
 * "recent sermons", and a search box with a magnifying glass. The material that
 * is actually specific to Brookside is the archive itself: 291 sermons running
 * back to March 2020. So the archive IS the page, and the structural device is
 * the year, which is real information rather than decoration.
 *
 * Two content rules, both learned the hard way and both load-bearing:
 *   - The archive is NOT unbroken. 291 sermons across 332 weeks with nine gaps
 *     over three weeks (longest 62 days, spring 2020). Never write "every
 *     Sunday" or "every week without a gap" anywhere on this page.
 *   - The third column is the RUNTIME, not a season/episode tag. The old
 *     Squarespace feed carried S/E numbers and the migration dropped them; the
 *     numbering was incoherent anyway (S2 was 2022, S3 was 2020) and Anchor
 *     emits none, so every future episode would have rendered blank at the top
 *     of the list. Do not reintroduce them from the old snapshot.
 *
 * Rows play. One <audio> for the whole page, driven from a deck pinned to the
 * bottom of the viewport, rather than a player per row: 291 media elements is
 * both a memory problem and a page that reads as a control panel instead of an
 * archive. The row is a cue, the deck is the instrument.
 *
 * No crossAt: the line runs as a plain spine here. The crossbar is Home's
 * payoff and repeating it on every page spends it.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import data from '../data/sermons.json';

const APPLE = 'https://podcasts.apple.com/us/podcast/id1094539094';
const SPOTIFY = 'https://open.spotify.com/show/6KxGfsUUCpUN6xyVMPEy76';
const YOUTUBE = 'https://www.youtube.com/channel/UCFVvTNQHSyICAekmJdQ47Eg';

const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const longDate = (iso: string) => {
	const [y, m, d] = iso.split('-');
	return `${months[Number(m) - 1]} ${Number(d)}, ${y}`;
};
const rowDate = (iso: string) => {
	const [, m, d] = iso.split('-');
	return `${months[Number(m) - 1].slice(0, 3)} ${String(Number(d)).padStart(2, '0')}`;
};
const monthYear = (iso: string) => {
	const [y, m] = iso.split('-');
	return `${months[Number(m) - 1]} ${y}`;
};

type Episode = (typeof data.episodes)[number];

const episodes: Episode[] = data.episodes;
const latest = episodes[0];
const firstEver = episodes[episodes.length - 1];

/** Clock time, not prose: the column is scanned down, so it has to stay narrow
    and tabular. One sermon runs 1:17, so the hour slot cannot be assumed away. */
const clock = (s: number) => {
	const h = Math.floor(s / 3600);
	const m = Math.floor((s % 3600) / 60);
	const sec = s % 60;
	return h
		? `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`
		: `${m}:${String(sec).padStart(2, '0')}`;
};

/** Spoken form for the button's accessible name. "44:12" is read as a time of
    day by most screen readers, which is not what a runtime means. */
const spoken = (s: number) => {
	const h = Math.floor(s / 3600);
	const m = Math.round((s % 3600) / 60);
	const hp = h ? `${h} hour${h === 1 ? '' : 's'} ` : '';
	return `${hp}${m} minute${m === 1 ? '' : 's'}`;
};

// Grouped in a single pass rather than by filtering per year: the feed is
// already sorted newest-first, so a year change is just a boundary.
const years: { year: string; items: Episode[] }[] = [];
for (const ep of episodes) {
	const y = ep.date.slice(0, 4);
	const open = years[years.length - 1];
	if (open && open.year === y) open.items.push(ep);
	else years.push({ year: y, items: [ep] });
}

// Spelled out rather than set as a numeral: at display size "6 years" reads as
// a stat, and the eyebrow already carries the counts. Recomputed from the feed
// so it stays true as the archive grows.
const WORDS = ['zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve'];
const span = Number(data.newest.slice(0, 4)) - Number(data.oldest.slice(0, 4));
const spanWord = WORDS[span] ?? String(span);
---

<SiteLayout
	title="Watch"
	description={`All ${data.total} sermons Brookside Church of God has recorded since ${monthYear(data.oldest)}, plus the Sunday livestream. Worship streams live at 10:45 AM.`}
>
	<section class="bay wtop">
		<p class="eyebrow">{data.total} sermons · {monthYear(data.oldest)} to {monthYear(data.newest)}</p>
		<h1 class="display" data-split>
			{spanWord} years<br />of preaching,<br />one <em>subject</em>
		</h1>
		<div class="wtop__foot">
			<p class="lede">
				Sunday worship streams live at 10:45 AM. Everything before it is here,
				back to the first recording in March 2020. Search the archive, then
				listen wherever you already listen.
			</p>
			<dl class="hours">
				<div><dt>Sunday School</dt><dd>9:45 AM</dd></div>
				<div><dt>Morning Worship</dt><dd>10:45 AM</dd></div>
				<div><dt>Wednesday Classes</dt><dd>6:30 PM</dd></div>
			</dl>
		</div>
	</section>

	<section class="bay rule feature" aria-labelledby="latest-heading">
		<div class="feature__lead">
			<p class="eyebrow" id="latest-heading">Most recent</p>
			<h2 class="headline">{latest.title}</h2>
			{/*
				The speaker comes from the feed, never hardcoded. About one Sunday
				in five is a guest (51 of the 247 episodes that name anyone), so a
				fixed "Brad Lindsey" here credits the pastor for other people's
				preaching regularly. When the feed names nobody the line is dropped
				rather than filled in with an assumption.
			*/}
			<p class="feature__meta">
				{latest.speaker && (
					<>
						<span>{latest.speaker}</span>
						<span aria-hidden="true">·</span>
					</>
				)}
				<span>{longDate(latest.date)}</span>
				<span aria-hidden="true">·</span>
				<span class="feature__tag">{clock(latest.seconds)}</span>
			</p>
			{/*
				Play is the primary action now that the archive is playable, so it
				takes the solid button the platform links used to share. Apple and
				Spotify stay, but demoted: the bottom section already exists to hand
				the archive off to a podcast app, and this block's job is to start
				the most recent sermon.
			*/}
			<div class="actions feature__actions">
				<button
					class="btn btn--solid"
					type="button"
					data-cue
					data-src={latest.url}
					data-label={latest.title}
					data-when={longDate(latest.date)}
				>Play this sermon</button>
				<a class="btn btn--line" href={APPLE} target="_blank" rel="noopener">Apple Podcasts</a>
				<a class="btn btn--line" href={SPOTIFY} target="_blank" rel="noopener">Spotify</a>
			</div>
		</div>

		{/*
			Click-to-play rather than a bare iframe: no third-party request and no
			YouTube cookie until a visitor actually asks for one, and the page
			cannot be made to look broken by something outside our control.

			The copy names both states on purpose. The player is the uploads
			playlist, so it is the live broadcast during the service and the most
			recent service afterwards. Promising only "the live stream" would be a
			lie six days a week.

			Note this panel and the sermon on the left are NOT the same thing: the
			left column is the newest podcast episode, the right is the newest
			YouTube upload, and the channel carries full services as well as cut
			sermons, so in a given week they can legitimately name different
			things. Hence "the service" here and "Most recent" sermon there.
		*/}
		<div class="feature__media">
			<button class="screen" type="button" data-play>
				<span class="screen__state"><span class="screen__dot" aria-hidden="true"></span>Live Sundays, 10:45 AM</span>
				<span class="screen__cue">Watch the service</span>
				<span class="screen__note">Live on Sunday morning. The rest of the week, the most recent one.</span>
			</button>
			<a class="link feature__past" href={YOUTUBE} target="_blank" rel="noopener">
				Every service on YouTube &rarr;
			</a>
		</div>
	</section>

	<section class="bay rule archive" aria-labelledby="archive-heading">
		<div class="seek">
			<p class="eyebrow" id="archive-heading">The archive</p>
			<div class="seek__body">
				<label class="seek__field">
					<span class="seek__label">Search sermons</span>
					<input
						type="search"
						id="seek"
						placeholder="Search by title"
						autocomplete="off"
						spellcheck="false"
					/>
				</label>
				<p class="seek__count" role="status" aria-live="polite" data-count>
					<span data-shown>{data.total}</span> of {data.total}
				</p>
				<div class="seek__years" role="group" aria-label="Filter by year">
					<button type="button" class="chip" data-year="all" aria-pressed="true">All</button>
					{years.map((g) => (
						<button type="button" class="chip" data-year={g.year} aria-pressed="false">{g.year}</button>
					))}
				</div>
			</div>
		</div>

		<div class="roll" data-roll>
			{years.map((g) => (
				<section class="stack" data-group={g.year} aria-labelledby={`y-${g.year}`}>
					<div class="stack__mark">
						<h3 class="stack__year" id={`y-${g.year}`}>{g.year}</h3>
						<p class="stack__count">{g.items.length} sermons</p>
					</div>
					{/*
						The button is inside the li rather than the li being the control:
						an <ol> whose children are buttons loses the list semantics that
						make "291 sermons" navigable, and the filter reads .row.
					*/}
					<ol class="stack__list">
						{g.items.map((e) => (
							<li class="row" data-title={e.title.toLowerCase()} data-year={g.year}>
								<button
									class="row__hit"
									type="button"
									data-cue
									data-src={e.url}
									data-label={e.title}
									data-when={longDate(e.date)}
									aria-label={`Play “${e.title}”, ${longDate(e.date)}, ${spoken(e.seconds)}`}
								>
									<span class="row__date">{rowDate(e.date)}</span>
									<span class="row__title">{e.title}</span>
									<span class="row__time">{clock(e.seconds)}</span>
								</button>
							</li>
						))}
					</ol>
				</section>
			))}
			<p class="roll__empty" data-empty hidden></p>
		</div>

		<p class="roll__origin">
			The archive begins with <em>{longDate(firstEver.date)}</em>, “{firstEver.title}”.
		</p>
	</section>

	<section class="bay rule subscribe" aria-labelledby="subscribe-heading">
		<p class="eyebrow" id="subscribe-heading">Take it with you</p>
		<div class="subscribe__grid">
			{/*
				Both notes stick to things that have actually been checked against
				the feed. "Where most people listen" and a per-platform episode
				count were both in here and both were guesses. There is no listener
				breakdown, and the Spotify show's own count has never been verified.
			*/}
			<a class="port" href={APPLE} target="_blank" rel="noopener">
				<span class="port__name">Apple Podcasts</span>
				<span class="port__note">The full archive, back to 2020.</span>
			</a>
			<a class="port" href={SPOTIFY} target="_blank" rel="noopener">
				<span class="port__name">Spotify</span>
				<span class="port__note">The same archive, without leaving the app.</span>
			</a>
			<a class="port" href={YOUTUBE} target="_blank" rel="noopener">
				<span class="port__name">YouTube</span>
				<span class="port__note">Where the Sunday service streams live.</span>
			</a>
		</div>
	</section>

	{/*
		The deck. Rendered inert and empty; JS fills it on the first play and it
		is removed from the a11y tree until then, so nothing here is announced or
		tab-reachable on a page nobody has asked to play anything on.

		aria-live on the now-playing line rather than role="status" on the whole
		deck: the scrub position updates four times a second and a live region
		around it would narrate the timecode forever.
	*/}
	<div class="deck" data-deck hidden>
		<div class="deck__in">
			<button class="deck__toggle" type="button" data-toggle aria-label="Pause">
				<span class="deck__glyph" data-glyph aria-hidden="true"></span>
			</button>

			<div class="deck__body">
				<p class="deck__now" aria-live="polite">
					<span class="deck__title" data-deck-title></span>
					<span class="deck__when" data-deck-when></span>
				</p>
				<label class="deck__scrub">
					<span class="deck__scrub-label">Seek</span>
					<input type="range" data-seek min="0" max="1000" value="0" step="1" />
				</label>
			</div>

			<p class="deck__time">
				<span data-at>0:00</span><span class="deck__slash" aria-hidden="true">/</span><span data-dur>0:00</span>
			</p>

			<button class="deck__close" type="button" data-close aria-label="Close player">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" fill="none" />
				</svg>
			</button>
		</div>
		<audio data-audio preload="none"></audio>
	</div>
</SiteLayout>

<style is:global>
	/* Page-level composition only. Anything reusable belongs in site.css. */

	/* Clears the sticky header before a year mark pins under it. */
	:root { --chrome-h: 4.25rem; }

	.wtop { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4rem); }
	.wtop__foot {
		display: flex; flex-wrap: wrap; gap: clamp(1.75rem, 5vw, 4.5rem);
		align-items: start; margin-top: clamp(2rem, 4vw, 3rem);
	}
	.wtop__foot .lede { flex: 1 1 24rem; }
	.wtop__foot .hours { margin-left: auto; flex: 0 1 auto; min-width: 15rem; }

	.feature {
		padding-block: clamp(2.5rem, 6vw, 4rem);
		display: grid; gap: clamp(1.75rem, 4vw, 3.5rem);
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		align-items: center;
	}
	.feature__meta {
		display: flex; flex-wrap: wrap; gap: 0.5rem;
		margin: 1rem 0 1.75rem; color: var(--iron); font-size: 0.95rem;
	}
	.feature__tag {
		font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em;
		align-self: center;
	}

	/*
		The one dark surface on the site, and the only place a screen belongs.
		Kept flat (no gradient, no drop shadow, no play-triangle badge) so it
		reads as the room's projector rather than as a media player chrome.
	*/
	.feature__media { width: 100%; }
	.screen {
		display: flex; flex-direction: column; align-items: flex-start;
		justify-content: flex-end; gap: 0.3rem;
		width: 100%; aspect-ratio: 16 / 9; margin: 0;
		padding: clamp(1.1rem, 2.5vw, 1.9rem);
		background: var(--ink); border: 0; border-radius: 0;
		color: var(--paper); text-align: left; cursor: pointer;
		transition: background 0.2s;
	}
	.screen:hover { background: #000; }
	.screen__state {
		display: flex; align-items: center; gap: 0.5rem; margin-bottom: auto;
		font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em;
		text-transform: uppercase; color: var(--ash);
	}
	.screen__dot {
		width: 7px; height: 7px; border-radius: 50%; background: var(--coral);
		flex: none;
	}
	.screen__cue {
		font-family: var(--display); font-variation-settings: 'wght' 700, 'opsz' 24;
		font-size: clamp(1.25rem, 2.6vw, 1.85rem); letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.screen:hover .screen__cue { color: var(--coral); }
	.screen__note { font-size: 0.85rem; color: var(--ash); }
	.feature__past { display: inline-block; margin-top: 0.9rem; font-size: 0.92rem; }
	/* Replaced in place by the iframe, so the frame keeps its exact geometry and
	   the page does not jump when the video loads. */
	.feature__media iframe {
		display: block; width: 100%; aspect-ratio: 16 / 9; border: 0;
	}

	/* ---------- archive ---------- */

	.archive { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3rem, 7vw, 5rem); }

	/*
		Search sits on the same two-column grid as the year stacks, so the rule
		under the input ends exactly where the sermon rows end. Left to span the
		full bay it overshoots the list by ~500px and the two read as unrelated
		blocks rather than one instrument and the thing it operates on.
	*/
	.seek {
		display: grid; grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
	}
	.seek .eyebrow { margin-bottom: 0; }
	.seek__body { max-width: 44rem; }
	.seek__field { display: block; }
	.seek__label {
		position: absolute; width: 1px; height: 1px;
		overflow: hidden; clip-path: inset(50%); white-space: nowrap;
	}
	/* The input is a rule with type on it, not a boxed control: the page is
	   built out of horizontals and a pill-shaped field would be the one piece
	   of furniture that came from somewhere else. */
	.seek input {
		width: 100%; margin: 0; padding: 0.55rem 0 0.7rem;
		background: none; border: 0; border-bottom: 2px solid var(--ink);
		border-radius: 0; color: var(--ink);
		font-family: var(--display); font-variation-settings: 'wght' 500, 'opsz' 24;
		font-size: clamp(1.3rem, 3.2vw, 2rem); letter-spacing: -0.025em;
		-webkit-appearance: none; appearance: none;
	}
	.seek input::placeholder { color: var(--ash); }
	/*
		Pointer focus gets the coral rule; keyboard focus additionally keeps the
		site's real focus ring. Suppressing the outline here left the input with a
		colour change as its only focus cue, which is no cue at all for anyone who
		cannot separate the ink and the coral.
	*/
	.seek input:focus { border-bottom-color: var(--coral); }
	.seek input:focus:not(:focus-visible) { outline: none; }
	.seek input::-webkit-search-cancel-button { -webkit-appearance: none; }

	.seek__count {
		margin: 0.75rem 0 0; font-family: var(--mono);
		font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
		color: var(--iron); font-variant-numeric: tabular-nums;
	}
	.seek__count [data-shown] { color: var(--coral); }

	.seek__years { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.25rem; }
	.chip {
		padding: 0.4rem 0.85rem; border: 1px solid var(--ash); border-radius: 999px;
		background: none; color: var(--iron); cursor: pointer;
		font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em;
		font-variant-numeric: tabular-nums;
		transition: border-color 0.18s, color 0.18s, background 0.18s;
	}
	.chip:hover { border-color: var(--ink); color: var(--ink); }
	.chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

	/*
		The year is the page's signature: scrolling the archive counts backwards
		through the church's own history and the mark rides along beside it. It is
		the one place on this page that gets display type at size.
	*/
	.stack {
		display: grid; grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		padding-top: clamp(1.5rem, 3vw, 2.25rem);
	}
	/* A class setting `display` outranks the UA's [hidden] rule, so filtering
	   would set the attribute and change nothing. Both need saying explicitly. */
	.stack[hidden] { display: none; }
	.stack__mark { position: sticky; top: calc(var(--chrome-h) + 0.75rem); align-self: start; }
	.stack__year {
		margin: 0; font-family: var(--display);
		font-size: clamp(2.1rem, 5vw, 3.4rem);
		font-variation-settings: 'wght' 800, 'opsz' 36;
		line-height: 0.9; letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
	}
	.stack__count {
		margin: 0.5rem 0 0; font-family: var(--mono); font-size: 0.68rem;
		letter-spacing: 0.12em; text-transform: uppercase; color: var(--iron);
	}

	/* Held to a reading column. Run full-bleed and 291 short titles float in a
	   field of white with the tag stranded at the far edge, which is the
	   broadsheet look rather than a decision. */
	.stack__list {
		margin: 0; padding: 0; list-style: none; max-width: 44rem;
		border-top: 1px solid var(--ash);
	}
	.row { position: relative; border-bottom: 1px solid var(--ash); }
	.row[hidden] { display: none; }

	/*
		The button carries the grid, not the li: the row has to stay a list item
		for "291 sermons" to be navigable, and the whole width has to be the hit
		target because a 0.98rem title is a poor thing to ask anyone to hit.
	*/
	.row__hit {
		display: grid; grid-template-columns: 3.9rem minmax(0, 1fr) auto;
		gap: 1.1rem; align-items: baseline;
		width: 100%; margin: 0; padding: 0.62rem 0;
		background: none; border: 0; border-radius: 0;
		color: inherit; font: inherit; text-align: left; cursor: pointer;
	}
	.row__hit:hover .row__title { color: var(--coral); }
	/* Inset so the ring follows the text block rather than the full bleed row. */
	.row__hit:focus-visible { outline-offset: -2px; }

	/*
		Playing marker. A coral rule standing in the margin, which is the same
		device as the page's spine rather than a new one: nothing about the row
		itself moves, so the list does not reflow when playback moves down it.
	*/
	.row[data-playing]::before {
		content: ''; position: absolute; top: 0; bottom: 0; left: -0.75rem;
		width: 3px; background: var(--coral);
	}
	.row[data-playing] .row__title { color: var(--coral); }

	.row__date {
		font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em;
		text-transform: uppercase; color: var(--iron); font-variant-numeric: tabular-nums;
	}
	.row__title { font-size: 0.98rem; line-height: 1.35; text-wrap: pretty; transition: color 0.18s; }
	/* --ash on --paper is barely a mark on the page; this stays quieter than the
	   title without dropping out of legibility. */
	.row__time {
		font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.06em;
		color: color-mix(in srgb, var(--iron) 58%, var(--paper));
		font-variant-numeric: tabular-nums;
	}
	.row mark { background: none; color: var(--coral); font-weight: 600; }

	.roll__empty {
		margin: 2.5rem 0 0;
		margin-left: calc(7.5rem + clamp(1rem, 3vw, 2.5rem));
		max-width: 34ch;
		font-family: var(--display); font-size: clamp(1.15rem, 2.4vw, 1.6rem);
		font-variation-settings: 'wght' 500, 'opsz' 24;
		line-height: 1.3; letter-spacing: -0.025em;
	}
	/* Indented into the list's own column so the rule that closes the archive
	   starts and ends where the sermon rows do. */
	.roll__origin {
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		margin-left: calc(7.5rem + clamp(1rem, 3vw, 2.5rem));
		padding-top: 1.25rem;
		border-top: 2px solid var(--ink); max-width: 44rem;
		font-size: 0.95rem; line-height: 1.6; color: var(--iron);
	}

	/* ---------- subscribe ---------- */

	.subscribe { padding-block: clamp(2.5rem, 5vw, 3.5rem) clamp(3rem, 6vw, 4.5rem); }
	.subscribe__grid {
		display: grid; gap: 0;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		border-top: 1px solid var(--ash);
	}
	.port {
		display: block; padding: 1.35rem 1.35rem 1.5rem 0;
		border-bottom: 1px solid var(--ash);
		transition: color 0.18s;
	}
	.port__name {
		display: block; font-family: var(--display); font-size: 1.3rem;
		font-variation-settings: 'wght' 700; letter-spacing: -0.025em;
	}
	.port__note {
		display: block; margin-top: 0.4rem; max-width: 26ch;
		font-size: 0.9rem; line-height: 1.5; color: var(--iron);
	}
	.port:hover .port__name { color: var(--coral); }

	/* ---------- deck ---------- */

	/*
		The one piece of furniture on the site that floats. It earns it by being
		the only thing that has to outlive scrolling: the point of a shared player
		is that you can keep reading the archive while a sermon runs.

		Ink, like the video screen above it, so the page still has exactly one
		dark surface family. Coral is spent only on the progress line, which keeps
		the accent doing the same job here as everywhere else: it marks a line.
	*/
	.deck {
		position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
		background: var(--ink); color: var(--paper);
		transform: translateY(100%);
		transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.deck[data-open] { transform: none; }
	.deck__in {
		display: flex; align-items: center; gap: clamp(0.75rem, 2vw, 1.4rem);
		padding: 0.85rem var(--flank) 0.85rem var(--edge);
		max-width: calc(var(--edge) + var(--measure));
	}

	.deck__toggle {
		flex: none; display: grid; place-items: center;
		width: 42px; height: 42px; padding: 0;
		background: var(--paper); color: var(--ink);
		border: 0; border-radius: 50%; cursor: pointer;
		transition: background 0.18s;
	}
	.deck__toggle:hover { background: var(--coral); }
	/* Drawn rather than set as a glyph: ▶ and ❚❚ sit on different baselines and
	   optical centres in every font, so the button visibly twitches on toggle. */
	.deck__glyph {
		width: 12px; height: 13px; background: currentColor;
		clip-path: polygon(0 0, 100% 50%, 0 100%);
		margin-left: 2px;
	}
	.deck[data-state='playing'] .deck__glyph {
		clip-path: none; margin-left: 0;
		background: linear-gradient(90deg, currentColor 0 31%, transparent 31% 69%, currentColor 69% 100%);
	}

	.deck__body { flex: 1 1 auto; min-width: 0; }
	.deck__now {
		display: flex; align-items: baseline; gap: 0.6rem;
		margin: 0 0 0.15rem; min-width: 0;
	}
	.deck__title {
		font-family: var(--display); font-variation-settings: 'wght' 600, 'opsz' 24;
		font-size: 1rem; letter-spacing: -0.02em;
		white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
	}
	.deck__when {
		flex: none; font-family: var(--mono); font-size: 0.66rem;
		letter-spacing: 0.06em; color: var(--ash);
	}
	.deck[data-error] .deck__when { color: var(--coral); }

	.deck__scrub { display: block; }
	.deck__scrub-label {
		position: absolute; width: 1px; height: 1px;
		overflow: hidden; clip-path: inset(50%); white-space: nowrap;
	}
	/*
		A rule with a dot on it, matching the search field above: both are the
		same instrument, a horizontal you act on. --p is written by the script as
		a unitless 0 to 1.
	*/
	.deck__scrub input {
		-webkit-appearance: none; appearance: none;
		display: block; width: 100%; height: 14px; margin: 0;
		background: none; cursor: pointer;
	}
	.deck__scrub input::-webkit-slider-runnable-track {
		height: 2px;
		background: linear-gradient(
			to right,
			var(--coral) calc(var(--p, 0) * 100%),
			color-mix(in srgb, var(--paper) 26%, transparent) 0
		);
	}
	.deck__scrub input::-moz-range-track {
		height: 2px;
		background: linear-gradient(
			to right,
			var(--coral) calc(var(--p, 0) * 100%),
			color-mix(in srgb, var(--paper) 26%, transparent) 0
		);
	}
	.deck__scrub input::-webkit-slider-thumb {
		-webkit-appearance: none; appearance: none;
		width: 11px; height: 11px; margin-top: -4.5px;
		border: 0; border-radius: 50%; background: var(--coral);
	}
	.deck__scrub input::-moz-range-thumb {
		width: 11px; height: 11px;
		border: 0; border-radius: 50%; background: var(--coral);
	}
	.deck__scrub input:focus-visible { outline-offset: 2px; }

	.deck__time {
		flex: none; margin: 0; font-family: var(--mono); font-size: 0.7rem;
		letter-spacing: 0.06em; color: var(--ash);
		font-variant-numeric: tabular-nums;
	}
	.deck__slash { padding: 0 0.35rem; opacity: 0.5; }

	.deck__close {
		flex: none; display: grid; place-items: center;
		width: 30px; height: 30px; padding: 0;
		background: none; border: 0; border-radius: 50%;
		color: var(--ash); cursor: pointer; transition: color 0.18s;
	}
	.deck__close:hover { color: var(--paper); }

	/* Keeps the last sermon in the archive clear of the deck once it opens.
	   The block is already is:global, so no :global() wrapper. */
	body.has-deck { padding-bottom: var(--deck-h, 4.5rem); }

	/* ---------- responsive ---------- */

	@media (max-width: 980px) {
		.feature { grid-template-columns: 1fr; }
	}

	@media (max-width: 720px) {
		.wtop__foot .hours { width: 100%; margin-left: 0; }
		.seek { grid-template-columns: 1fr; gap: 0.9rem; }
		.stack { grid-template-columns: 1fr; gap: 0.9rem; }
		/* The mark becomes a bar the rows slide under, which keeps the year
		   readable on a phone without stealing a column from the titles. */
		.stack__mark {
			display: flex; align-items: baseline; gap: 0.7rem;
			top: var(--chrome-h);
			padding: 0.5rem 0 0.4rem;
			background: var(--paper);
			z-index: 2;
		}
		.stack__count { margin: 0; }
		/* The runtime stays on phones. The season tag it replaced was dropped here
		   because it told nobody anything; "44:12" is exactly the thing someone
		   checks before starting a sermon on a commute, so it keeps its column. */
		.row__hit { grid-template-columns: 3.4rem minmax(0, 1fr) auto; gap: 0.8rem; }
		.roll__origin { margin-left: 0; }
		.roll__empty { margin-left: 0; }

		/* Two rows would eat a third of a phone screen, so the timecode drops to
		   elapsed-only and the close control goes: swipe-free dismissal is the
		   pause button, which is already the biggest target here. */
		.deck__in { gap: 0.7rem; padding-block: 0.7rem; }
		.deck__slash, .deck__time [data-dur] { display: none; }
		.deck__when { display: none; }

		/*
			The marker goes. At this width the list sits ~12px off the spine, so a
			coral rule in that margin lands beside the coral spine and the two read
			as one stuttering line rather than as a spine and a marker. The coral
			title carries it instead, and the deck names the same sermon a thumb's
			width below, so nothing is ambiguous.
		*/
		.row[data-playing]::before { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.deck { transition: none; }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import SplitText from 'gsap/SplitText';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	/* ---------- archive filter ---------- */

	const input = document.querySelector<HTMLInputElement>('#seek');
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
	const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));
	const shown = document.querySelector<HTMLElement>('[data-shown]');
	const empty = document.querySelector<HTMLElement>('[data-empty]');
	const origin = document.querySelector<HTMLElement>('.roll__origin');

	// Cached once: reading dataset for 291 rows on every keystroke is the
	// difference between instant and laggy on a phone.
	const index = rows.map((el) => ({
		el,
		title: el.dataset.title || '',
		year: el.dataset.year || '',
		label: el.querySelector<HTMLElement>('.row__title'),
		text: el.querySelector<HTMLElement>('.row__title')?.textContent || '',
	}));

	let year = 'all';

	/** Marks the matched run inside the title so the hit is visible, not just implied. */
	function paint(item: (typeof index)[number], q: string) {
		if (!item.label) return;
		if (!q) {
			if (item.label.firstElementChild) item.label.textContent = item.text;
			return;
		}
		const at = item.title.indexOf(q);
		if (at < 0) return;
		const t = item.text;
		item.label.replaceChildren(
			document.createTextNode(t.slice(0, at)),
			Object.assign(document.createElement('mark'), { textContent: t.slice(at, at + q.length) }),
			document.createTextNode(t.slice(at + q.length)),
		);
	}

	function apply() {
		const q = (input?.value || '').trim().toLowerCase();
		let count = 0;

		for (const item of index) {
			const hit = (!q || item.title.includes(q)) && (year === 'all' || item.year === year);
			item.el.hidden = !hit;
			if (hit) {
				count++;
				paint(item, q);
			}
		}

		// A year heading with nothing under it reads as a bug, so groups fold too.
		for (const g of groups) {
			g.hidden = !g.querySelector<HTMLElement>('.row:not([hidden])');
		}

		if (shown) shown.textContent = String(count);

		// The message has to name the filter that is actually narrowing things.
		// Telling someone to clear a year filter they never set sends them looking
		// for a control that is already off.
		if (empty) {
			empty.hidden = count > 0;
			empty.textContent =
				year === 'all'
					? 'No sermon titles match that. Try a shorter word.'
					: `No sermon titles from ${year} match that. Try a shorter word, or search across all years.`;
		}
		// A closing line under an empty list reads as a stray sentence.
		if (origin) origin.hidden = count === 0;

		// Row heights changed, so every trigger below the archive is now measuring
		// against a stale document height.
		ScrollTrigger.refresh();
	}

	let debounce: number;
	input?.addEventListener('input', () => {
		window.clearTimeout(debounce);
		debounce = window.setTimeout(apply, 90);
	});

	for (const chip of chips) {
		chip.addEventListener('click', () => {
			year = chip.dataset.year || 'all';
			for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
			apply();
		});
	}

	/* ---------- deck ---------- */

	/*
		One <audio> for all 291 rows. Per-row elements would each hold their own
		buffer and network state, and the browser caps concurrent media elements
		well below 291 anyway, so rows past the cap would silently refuse to play.

		preload="none" is deliberate: nothing is fetched until somebody actually
		asks for a sermon. The archive is ~60MB an episode.
	*/

	const deck = document.querySelector<HTMLElement>('[data-deck]');
	const audio = deck?.querySelector<HTMLAudioElement>('[data-audio]');
	const glyphBtn = deck?.querySelector<HTMLButtonElement>('[data-toggle]');
	const seek = deck?.querySelector<HTMLInputElement>('[data-seek]');
	const deckTitle = deck?.querySelector<HTMLElement>('[data-deck-title]');
	const deckWhen = deck?.querySelector<HTMLElement>('[data-deck-when]');
	const atEl = deck?.querySelector<HTMLElement>('[data-at]');
	const durEl = deck?.querySelector<HTMLElement>('[data-dur]');

	/** Mirrors the clock() helper in the frontmatter. Kept in sync by hand; the
	    two run in different scopes and sharing would mean shipping a module for
	    nine lines. */
	function clock(total: number) {
		if (!Number.isFinite(total) || total < 0) return '0:00';
		const s = Math.floor(total);
		const h = Math.floor(s / 3600);
		const m = Math.floor((s % 3600) / 60);
		const r = s % 60;
		const pad = (n: number) => String(n).padStart(2, '0');
		return h ? `${h}:${pad(m)}:${pad(r)}` : `${m}:${pad(r)}`;
	}

	if (deck && audio && glyphBtn && seek) {
		let current: HTMLElement | null = null;
		let scrubbing = false;

		/** The deck is fixed, so the last rows would sit under it. Measured rather
		    than guessed: the bar's height changes with the responsive rules. */
		function reserve() {
			document.body.style.setProperty('--deck-h', `${deck!.offsetHeight}px`);
		}

		function open() {
			if (deck!.hasAttribute('data-open')) return;
			deck!.hidden = false;
			document.body.classList.add('has-deck');
			reserve();
			// Two frames: unhiding and transforming in the same frame gives the
			// browser one style resolution and the slide-up never runs.
			requestAnimationFrame(() => requestAnimationFrame(() => {
				deck!.setAttribute('data-open', '');
				reserve();
				ScrollTrigger.refresh();
			}));
		}

		function mark(state: 'playing' | 'paused') {
			deck!.setAttribute('data-state', state);
			glyphBtn!.setAttribute('aria-label', state === 'playing' ? 'Pause' : 'Play');
		}

		function fail(message: string) {
			deck!.setAttribute('data-error', '');
			if (deckWhen) deckWhen.textContent = message;
			mark('paused');
		}

		function cue(btn: HTMLElement) {
			// Same sermon: the row is a play/pause toggle, not a restart button.
			if (current === btn) {
				if (audio!.paused) audio!.play().catch(() => fail('Could not play. Try Apple Podcasts.'));
				else audio!.pause();
				return;
			}

			current?.closest('.row')?.removeAttribute('data-playing');
			current = btn;
			btn.closest('.row')?.setAttribute('data-playing', '');

			deck!.removeAttribute('data-error');
			if (deckTitle) deckTitle.textContent = btn.dataset.label || '';
			if (deckWhen) deckWhen.textContent = btn.dataset.when || '';
			if (atEl) atEl.textContent = '0:00';
			if (durEl) durEl.textContent = '0:00';
			seek!.value = '0';
			deck!.style.setProperty('--p', '0');

			/*
				A <source> with an explicit type rather than audio.src, because the
				origin serves Content-Type: application/octet-stream on all 291 files
				even though the RSS enclosures declare audio/mpeg. Chrome and WebKit
				both sniff past that and play, but sniffing is not a promise, and the
				people most likely to be on an old browser here are the ones most
				likely to be listening to sermons. Declaring the type means the
				browser never has to guess.

				The cost is that a media error now fires on the <source>, not on the
				<audio>, so the failure listener has to be attached per source.
			*/
			const source = document.createElement('source');
			source.type = 'audio/mpeg';
			source.src = btn.dataset.src || '';
			source.addEventListener('error', () => fail('Could not play. Try Apple Podcasts.'));
			audio!.replaceChildren(source);
			audio!.load();

			open();
			audio!.play().catch(() => fail('Could not play. Try Apple Podcasts.'));
		}

		for (const btn of document.querySelectorAll<HTMLElement>('[data-cue]')) {
			btn.addEventListener('click', () => cue(btn));
		}

		glyphBtn.addEventListener('click', () => {
			if (audio.paused) audio.play().catch(() => fail('Could not play. Try Apple Podcasts.'));
			else audio.pause();
		});

		deck.querySelector<HTMLButtonElement>('[data-close]')?.addEventListener('click', () => {
			audio.pause();
			// Dropping the source stops a part-finished download dead: clearing the
			// children and reloading puts the element in NETWORK_EMPTY and aborts
			// the fetch. Never assign src = '' to stop playback — an empty src
			// resolves against the page URL and re-requests the document itself.
			audio.replaceChildren();
			audio.load();
			current?.closest('.row')?.removeAttribute('data-playing');
			current = null;
			deck.removeAttribute('data-open');
			document.body.classList.remove('has-deck');
			const done = () => { deck.hidden = true; ScrollTrigger.refresh(); };
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) done();
			else deck.addEventListener('transitionend', done, { once: true });
		});

		audio.addEventListener('play', () => mark('playing'));
		audio.addEventListener('pause', () => mark('paused'));
		audio.addEventListener('ended', () => mark('paused'));
		// Kept alongside the per-<source> listener above: which of the two fires
		// is engine-dependent, and a silent failure here looks identical to a
		// sermon that simply has not buffered yet.
		audio.addEventListener('error', () => {
			if (audio.querySelector('source')) fail('Could not play. Try Apple Podcasts.');
		});

		audio.addEventListener('loadedmetadata', () => {
			if (durEl) durEl.textContent = clock(audio.duration);
		});

		audio.addEventListener('timeupdate', () => {
			if (atEl) atEl.textContent = clock(audio.currentTime);
			if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
			const p = audio.currentTime / audio.duration;
			deck.style.setProperty('--p', String(p));
			// Writing .value mid-drag fights the pointer and the thumb stutters.
			if (!scrubbing) seek.value = String(Math.round(p * 1000));
		});

		const scrubTo = () => {
			if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
			const p = Number(seek.value) / 1000;
			deck.style.setProperty('--p', String(p));
			audio.currentTime = p * audio.duration;
			if (atEl) atEl.textContent = clock(audio.currentTime);
		};
		seek.addEventListener('pointerdown', () => { scrubbing = true; });
		seek.addEventListener('input', scrubTo);
		seek.addEventListener('change', () => { scrubTo(); scrubbing = false; });
		// Keyboard arrows fire input/change with no pointer events at all.
		seek.addEventListener('keydown', () => { scrubbing = true; });
		seek.addEventListener('keyup', () => { scrubbing = false; });

		window.addEventListener('resize', () => { if (!deck.hidden) reserve(); });
	}

	/* ---------- live stream ---------- */

	/*
		The channel's auto-generated uploads playlist, NOT embed/live_stream.
		This is not a preference, live_stream is dead: it renders YouTube's grey
		"This video is unavailable" panel even when the channel IS live. Verified
		by rendering both in Chromium from a real http origin, with a control
		channel proven live at that moment failing identically. YouTube stopped
		supporting permanent live embeds for external sites in 2023.

		The uploads playlist is the replacement and needs no live detection at
		all: YouTube puts the broadcast at position 1 the moment it starts, and
		leaves the newest upload there the rest of the week. One static URL,
		correct in both states.

		Two things that will break this if changed:
		 - Do NOT set referrerpolicy="no-referrer" here, or Referrer-Policy:
		   no-referrer on the page. An embed with no Referer is rejected as
		   EMBEDDER_IDENTITY_MISSING_REFERRER and renders "Error 153".
		 - The playlist id is the channel id with UC swapped for UU. Deriving it
		   keeps the two from drifting apart.
	*/
	const CHANNEL = 'UCFVvTNQHSyICAekmJdQ47Eg';
	const UPLOADS = `UU${CHANNEL.slice(2)}`;

	document.querySelector<HTMLButtonElement>('[data-play]')?.addEventListener('click', (ev) => {
		const btn = ev.currentTarget as HTMLButtonElement;
		const frame = document.createElement('iframe');
		// nocookie host: no YouTube cookie is set unless the visitor actually plays.
		frame.src = `https://www.youtube-nocookie.com/embed/videoseries?list=${UPLOADS}&autoplay=1`;
		frame.title = 'Brookside Church of God, live stream and recent services';
		frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; web-share';
		frame.allowFullscreen = true;
		btn.replaceWith(frame);
		frame.focus();
	});

	/* ---------- motion ---------- */

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const lenis = new Lenis({ duration: 1.05 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((t) => lenis.raf(t * 1000));
		gsap.ticker.lagSmoothing(0);

		const heading = document.querySelector<HTMLElement>('[data-split]');
		if (heading) {
			const split = new SplitText(heading, { type: 'lines', linesClass: 'line', mask: 'lines' });
			gsap.from(split.lines, {
				yPercent: 130, duration: 1.1, ease: 'power4.out', stagger: 0.09, delay: 0.1,
			});
		}

		gsap.from('.wtop .eyebrow, .wtop__foot', {
			opacity: 0, y: 16, duration: 0.75, ease: 'power2.out', stagger: 0.1, delay: 0.4,
		});

		// Reveals start high in the viewport so anything below the fold is already
		// on screen by the time it plays: nothing sits at zero opacity waiting for
		// a trigger that might never fire. Rows are deliberately NOT animated:
		// 291 staggered triggers is both a scroll-jank problem and the kind of
		// scattered motion that makes a page read as machine-made.
		gsap.utils.toArray<HTMLElement>(
			'.feature__lead > *, .feature__media, .seek, .roll__origin, .port, .foot > *',
		).forEach((el) => {
			gsap.from(el, {
				opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
				scrollTrigger: { trigger: el, start: 'top 92%', once: true },
			});
		});
	}
</script>
