---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrookCross from '../components/BrookCross.astro';

const beliefs = [
	{
		title: 'The Bible',
		body: 'The 66 books of the Old and New Testaments are the inspired, inerrant, infallible Word of God — our only rule for faith and practice.',
	},
	{
		title: 'The Trinity',
		body: 'One God eternally existing in three persons — Father, Son, and Holy Spirit.',
	},
	{
		title: 'Jesus Christ',
		body: 'Virgin born and fully God. He lived, died as the atoning sacrifice for the sins of the world, rose bodily from the grave, ascended to the right hand of the Father, and is coming again in bodily form.',
	},
	{
		title: 'The Holy Spirit',
		body: 'Indwells every believer, sanctifies, gifts, and empowers the Church for witness.',
	},
	{
		title: 'The Gospel',
		body: 'Justification by faith in Christ alone — not by works. The good news that opens the door for lives to be changed.',
	},
	{
		title: 'The Church',
		body: 'A priesthood of believers, gathered in spiritual unity to worship, hear the Word, and love one another.',
	},
];

const leaders = [
	{
		name: 'Brad Lindsey',
		role: 'Senior Pastor',
		meta: 'Since 1999',
		bio: 'Brad and his wife Marcie joined Brookside in 1999. Since then they have seen God\'s hand move sovereignly through their lives and the church. Brad has traveled nationally and internationally involved with missions.',
	},
	{
		name: 'Daniel Howard',
		role: 'Teaching Pastor',
		meta: 'Ordained 1999',
		bio: 'Licensed in 1996 and ordained in 1999. A self-proclaimed Bible nerd and treasure hunter who finds joy in studying Scripture and sharing biblical insights with the church.',
	},
	{
		name: 'Caleb Lindsey',
		role: 'Worship & Operations Pastor',
		meta: 'Brookside family',
		bio: 'Leads the church into the presence of God through authentic worship, and oversees day-to-day operations. Uses the talents God has given him to advance the Gospel through worship every Sunday.',
	},
];
---

<BaseLayout
	title="About"
	description="Brookside Church of God — a small church in Brookside, Alabama, gathered every Sunday since 1948 to hear from God's Word and worship Him together."
>
	<!-- ───── Page Hero ───── -->
	<section class="relative overflow-hidden bg-midnight text-paper">
		<!-- Watermark cross right -->
		<div
			class="pointer-events-none absolute top-1/2 -right-16 -translate-y-1/2 opacity-[0.05]"
			aria-hidden="true"
		>
			<BrookCross size={520} color="var(--color-stone-warm)" />
		</div>

		<div class="relative mx-auto max-w-[1200px] px-6 pt-20 pb-24 md:px-14 md:pt-[120px] md:pb-[140px]">
			<div
				class="mb-8 font-body text-[11px] font-medium uppercase text-paper/55"
				style="letter-spacing: 0.28em;"
			>About · Brookside Church of God</div>

			<h1
				class="mb-10 max-w-[1100px] font-display text-5xl font-normal leading-[1.05] tracking-tight text-paper md:text-7xl lg:text-[96px] lg:leading-[1.0]"
				style='letter-spacing: -0.025em; font-variation-settings: "opsz" 144;'
			>
				A small church, planted to last.
			</h1>

			<p
				class="max-w-[720px] font-display text-lg italic font-light leading-[1.5] text-paper/[0.78] md:text-[22px]"
				style='font-variation-settings: "opsz" 14;'
			>
				Seventy-eight years on a single corner in Brookside, Alabama. Three pastors. The same gospel, preached every Sunday.
			</p>
		</div>
	</section>

	<!-- ───── Story ───── -->
	<section class="bg-stone-warm py-24 md:py-[160px]">
		<div class="mx-auto grid max-w-[1200px] gap-14 px-6 md:grid-cols-2 md:gap-20 md:px-14">
			<div>
				<div class="mb-7 flex items-center gap-4">
					<div class="h-px w-8 bg-ink-blue"></div>
					<div
						class="font-body text-[11px] font-medium uppercase text-ink-blue"
						style="letter-spacing: 0.28em;"
					>Our Story</div>
				</div>
				<div
					class="border h-[400px] md:h-[560px]"
					style="background: radial-gradient(ellipse at 35% 35%, #4a5b46 0%, #1f2a26 60%, #12181a 100%); border-color: rgba(28, 38, 48, 0.14);"
				></div>
				<div
					class="mt-5 font-body text-[11px] font-medium uppercase text-ink-blue/40"
					style="letter-spacing: 0.22em;"
				>Brookside, Alabama · Founded 1948</div>
			</div>

			<div class="md:pt-16">
				<div
					class="mb-9 font-display text-3xl font-normal leading-[1.15] text-ink-blue md:text-[44px]"
					style='letter-spacing: -0.02em; font-variation-settings: "opsz" 72;'
				>
					A small church in Brookside — gathered every Sunday since 1948 to hear from God's Word and worship Him together.
				</div>

				<div class="flex max-w-[540px] flex-col gap-[18px] font-body text-base leading-[1.75] text-ink-blue/[0.78]">
					<p>
						Brookside Church of God was planted in the years after the war by a handful of families who wanted a Spirit-led, scripturally faithful congregation in their own town. They met in a borrowed schoolhouse for nearly a decade before building the small white-frame church that still stands today.
					</p>
					<p>
						Three pastors, four building expansions, and seventy-eight years later, the assignment hasn't changed. We preach Christ crucified, we sing what the saints have sung, and we look after one another — in the joys, in the hospital rooms, and at the gravesides — until He comes back.
					</p>
					<p>
						If you are new to Brookside, or new to faith altogether, you are welcome here. Come early. Stay late. We mean it.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ───── Mission Band (quiet, light) ───── -->
	<section
		class="bg-stone-warm pb-24 md:pb-[120px]"
		aria-label="Mission"
	>
		<div class="mx-auto flex max-w-[820px] flex-col items-center gap-10 px-6 text-center md:px-14">
			<div
				class="h-px w-16"
				style="background-color: rgba(28, 38, 48, 0.14);"
			></div>
			<BrookCross size={20} color="var(--color-moss)" />
			<div
				class="mb-2 font-body text-[11px] font-medium uppercase text-ink-blue/55"
				style="letter-spacing: 0.28em;"
			>Our Mission</div>
			<p
				class="font-display text-2xl italic font-light leading-[1.4] text-ink-blue md:text-[30px]"
				style='letter-spacing: -0.015em; font-variation-settings: "opsz" 72;'
			>
				To preach and support the Gospel of Jesus Christ both locally and abroad — opening the door for lives to be changed and transformed through the power of Jesus Christ.
			</p>
		</div>
	</section>

	<!-- ───── Beliefs (Variation A — Manifesto rows on dark) ───── -->
	<section class="bg-midnight py-24 text-paper md:py-[160px]">
		<div class="mx-auto max-w-[1200px] px-6 md:px-14">
			<div class="mb-16 max-w-[720px] md:mb-[72px]">
				<div class="mb-7 flex items-center gap-4">
					<div class="h-px w-8 bg-paper"></div>
					<div
						class="font-body text-[11px] font-medium uppercase text-paper"
						style="letter-spacing: 0.28em;"
					>What We Believe</div>
				</div>
				<div
					class="font-display text-3xl font-normal leading-[1.1] text-paper md:text-5xl"
					style='letter-spacing: -0.025em; font-variation-settings: "opsz" 144;'
				>
					The old, settled doctrines of the Christian faith — held without apology.
				</div>
			</div>

			<div style="border-top: 1px solid rgba(242, 237, 226, 0.10);">
				{beliefs.map((b, i) => (
					<div
						class="grid grid-cols-[40px_1fr] gap-x-6 gap-y-3 py-7 md:grid-cols-[80px_280px_1fr] md:gap-x-14 md:gap-y-0 md:py-10 md:items-baseline"
						style="border-bottom: 1px solid rgba(242, 237, 226, 0.10);"
					>
						<div
							class="font-body text-[11px] font-medium tabular-nums text-moss"
							style="letter-spacing: 0.22em;"
						>{String(i + 1).padStart(2, '0')}</div>
						<div
							class="font-display text-2xl font-normal leading-[1.1] text-paper md:text-[28px]"
							style='letter-spacing: -0.015em; font-variation-settings: "opsz" 36;'
						>{b.title}</div>
						<div class="col-span-2 max-w-[640px] font-body text-base leading-[1.65] text-paper/[0.78] md:col-span-1">
							{b.body}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ───── Leadership (Variation A — Portrait grid) ───── -->
	<section class="bg-stone-warm py-24 md:py-[140px]">
		<div class="mx-auto max-w-[1200px] px-6 md:px-14">
			<div class="mb-16 max-w-[720px] md:mb-[72px]">
				<div class="mb-7 flex items-center gap-4">
					<div class="h-px w-8 bg-ink-blue"></div>
					<div
						class="font-body text-[11px] font-medium uppercase text-ink-blue"
						style="letter-spacing: 0.28em;"
					>Leadership</div>
				</div>
				<div
					class="font-display text-3xl font-normal leading-[1.1] text-ink-blue md:text-[44px]"
					style='letter-spacing: -0.02em; font-variation-settings: "opsz" 72;'
				>
					Pastors, leaders, and the people who hold this place together.
				</div>
			</div>

			<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-3">
				{leaders.map((p) => (
					<div class="flex flex-col gap-5">
						<div
							class="border"
							style="aspect-ratio: 4 / 5; background: radial-gradient(ellipse at 50% 35%, #4a5246 0%, #232a26 70%, #131715 100%); border-color: rgba(28, 38, 48, 0.14);"
						></div>
						<div>
							<div
								class="mb-2.5 font-body text-[10px] font-medium uppercase text-moss"
								style="letter-spacing: 0.28em;"
							>{p.role}</div>
							<div
								class="mb-2 font-display text-2xl font-normal leading-[1.15] text-ink-blue md:text-[26px]"
								style='letter-spacing: -0.015em; font-variation-settings: "opsz" 36;'
							>{p.name}</div>
							<div class="mb-3 font-body text-[13px] leading-[1.55] text-ink-blue/55">
								{p.meta}
							</div>
							<div class="font-body text-[15px] leading-[1.65] text-ink-blue/[0.78]">
								{p.bio}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ───── Closing Scripture Band ───── -->
	<section class="relative overflow-hidden bg-midnight py-24 text-paper md:py-[140px]">
		<div
			class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-[0.04]"
			aria-hidden="true"
		>
			<BrookCross size={420} color="var(--color-paper)" />
		</div>

		<div class="relative mx-auto flex max-w-[900px] flex-col items-center gap-12 px-6 text-center md:px-14">
			<BrookCross size={28} color="var(--color-moss)" />

			<blockquote
				class="font-display text-2xl italic font-light leading-[1.3] text-paper md:text-[40px]"
				style='letter-spacing: -0.02em; font-variation-settings: "opsz" 144;'
			>
				"For I determined not to know any thing among you, save Jesus Christ, and him crucified."
			</blockquote>

			<div
				class="font-body text-[11px] font-medium uppercase text-paper/55"
				style="letter-spacing: 0.28em;"
			>1 Corinthians 2:2</div>

			<div class="h-6"></div>

			<a
				href="/visit"
				class="inline-flex items-center gap-3 border bg-moss px-8 py-[18px] font-body text-[13px] font-medium uppercase leading-none text-midnight no-underline transition-opacity hover:opacity-90"
				style="letter-spacing: 0.18em; border-color: var(--color-moss);"
			>
				Plan Your Visit
			</a>
		</div>
	</section>
</BaseLayout>
