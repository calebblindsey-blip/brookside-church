---
/**
 * About, in Codex's design (Round 3 of the port). Layout follows app/about/page.tsx
 * in brookside-church-website. Two things are folded in from the Astro site:
 *
 *   - The four descriptors carry the Church of God's own wording, including the
 *     five foundational doctrines and "we welcome people from all
 *     denominations", which is the sentence that tells a visitor from another
 *     tradition they can come. Codex's one-line summaries were paraphrases.
 *   - The leaders carry their portraits and full bios. Alt text names who is in
 *     the frame, because several are family photographs. Brad is first because
 *     the array is in seniority order; nothing here counts pastors or asserts a
 *     founding year, both of which were invented on an earlier draft.
 *
 * "Pentecostal" in the intro is load-bearing, not decoration: Brookside is Church
 * of God (Cleveland, Tennessee), and the church names itself that way first.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import Times from '../components/Times.astro';
import { CHURCH } from '../data/church';

const beliefs = [
	{
		term: 'Christian',
		body: 'First and foremost, the Church of God is a determinedly Christian church. It is built upon the person of Jesus Christ, the Son of God, and the doctrines and practices of the church are based upon His teachings.',
	},
	{
		term: 'Protestant',
		body: 'Founded upon the principles of Protestantism, though not a traditional follower of any one leader of the Reformation. We stand firmly for justification by faith, the priesthood of believers, the authority of the Bible, religious freedom, and the separation of church and state.',
	},
	{
		term: 'Foundational',
		body: 'The Church of God subscribes to five foundational Christian doctrines.',
		list: [
			'The inerrancy and infallibility of the Bible.',
			'The virgin birth and complete deity of Christ.',
			'The atoning sacrifice of Christ’s death for the sins of the world.',
			'The literal resurrection of the body.',
			'Christ’s second coming in bodily form to earth.',
		],
	},
	{
		term: 'Evangelical',
		body: 'Evangelical describes those who affirm the primary doctrines revealed in the Scriptures: the inspiration and authority of the Word of God, the Trinity, the deity and virgin birth of Jesus Christ, salvation by faith in the atoning death of Christ, His bodily resurrection and ascension, the ministry of the Holy Spirit, the second coming of Christ, and the spiritual unity of believers.',
	},
];

/** Portraits are 520 x 650, built with Compass branding/brookside-church/photography/staff-portrait.py. */
const staff = [
	{ role: 'Senior Pastor', name: 'Brad Lindsey', photo: '/staff-brad-lindsey.webp', alt: 'Brad Lindsey, Senior Pastor, with his wife Marcie', bio: 'Brad and his wife, Marcie, joined Brookside Church of God in 1999, and have seen God’s hand move sovereignly through their lives and the church in the years since. He has traveled nationally and internationally in missions work. Marcie serves across many areas of the church. Brad and Marcie have two sons, Caleb and Cole.' },
	{ role: 'Teaching Pastor', name: 'Daniel Howard', photo: '/staff-daniel-howard.webp', alt: 'Daniel Howard, Teaching Pastor', bio: 'Daniel was licensed in 1996 and ordained into the ministry in 1999. A self-proclaimed Bible nerd and treasure hunter, his greatest joy is digging into the Word, turning up the gold in it, and handing it to the church. He and his wife, Patti, have one son.' },
	{ role: 'Worship Pastor', name: 'Caleb Lindsey', photo: '/staff-caleb-lindsey.webp', alt: 'Caleb Lindsey, Worship Pastor, with his wife and their two daughters', bio: 'Caleb leads the church into the presence of God through authentic worship, and counts it a privilege to use what God has given him to advance the Gospel from week to week. He and his wife have two daughters.' },
	{ role: 'Youth Pastor', name: 'Cole Lindsey', photo: '/staff-cole-lindsey.webp', alt: 'Cole Lindsey, Youth Pastor, with his wife Aubrey', bio: 'Cole and his wife, Aubrey, serve the students of Brookside Church of God.' },
	{ role: 'Children’s Pastors', name: 'Corey and Megan Jackson', photo: '/staff-corey-megan-jackson.webp', alt: 'Corey and Megan Jackson, Children’s Pastors', bio: 'Corey and Megan Jackson serve the children of Brookside Church of God.' },
];
---

<SiteLayout
	title="About"
	description="Brookside Church of God is a small church on Cardiff Street in Brookside, Alabama. What we believe, who leads, and what happens on a Sunday."
>
	<InteriorHero eyebrow="About · Brookside Church of God">
		<Fragment slot="title">A church built<br />on <em>one person.</em></Fragment>
		<p slot="intro">A small Pentecostal church family on Cardiff Street in Brookside, Alabama, one we would love you to be part of. Come as you are and sit wherever you like.</p>
		<Fragment slot="aside"><p class="eyebrow">We gather</p><Times /></Fragment>
	</InteriorHero>

	<section class="inner-section inner-blue" aria-labelledby="creed-heading">
		<div>
			<p class="eyebrow">What we believe</p>
			<h2 id="creed-heading">Christian. Protestant.<br />Foundational. Evangelical.</h2>
			<p class="lead">Four words the Church of God uses to describe itself. First and foremost, Brookside is built upon Jesus Christ, the Son of God, and our doctrine and practice rest on His teaching and the authority of Scripture.</p>
			<p class="lead">We welcome people from all denominations.</p>
			<a class="text-link" href="/what-we-believe/">Read our declaration of faith <span class="arrow" aria-hidden="true">↗</span></a>
		</div>
		<div class="identity-list">
			{beliefs.map((b, i) => (
				<article>
					<span>{String(i + 1).padStart(2, '0')}</span>
					<h3>{b.term}</h3>
					<p>{b.body}</p>
					{b.list && <ol class="identity-five">{b.list.map((item) => <li>{item}</li>)}</ol>}
				</article>
			))}
		</div>
	</section>

	<section class="inner-section leadership-section" aria-labelledby="team-heading">
		<div>
			<p class="eyebrow">Who leads</p>
			<h2 id="team-heading">The people who preach and lead here.</h2>
			<p class="lead">Brad and Marcie Lindsey have been at Brookside since 1999.</p>
		</div>
		<div class="leader-list">
			{staff.map((p, i) => (
				<article>
					<span>{String(i + 1).padStart(2, '0')}</span>
					<img class="leader-photo" src={p.photo} width="520" height="650" alt={p.alt} loading="lazy" decoding="async" />
					<div>
						<p class="eyebrow">{p.role}</p>
						<h3>{p.name}</h3>
						<p>{p.bio}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="inner-section inner-copper split-section" aria-labelledby="mission-heading">
		<div><p class="eyebrow">Why we are here</p><h2 id="mission-heading">From Brookside to the world.</h2></div>
		<div>
			<p class="lead">To preach and support the Gospel of Jesus Christ both locally and abroad, opening the door for lives to be changed and transformed through the power of Jesus Christ.</p>
			<div class="card-actions">
				<a class="button button-light" href="/visit/">Plan a visit <span class="arrow" aria-hidden="true">↗</span></a>
				<a class="text-link" href="/watch/">Hear it for yourself <span class="arrow" aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>
</SiteLayout>
