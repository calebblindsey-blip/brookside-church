---
import BrookCross from './BrookCross.astro';
const year = new Date().getFullYear();

const explore = [
	{ href: '/about', label: 'About' },
	{ href: '/visit', label: 'Visit' },
	{ href: '/watch', label: 'Watch' },
	{ href: '/give', label: 'Give' },
];
---

<footer class="bg-midnight text-paper">
	<div class="mx-auto max-w-[1200px] px-6 pt-20 pb-12 md:px-14">
		<div
			class="grid gap-14 border-b pb-14 md:grid-cols-[1.5fr_1fr_1fr_1fr]"
			style="border-color: rgba(242, 237, 226, 0.18);"
		>
			<div>
				<a href="/" class="inline-flex items-center gap-3.5 text-paper no-underline">
					<BrookCross size={30} color="currentColor" />
					<span class="flex flex-col items-start gap-1.5">
						<span
							class="font-tight text-[30px] font-medium leading-none"
							style="letter-spacing: -0.02em;"
						>BROOKSIDE</span>
						<span
							class="font-tight text-[7.2px] font-normal uppercase leading-none text-paper/[0.68]"
							style="letter-spacing: 0.34em;"
						>Church of God</span>
					</span>
				</a>
				<p
					class="mt-7 max-w-[360px] font-display text-[17px] leading-[1.5] text-paper/70"
					style='font-variation-settings: "opsz" 14;'
				>
					A small church in Brookside, Alabama — preaching the gospel, living it together.
				</p>
			</div>

			<div>
				<div
					class="mb-5 font-body text-[11px] font-medium uppercase text-paper/55"
					style="letter-spacing: 0.28em;"
				>Gather</div>
				<address class="not-italic font-body text-sm leading-[1.9] text-paper">
					Sunday School · 9:45 AM<br />
					Sunday Worship · 10:45 AM<br />
					Wednesday · 6:30 PM
				</address>
				<div class="mt-4 font-body text-[13px] leading-[1.65] text-paper/55">
					200 Cardiff Street<br />
					Brookside, AL 35036
				</div>
			</div>

			<div>
				<div
					class="mb-5 font-body text-[11px] font-medium uppercase text-paper/55"
					style="letter-spacing: 0.28em;"
				>Explore</div>
				<ul class="space-y-3.5">
					{explore.map((item) => (
						<li>
							<a
								href={item.href}
								class="font-body text-sm leading-none text-paper no-underline hover:text-moss"
							>{item.label}</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<div
					class="mb-5 font-body text-[11px] font-medium uppercase text-paper/55"
					style="letter-spacing: 0.28em;"
				>Reach Us</div>
				<div class="mb-5 font-body text-sm leading-[1.7] text-paper">
					<a href="mailto:info@brooksidecog.com" class="no-underline hover:text-moss">info@brooksidecog.com</a><br />
					<a href="tel:+12056750703" class="no-underline hover:text-moss">(205) 675-0703</a>
				</div>
				<div class="flex gap-4 text-paper/75">
					<a
						href="https://www.facebook.com/brooksidecog"
						aria-label="Facebook"
						class="flex h-[38px] w-[38px] items-center justify-center rounded-full border text-paper/75 transition-colors hover:text-paper"
						style="border-color: rgba(242, 237, 226, 0.18);"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.4 21v-7.8h2.6l.4-3H13.4V8.2c0-.9.2-1.5 1.5-1.5h1.6V4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.4H7.8v3h2.6V21h3z"/></svg>
					</a>
					<a
						href="https://www.youtube.com/@brooksidecog"
						aria-label="YouTube"
						class="flex h-[38px] w-[38px] items-center justify-center rounded-full border text-paper/75 transition-colors hover:text-paper"
						style="border-color: rgba(242, 237, 226, 0.18);"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2c-.2-.9-1-1.6-1.8-1.8C18 5 12 5 12 5s-6 0-7.8.4C3.3 5.6 2.6 6.3 2.4 7.2 2 9 2 12 2 12s0 3 .4 4.8c.2.9 1 1.6 1.8 1.8C6 19 12 19 12 19s6 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.8.4-4.8.4-4.8s0-3-.4-4.8zM10 15V9l5 3-5 3z"/></svg>
					</a>
				</div>
			</div>
		</div>

		<div
			class="flex flex-col justify-between gap-2 pt-7 font-body text-xs text-paper/50 md:flex-row md:items-center"
		>
			<span>© {year} Brookside Church of God</span>
			<span class="font-mono">A 501(c)(3) nonprofit</span>
		</div>
	</div>
</footer>
