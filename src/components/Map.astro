---
interface Props {
	query?: string;
}

const { query = '200 Cardiff St, Brookside, AL' } = Astro.props;

const directionsHref = `https://maps.google.com/?q=${encodeURIComponent(query)}`;
const appleMapsHref = `https://maps.apple.com/?q=${encodeURIComponent(query)}`;
---

<div class="relative overflow-hidden rounded-2xl border hairline bg-ink-deep text-bone noise-grain">
	<div class="absolute inset-0 hero-glow"></div>

	<!-- Decorative compass-rose motif, low opacity -->
	<svg
		aria-hidden="true"
		class="absolute -right-20 -top-20 h-80 w-80 text-bone/[0.06]"
		viewBox="0 0 200 200"
		fill="none"
		stroke="currentColor"
		stroke-width="0.5"
	>
		<circle cx="100" cy="100" r="95" />
		<circle cx="100" cy="100" r="75" />
		<circle cx="100" cy="100" r="55" />
		<path d="M100 5 L105 95 L195 100 L105 105 L100 195 L95 105 L5 100 L95 95 Z" fill="currentColor" opacity="0.5" />
		<line x1="100" y1="5" x2="100" y2="195" />
		<line x1="5" y1="100" x2="195" y2="100" />
		<line x1="29" y1="29" x2="171" y2="171" />
		<line x1="171" y1="29" x2="29" y2="171" />
	</svg>

	<div class="relative z-10 flex h-full min-h-[320px] flex-col justify-between p-8 md:min-h-[380px] md:p-10">
		<div>
			<div class="font-mono text-[11px] uppercase tracking-[0.22em] text-bone/55">
				Find us
			</div>
			<div class="mt-6 font-display text-3xl leading-tight text-bone md:text-4xl">
				200 Cardiff Street
			</div>
			<div class="mt-2 font-display text-xl text-bone/80">Brookside, AL</div>
		</div>

		<div class="mt-10 flex flex-wrap gap-3">
			<a
				href={directionsHref}
				target="_blank"
				rel="noopener"
				class="group inline-flex items-center gap-2 rounded-full bg-bone px-5 py-2.5 text-sm font-medium text-ink-deep transition-colors hover:bg-bone/90"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
				Directions
				<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
			</a>
			<a
				href={appleMapsHref}
				target="_blank"
				rel="noopener"
				class="inline-flex items-center gap-2 rounded-full border border-bone/25 px-5 py-2.5 text-sm font-medium text-bone transition-colors hover:border-bone hover:bg-bone/5"
			>
				Apple Maps
			</a>
		</div>
	</div>
</div>
