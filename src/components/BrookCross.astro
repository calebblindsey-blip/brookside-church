---
interface Props {
	size?: number;
	color?: string;
	class?: string;
}

const { size = 40, color = 'currentColor', class: className = '' } = Astro.props;

// Proportioned cross — Latin proportions, vertical subtly heavier than horizontal.
// 40×40 grid: vertical y=6→34 (h=28), horizontal x=8→32 (w=24) at y=14.
const vw = 4.2;
const hw = 3.4;
---

<svg
	viewBox="0 0 40 40"
	width={size}
	height={size}
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	class={className}
>
	<rect x={20 - vw / 2} y={6} width={vw} height={28} fill={color} />
	<rect x={8} y={14 - hw / 2} width={24} height={hw} fill={color} />
</svg>
