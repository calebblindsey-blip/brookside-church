---
/**
 * Brookside mark — evolved from the church's existing logo.
 *
 * The original sets a geometric gray "B" beside a coral latin cross, which
 * leaves two parallel stems fighting each other. This version interlocks them:
 * the cross's vertical stroke *is* the B's stem, so one form can't exist
 * without the other. The crossbar sits in the upper third at latin-cross
 * proportion, reaching further left than right so the B has room to breathe.
 */
interface Props {
	/** Colour of the B's bowls. */
	letter?: string;
	/** Colour of the cross. */
	cross?: string;
	class?: string;
	style?: string;
	title?: string;
}

const {
	letter = '#D9D9D9',
	cross = '#FF5757',
	class: className = '',
	style,
	title = 'Brookside Church of God',
} = Astro.props;
---

<svg
	viewBox="0 0 48 48"
	role="img"
	aria-label={title}
	class={className}
	style={style}
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
>
	<!-- The two bowls of the B, hung off the cross's vertical stroke -->
	<path
		fill={letter}
		fill-rule="evenodd"
		d="M20 4h10.4c7.1 0 11.6 3.8 11.6 9.4s-4.5 9.4-11.6 9.4H20zm7.4 6.2v6.4h3c2 0 3.4-1.3 3.4-3.2s-1.4-3.2-3.4-3.2zM20 22.8h11.9c7.6 0 12.4 4 12.4 10.1S39.5 43 31.9 43H20zm7.4 6.4v7.4h4.2c2.4 0 4-1.5 4-3.7s-1.6-3.7-4-3.7z"
	/>
	<!-- Latin cross: vertical stroke doubles as the B's stem -->
	<g fill={cross}>
		<rect x="12" y="1" width="8" height="46" />
		<rect x="2.5" y="13.5" width="24" height="8" />
	</g>
</svg>
