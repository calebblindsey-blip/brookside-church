---
/**
 * Brookside mark.
 *
 * This is the CHURCH'S OWN construction, refined, not a new idea: a complete
 * latin cross laid over an intact geometric B, the cross head sitting below
 * the cap so the letter's stem shows above it, and the crossbar collinear with
 * the B's waist so the bar reads as the waist run out to the left.
 *
 * It replaces a fused redraw that shared edges between the two forms. That
 * version gave the crossbar's right arm to the B's top stroke, but the top
 * stroke is drawn in the LETTER colour, so the shape left in the cross colour
 * had a stem and a left arm and nothing else. It was a dagger, not a crucifix,
 * and its stem punched above the cap and down past the baseline, which is what
 * produced the currency-glyph read. Colour never fixed that: it separates the
 * two forms but it cannot add a missing arm.
 *
 * What changed from the church's artwork: even stroke throughout (theirs
 * drifts), the bar moved to a true latin 30%, the cross stem widened to the
 * full stem instead of sitting 2px inside it (that inset leaves a hairline of
 * letter colour down each side which disappears at small sizes and prints
 * badly), and consistent right strokes on both bowls.
 *
 * Stroke is 17.2% of the cap height, not the church's 10.2%. Theirs is drawn
 * to sit alone; here the mark sits directly beside "Brookside" set in
 * Bricolage Grotesque bold, and at their weight it reads visibly lighter than
 * its own wordmark and goes weedy at the 27px chrome size. 17.2% also keeps
 * the header close to the weight it already had, since the mark this replaces
 * was 19%.
 *
 * No mask and no overlapping fills. The letter is one compound path: the outer
 * silhouette is the union of the two bowls, and the counters are wound the
 * other way so fill-rule="nonzero" cuts them as holes. The stem is absent from
 * the outline on purpose, because the bowls already cover it over the whole
 * cap-to-baseline height. The two bowl arcs cross at (37.677, 26.156), solved
 * analytically, so these stay true arcs. That means this file can go straight
 * to a print or engraving vendor.
 *
 * Drawn on a 36-unit cap grid, then fitted to the previous mark's exact
 * footprint (cap 12, baseline 46 in a 48 box) so it is a drop-in and the
 * chrome CSS did not have to move.
 *
 * Generated by branding/brookside-church/assets/proposed/tooling/emit_all.py
 * in Compass, which is the single source for this mark: the same run emits the
 * design-grid SVG, the vendor outline and public/favicon.svg, so the three
 * cannot drift apart. Re-run it rather than editing these paths by hand.
 */
interface Props {
	/** Colour of the B. Defaults to the inherited text colour. */
	letter?: string;
	/** Colour of the cross. */
	cross?: string;
	class?: string;
	style?: string;
	title?: string;
}

const {
	letter = 'currentColor',
	cross = '#FF5757',
	class: className = '',
	style,
	title = 'Brookside Church of God',
} = Astro.props;
---

<svg
	viewBox="0 0 48 48"
	role="img"
	aria-label={title}
	class={className}
	style={style}
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
>
	<!-- The B: outer silhouette, then both counters wound the other way. -->
	<path
		fill={letter}
		fill-rule="nonzero"
		d="M14.131 12H29.997A9.161 9.161 0 0 1 37.677 26.156A10.767 10.767 0 0 1 31.886 46H14.131ZM19.986 24.467H29.997A3.306 3.306 0 0 0 29.997 17.856H19.986ZM19.986 40.144H31.886A4.911 4.911 0 0 0 31.886 30.322H19.986Z"
	/>
	<!-- The cross: whole, both arms, head below the cap, bar on the waist. -->
	<path
		fill={cross}
		d="M14.131 15.238H19.986V24.467H28.769V30.322H19.986V46H14.131V30.322H5.347V24.467H14.131Z"
	/>
</svg>
