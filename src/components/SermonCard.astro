---
interface Props {
	title: string;
	date: string;
	episode?: number | string;
	preacher?: string;
	href?: string;
	scripture?: string;
}

const {
	title,
	date,
	episode,
	preacher = 'Pastor Brad Lindsey',
	href = '/watch',
	scripture,
} = Astro.props;
---

<article class="group relative flex h-full flex-col rounded-2xl border hairline bg-bone p-7 transition-all hover:border-ink/25 hover:shadow-[0_4px_24px_-12px_rgba(31,43,77,0.18)]">
	<div class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
		{date}{episode && ` · Ep ${episode}`}
	</div>
	<h3 class="mt-4 font-display text-xl leading-snug text-ink md:text-2xl">
		<a href={href} class="before:absolute before:inset-0">{title}</a>
	</h3>
	{scripture && (
		<p class="mt-3 font-display text-sm italic text-muted">{scripture}</p>
	)}
	<p class="mt-auto pt-6 text-sm text-muted">{preacher}</p>

	<div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-oxblood">
		<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">▶</span>
		<span class="relative">
			Listen
			<span
				aria-hidden="true"
				class="absolute inset-x-0 -bottom-0.5 h-px origin-left scale-x-0 bg-oxblood transition-transform duration-300 group-hover:scale-x-100"
			></span>
		</span>
	</div>
</article>
