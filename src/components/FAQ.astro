---
interface QA {
	q: string;
	a: string;
}

interface Props {
	items: QA[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-[color:var(--color-stone)] border-y hairline">
	{items.map((item) => (
		<details class="group py-6 open:pb-7">
			<summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left [&::-webkit-details-marker]:hidden">
				<span class="font-display text-lg text-ink md:text-xl">{item.q}</span>
				<span
					aria-hidden="true"
					class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border hairline text-ink transition-transform duration-300 group-open:rotate-45"
				>
					<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
						<path d="M6 1v10M1 6h10" />
					</svg>
				</span>
			</summary>
			<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-charcoal/85" set:html={item.a}></p>
		</details>
	))}
</div>
