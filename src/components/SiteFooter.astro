---
/**
 * The footer from Codex's design. Its first act is the invitation, "Come to"
 * set in the serif above the full lockup, and on the home page the scroll-linked
 * current ends on that lockup's cross: `data-current-destination` is what
 * Motion.astro measures to land it. Keep the attribute on the wordmark image.
 */
import { CHURCH } from '../data/church';
import lockupSource from '../../public/images/brookside-primary.svg?raw';

/*
 * The lead lockup is INLINE so its parts can arrive in sequence on the home
 * page (the cross first, then the words around it; see Motion.astro and the
 * .is-arrived rules in site.css). The paths are the brand file's, byte for
 * byte: this reads public/images/brookside-primary.svg at build time and only
 * ADDS attributes. The file's four paths are, in order, the B (ink), the cross
 * (copper), BROOKSIDE (ink) and CHURCH OF GOD (slate); that order is asserted
 * so a regenerated file with a different structure fails the build rather
 * than animating the wrong part. The header and the footer's bottom lockup
 * stay as <img>, so the invariant on the built HTML is two references per page
 * plus the inline geometry.
 */
const parts = ['b', 'cross', 'wordmark', 'subline'];
let index = 0;
const lockup = lockupSource
	.replace(/<title[^>]*>.*?<\/title>\s*/s, '')
	.replace('<svg ', '<svg class="footer-primary-wordmark" data-current-destination aria-hidden="true" focusable="false" ')
	.replace(/ role="img" aria-labelledby="t"/, '')
	.replace(/<path /g, () => `<path data-part="${parts[index++]}" `);
if (index !== 4) throw new Error(`brookside-primary.svg has ${index} paths, expected 4 (B, cross, wordmark, subline)`);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const here = (href: string) => (href.replace(/\/+$/, '') || '/') === path;
const explore = [
	{ href: '/visit/', label: 'Plan a visit' },
	{ href: '/watch/', label: 'Watch & listen' },
	{ href: '/about/', label: 'About Brookside' },
	{ href: '/what-we-believe/', label: 'What we believe' },
	{ href: '/knowing-christ/', label: 'Knowing Christ' },
	{ href: '/give/', label: 'Give' },
];
const follow = [
	{ href: CHURCH.profiles[0], label: 'Facebook' },
	{ href: CHURCH.profiles[1], label: 'Instagram' },
	{ href: CHURCH.profiles[2], label: 'YouTube' },
	{ href: CHURCH.applePodcastsUrl, label: 'Apple Podcasts' },
	{ href: CHURCH.spotifyUrl, label: 'Spotify' },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-lead">
		<div class="footer-call">
			<p class="eyebrow"><span>There is a place</span> <span>for you here.</span></p>
			<span class="footer-come" aria-hidden="true">Come to</span>
		</div>
		<h2 class="footer-invitation">
			<span class="sr-only">Come to {CHURCH.name}</span>
			<span class="footer-brookside" aria-hidden="true"><Fragment set:html={lockup} /></span>
		</h2>
	</div>
	<div class="footer-grid">
		<div>
			<strong>Find us</strong>
			<p>{CHURCH.street}<br />{CHURCH.locality}, Alabama {CHURCH.postalCode}</p>
			<a href={CHURCH.mapsUrl}>Directions <span class="arrow" aria-hidden="true">↗</span></a>
		</div>
		<div>
			<strong>Reach us</strong>
			<p><a href={CHURCH.phoneHref}>{CHURCH.phone}</a><br /><a href={CHURCH.emailHref}>{CHURCH.email}</a></p>
		</div>
		<nav aria-label="Explore">
			<strong>Explore</strong>
			<ul>{explore.map((item) => <li><a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
		</nav>
		<nav aria-label="Follow">
			<strong>Follow</strong>
			<ul>{follow.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
		</nav>
		<div>
			<strong>Gather</strong>
			<dl class="footer-times">{CHURCH.gatherings.map((g) => <div><dt>{g.name}</dt><dd>{g.time}</dd></div>)}</dl>
		</div>
	</div>
	<div class="footer-bottom">
		<span class="footer-brand"><img class="footer-brand-lockup" src="/images/brookside-primary.svg" width="1384" height="420" alt="" loading="lazy" /></span>
		<span>&copy; {year} · {CHURCH.tagline}</span>
	</div>
</footer>
