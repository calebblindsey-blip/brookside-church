---
/**
 * The line — Direction B's signature, and the one thing the site is meant to be
 * remembered by.
 *
 * One coral line does two jobs at once: it meanders like the creek the town is
 * named for, and where the page reaches its scripture it straightens and grows
 * an arm, becoming the cross from the church's own mark.
 *
 * It spans the DOCUMENT, not the viewport. That distinction is the whole
 * design: a viewport-fixed line floats beside the text as decoration, and its
 * crossbar can only ever form low on the screen, which reads as a lowercase t
 * rather than a cross. Anchored to the document, the meander scrolls away as
 * you read, so by the scripture the visible line is the straight lower run and
 * a bar near the top of the screen gives true latin proportion.
 *
 * Geometry is generated in JS at real pixel dimensions rather than through an
 * SVG viewBox. Fighting preserveAspectRatio here is a dead end: `meet` leaves
 * vertical slack on tall phones, `slice` crops the crossbar off-screen on
 * desktop, and vector-effect="non-scaling-stroke" desyncs getTotalLength() from
 * stroke-dasharray and breaks the draw outright. Generating in px is both
 * exact and less code.
 */
interface Props {
	/**
	 * CSS selector for the element the cross should form at. Omit on pages with
	 * no scripture moment and the line simply runs without growing an arm.
	 */
	crossAt?: string;
}

const { crossAt } = Astro.props;
---

<svg class="thread" aria-hidden="true" fill="none" data-cross-at={crossAt}>
	<path data-thread-path stroke="#FF5757" stroke-linecap="butt" />
	<path data-thread-bar stroke="#FF5757" stroke-linecap="butt" />
</svg>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const svg = document.querySelector<SVGSVGElement>('.thread');
	const path = document.querySelector<SVGPathElement>('[data-thread-path]');
	const bar = document.querySelector<SVGPathElement>('[data-thread-bar]');
	const anchorSel = svg?.dataset.crossAt;
	const anchor = anchorSel ? document.querySelector<HTMLElement>(anchorSel) : null;
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (svg && path && bar) {
		let pathLen = 0;
		let barLen = 0;
		let lenAtBar = 0;
		let samples: { len: number; y: number }[] = [];
		let barDrawn = false;
		/** Set once the scripture is actually on screen. */
		let barArmed = false;
		/** True while the opening draw-in owns the line; scroll leaves it alone. */
		let intro = false;
		let introPlayed = false;
		/** How far below the reading position the head of the line sits. */
		const HEAD = 0.96;

		/** Distance along the path at which it first reaches a given y. */
		function lengthAtY(y: number) {
			for (let i = 1; i < samples.length; i++) {
				if (samples[i].y >= y) {
					const a = samples[i - 1];
					const b = samples[i];
					const t = b.y === a.y ? 0 : (y - a.y) / (b.y - a.y);
					return a.len + (b.len - a.len) * t;
				}
			}
			return pathLen;
		}

		/**
		 * The head of the line sits a little below where you have read to, so the
		 * line is always being drawn just ahead of you rather than trailing. The
		 * lead shrinks to nothing at the end of the document so the line finishes
		 * exactly at the foot of the page instead of stopping short.
		 */
		function drawToScroll() {
			if (!path || intro) return;
			const vh = window.innerHeight;
			const maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
			const t = Math.min(1, window.scrollY / maxScroll);
			const head = window.scrollY + vh * (HEAD + (1 - HEAD) * t);
			const drawn = Math.min(pathLen, lengthAtY(head));
			path.style.strokeDashoffset = `${pathLen - drawn}`;

			// The cross forms on two conditions, not one: the scripture has to be on
			// screen to read, and the line has to have already run past the crossbar.
			// Firing on the line alone puts the moment a screen early; firing on the
			// scripture alone can grow an arm off nothing.
			if (!barDrawn && barArmed && drawn >= lenAtBar && bar) {
				barDrawn = true;
				gsap.to(bar, { strokeDashoffset: 0, duration: 0.75, ease: 'power3.inOut' });
			}
		}

		function build() {
			if (!svg || !path || !bar) return;
			const docH = document.documentElement.scrollHeight;
			const vh = window.innerHeight;
			// Measured off the element, not read off the custom property:
			// getComputedStyle hands back an unresolved clamp() for --rail.
			const rail = svg.getBoundingClientRect().width;
			if (!rail || !docH) return;

			const cx = rail / 2;
			const stroke = Math.min(9, Math.max(5, rail * 0.17));
			// Held well inside the rail on both sides: swinging the full width makes
			// the line read as unruly rather than as the page's spine, and it goes
			// tangent to the viewport edge at the widest bends.
			const amp = rail * 0.28;

			svg.style.height = `${docH}px`;
			svg.setAttribute('viewBox', `0 0 ${rail} ${docH}`);
			path.setAttribute('stroke-width', String(stroke));
			bar.setAttribute('stroke-width', String(stroke));

			// Put the crossbar where the scripture will be sitting in the upper third
			// of the screen, the proportion that reads as a latin cross.
			const anchorMid = anchor ? anchor.offsetTop + anchor.offsetHeight / 2 : docH * 0.62;
			const barY = Math.min(docH - stroke, Math.max(vh * 0.5, anchorMid - vh * 0.18));
			// The line must already be straight well before it gets there.
			const meanderEnd = Math.max(vh * 0.6, barY - vh * 0.42);

			// Serpentine: vertical tangents at every node, so it reads as water
			// rather than as a zigzag. Bend count follows the distance covered.
			const bends = Math.min(7, Math.max(3, Math.round(meanderEnd / 620)));
			let d = `M${cx} 0`;
			let px = cx;
			let py = 0;
			for (let i = 0; i < bends; i++) {
				const y = (meanderEnd * (i + 1)) / bends;
				const x = i === bends - 1 ? cx : i % 2 === 0 ? cx + amp : cx - amp;
				const dy = (y - py) * 0.55;
				d += ` C${px} ${py + dy}, ${x} ${y - dy}, ${x} ${y}`;
				px = x;
				py = y;
			}
			d += ` L${cx} ${docH}`;
			path.setAttribute('d', d);

			// Kept inside the rail: an arm long enough to overhang the viewport edge
			// gets clipped, which reads as a broken cross.
			const arm = Math.max(stroke * 2, cx - stroke / 2 - 4);
			bar.setAttribute('d', anchor ? `M${cx - arm} ${barY} L${cx + arm} ${barY}` : '');

			pathLen = path.getTotalLength();
			barLen = anchor ? bar.getTotalLength() : 0;

			// Sample the path so scroll position can be converted to draw length.
			samples = [];
			const steps = 240;
			for (let i = 0; i <= steps; i++) {
				const len = (pathLen * i) / steps;
				samples.push({ len, y: path.getPointAtLength(len).y });
			}
			lenAtBar = lengthAtY(barY);

			path.style.strokeDasharray = `${pathLen}`;
			bar.style.strokeDasharray = `${barLen}`;

			if (reduced) {
				path.style.strokeDashoffset = '0';
				bar.style.strokeDashoffset = '0';
				barDrawn = true;
			} else if (!introPlayed) {
				// The line enters with the page rather than snapping into place.
				introPlayed = true;
				intro = true;
				const target = pathLen - Math.min(pathLen, lengthAtY(window.scrollY + vh * HEAD));
				bar.style.strokeDashoffset = `${barLen}`;
				gsap.fromTo(path,
					{ strokeDashoffset: pathLen },
					{
						strokeDashoffset: target, duration: 1.5, ease: 'power2.out', delay: 0.15,
						onComplete: () => { intro = false; drawToScroll(); },
					},
				);
			} else {
				if (!barDrawn) bar.style.strokeDashoffset = `${barLen}`;
				drawToScroll();
			}
		}

		build();

		if (!reduced) {
			ScrollTrigger.create({
				trigger: document.body,
				start: 'top top',
				end: 'bottom bottom',
				onUpdate: drawToScroll,
				onRefresh: build,
			});

			if (anchor) {
				ScrollTrigger.create({
					trigger: anchor,
					start: 'top 60%',
					once: true,
					onEnter: () => { barArmed = true; drawToScroll(); },
				});
			}

			let resizeTimer: number;
			window.addEventListener('resize', () => {
				window.clearTimeout(resizeTimer);
				resizeTimer = window.setTimeout(() => { build(); ScrollTrigger.refresh(); }, 160);
			});
			document.fonts?.ready.then(() => { build(); ScrollTrigger.refresh(); });
		}
	}
</script>
