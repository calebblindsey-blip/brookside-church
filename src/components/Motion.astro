---
/**
 * The motion system from Codex's design, as one island.
 *
 * Ported from app/motion.tsx in calebblindsey-blip/brookside-church-website. The
 * React effect became a plain script with the same three jobs:
 *
 *   1. Honour prefers-reduced-motion and the visitor's own pause. `.motion-paused`
 *      on <html> freezes every loop and returns scroll-linked layout to rest;
 *      `.motion-active` is what the transitions key off.
 *   2. Lay out the home page's "current": one SVG path measured against the
 *      [data-site] shell, bending section to section from the hero's ribbon field
 *      to the cross of the footer lockup ([data-current-destination]), and drawn
 *      as the reader scrolls via --page-progress.
 *   3. Reveal content as it enters, with a per-frame recheck because
 *      IntersectionObserver can miss callbacks when the clipped shell is restored
 *      or scrolled before the script runs. Readable content must never stay dim.
 *
 * Plus the hero ribbons, which sway on a throttled rAF loop and lean toward the
 * pointer, and stop when the hero is off screen or the tab is hidden.
 *
 * WHY THE TOGGLE RENDERS ENABLED. The React version disabled it until hydration;
 * here the script runs before first paint settles, so the button is live from
 * the start and the label is set on the first apply().
 */
---

<button type="button" class="motion-toggle" aria-label="Pause motion" aria-pressed="false">
	<span aria-hidden="true" data-glyph>Ⅱ</span><span data-label>Pause motion</span>
</button>

<script>
	import { progressAtY } from '../lib/river-progress';

	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('.motion-toggle');
	const glyph = toggle?.querySelector<HTMLElement>('[data-glyph]');
	const label = toggle?.querySelector<HTMLElement>('[data-label]');
	const preference = window.matchMedia('(prefers-reduced-motion: reduce)');

	let userPaused = false;
	let stopMotion: (() => void) | null = null;
	let stopRibbons: (() => void) | null = null;

	/** Everything scroll-linked. Returns its own teardown. */
	function startMotion(paused: boolean): () => void {
		root.classList.toggle('motion-paused', paused);
		// The shell wraps header, main, and footer. Section offsets and the river
		// canvas are measured against it so the current can end inside the footer.
		const stage = document.querySelector<HTMLElement>('[data-site]') ?? document.querySelector('main');
		const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section, .site-footer'));
		let riverSamples: number[] = [];

		const updateRiverProgress = () => {
			if (!stage) return;
			// Keep the tip in the reading area, not beyond the viewport. Path distance
			// and document scroll percentage differ because of the river's bends. In
			// the final stretch, let the viewport complete the current into Brookside.
			const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
			const scrollProgress = Math.min(1, window.scrollY / maxScroll);
			const endingPull = Math.max(0, Math.min(1, (scrollProgress - 0.82) / 0.18));
			const readingY = window.scrollY + window.innerHeight * (0.6 + endingPull * 0.4) - stage.offsetTop;
			root.style.setProperty('--page-progress', String(progressAtY(riverSamples, readingY)));
		};

		// Follow actual section boundaries, beginning in the hero's creek and ending
		// beneath the cross inside the opening B at every screen size.
		const layoutRiver = () => {
			if (!stage || sections.length < 2) return;
			const svg = document.querySelector<SVGSVGElement>('.page-current svg');
			if (!svg) return;
			const heroFlow = document.querySelector<HTMLElement>('.hero-flow');
			const destination = document.querySelector<HTMLElement>('[data-current-destination]');
			const stageRect = stage.getBoundingClientRect();
			const flowRect = heroFlow?.getBoundingClientRect();
			const destinationRect = destination?.getBoundingClientRect();
			const storySections = sections.filter((section) => section.tagName === 'SECTION');
			if (!storySections.length) return;
			const width = stage.clientWidth;
			const height = stage.offsetHeight;
			svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

			// The start sits inside the lower edge of the animated ribbon field, so the
			// narrow page current reads as one strand flowing out of the wider creek.
			let x = flowRect
				? Math.max(0, Math.min(width, flowRect.left - stageRect.left + flowRect.width * 0.7))
				: width * 0.78;
			let y = storySections[0].offsetTop + storySections[0].offsetHeight - 24;
			let path = `M${x} ${y}`;

			storySections.slice(1).forEach((section, index) => {
				const nextX = width * (index % 2 === 0 ? 0.055 : 0.945);
				const nextY = section.offsetTop + section.offsetHeight - 50;
				const bend = Math.max(100, (nextY - y) * 0.7);
				path += ` C${x} ${y + bend} ${nextX} ${nextY - bend} ${nextX} ${nextY}`;
				x = nextX;
				y = nextY;
			});

			// Meet the centre of the cross's top edge in the 1384 x 420 lockup:
			// x=143.49 / y=133.72 after its embedded transform.
			const targetX = destinationRect
				? destinationRect.left - stageRect.left + destinationRect.width * 0.104
				: width * 0.1;
			const targetY = destinationRect
				? destinationRect.top - stageRect.top + destinationRect.height * 0.318
				: height - 520;
			const finalDistance = Math.max(120, targetY - y);
			path += ` C${x} ${y + finalDistance * 0.42} ${targetX} ${targetY - finalDistance * 0.38} ${targetX} ${targetY}`;

			svg.querySelectorAll('path').forEach((line) => line.setAttribute('d', path));
			const progressPath = svg.querySelector<SVGPathElement>('.current-progress');
			if (progressPath) {
				const length = progressPath.getTotalLength();
				riverSamples = Array.from({ length: 513 }, (_, index) => progressPath.getPointAtLength((length * index) / 512).y);
			}
			updateRiverProgress();
		};

		layoutRiver();
		const resizeObserver = new ResizeObserver(layoutRiver);
		if (stage) resizeObserver.observe(stage);

		if (paused) {
			root.classList.remove('motion-active');
			return () => resizeObserver.disconnect();
		}

		const items = Array.from(document.querySelectorAll<HTMLElement>(
			'.section-pad h2, blockquote, .scripture-note, .layered-card, .visit-details article, .watch-feature, .platform-links a, .mission-grid, .inner-section h2, .detail-list article, .method-grid article, .identity-list article, .leader-list article, .gospel-grid article, .belief-list li, .platform-cards a, .archive-panel, .footer-lead',
		));
		items.forEach((item, index) => {
			item.classList.add('motion-item');
			item.style.setProperty('--reveal-delay', `${(index % 3) * 70}ms`);
		});
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.08 });
		items.forEach((item) => observer.observe(item));
		// IntersectionObserver can miss callbacks when the page's clipped shell is
		// restored or scrolled before this runs. Recheck geometry during the
		// existing scroll frame so readable content can never stay clipped.
		const revealVisibleItems = () => {
			const revealLine = window.innerHeight * 0.94;
			items.forEach((item) => {
				if (item.classList.contains('is-visible')) return;
				const bounds = item.getBoundingClientRect();
				if (bounds.top <= revealLine && bounds.bottom >= 0) {
					item.classList.add('is-visible');
					observer.unobserve(item);
				}
			});
		};
		root.classList.add('motion-active');

		let frame = 0;
		const update = () => {
			const height = window.innerHeight;
			revealVisibleItems();
			updateRiverProgress();
			sections.forEach((section) => {
				const bounds = section.getBoundingClientRect();
				if (bounds.bottom >= -height && bounds.top <= height * 2) {
					const progress = Math.max(-1, Math.min(1, (height * 0.5 - (bounds.top + bounds.height * 0.5)) / height));
					section.style.setProperty('--drift', `${progress * 50}px`);
					section.style.setProperty('--turn', `${progress * 3}deg`);
					const entrance = Math.max(0, Math.min(1, (height - bounds.top) / (height * 0.8)));
					section.style.setProperty('--entrance', String(entrance));
				}
			});
			frame = 0;
		};
		const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
		update();
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		return () => {
			observer.disconnect();
			resizeObserver.disconnect();
			cancelAnimationFrame(frame);
			window.removeEventListener('scroll', schedule);
			window.removeEventListener('resize', schedule);
			root.classList.remove('motion-active');
		};
	}

	/** The hero ribbon sway. Only runs while motion is on and the hero is on screen. */
	function startRibbons(): (() => void) | null {
		const hero = document.querySelector<HTMLElement>('.hero');
		const ribbons = Array.from(document.querySelectorAll<SVGPathElement>('[data-ribbon]'));
		if (!hero || !ribbons.length) return null;
		let frame = 0;
		let visible = true;
		let last = 0;
		let phase = 0;
		let cursor = 0;
		let target = 0;
		const animate = (time: number) => {
			if (!visible || document.hidden) { frame = 0; return; }
			if (time - last >= 32) {
				phase += Math.min(time - last, 48) * 0.0003;
				last = time;
				cursor += (target - cursor) * 0.06;
				ribbons.forEach((ribbon, index) => {
					const offset = index * 15;
					const wave = Math.sin(phase + index * 0.085) * 55;
					const sway = Math.cos(phase * 0.7 + index * 0.07) * 35 + cursor;
					ribbon.setAttribute('d', `M${350 + offset + wave} -100 C${-80 + offset + sway} 180 ${890 + offset - wave} 230 ${410 + offset + sway} 500 S${190 + offset - wave} 820 ${770 + offset + sway} 1000`);
				});
			}
			frame = requestAnimationFrame(animate);
		};
		const start = () => { if (!frame && visible && !document.hidden) { last = performance.now(); frame = requestAnimationFrame(animate); } };
		const move = (event: PointerEvent) => {
			if (event.pointerType === 'touch') return;
			const bounds = hero.getBoundingClientRect();
			target = ((event.clientX - bounds.left) / bounds.width - 0.5) * 90;
		};
		const leave = () => { target = 0; };
		const visibility = new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting;
			if (visible) start();
			else { cancelAnimationFrame(frame); frame = 0; }
		});
		visibility.observe(hero);
		hero.addEventListener('pointermove', move, { passive: true });
		hero.addEventListener('pointerleave', leave);
		document.addEventListener('visibilitychange', start);
		start();
		return () => {
			cancelAnimationFrame(frame);
			visibility.disconnect();
			hero.removeEventListener('pointermove', move);
			hero.removeEventListener('pointerleave', leave);
			document.removeEventListener('visibilitychange', start);
		};
	}

	function apply() {
		const reduce = preference.matches;
		const paused = userPaused || reduce;
		stopMotion?.();
		stopRibbons?.();
		stopRibbons = null;
		stopMotion = startMotion(paused);
		if (!paused) stopRibbons = startRibbons();
		if (toggle) {
			toggle.setAttribute('aria-pressed', String(paused));
			toggle.disabled = reduce;
			if (glyph) glyph.textContent = paused ? '▷' : 'Ⅱ';
			// aria-label and the visible label are set from ONE string. The button
			// collapses to its glyph and only shows the text on hover or focus, so the
			// aria-label is the whole accessible name most of the time; it used to be a
			// static "Pause site motion" that never moved while the visible text changed
			// to "Enable motion", which both lies to a screen reader and breaks WCAG
			// 2.5.3 for voice control ("click Enable motion" would not match the name).
			const text = reduce ? 'Reduced motion' : paused ? 'Enable motion' : 'Pause motion';
			if (label) label.textContent = text;
			toggle.setAttribute('aria-label', text);
		}
	}

	preference.addEventListener('change', apply);
	toggle?.addEventListener('click', () => { userPaused = !userPaused; apply(); });
	apply();
</script>
