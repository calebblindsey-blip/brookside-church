---
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/visit', label: 'Visit' },
	{ href: '/watch', label: 'Watch' },
	{ href: '/about', label: 'About' },
];
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b hairline bg-bone/85 backdrop-blur">
	<div class="section-shell flex items-center justify-between py-5">
		<a href="/" class="font-display text-xl tracking-tight text-ink">
			Brookside <span class="text-oxblood">/</span> COG
		</a>

		<!-- Desktop nav -->
		<nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
			{nav.map((item) => (
				<a
					href={item.href}
					class:list={[
						'text-sm transition-colors hover:text-ink',
						isActive(item.href) ? 'text-ink' : 'text-muted',
					]}
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href="/give"
				class="inline-flex items-center rounded-full bg-oxblood px-5 py-2 text-sm font-medium text-bone transition-colors hover:bg-oxblood-hover"
			>
				Give
			</a>

			<!-- Mobile hamburger -->
			<button
				type="button"
				id="menu-toggle"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-nav"
				class="flex h-10 w-10 items-center justify-center rounded-full border hairline text-ink md:hidden"
			>
				<svg class="menu-icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
					<path d="M2 5h14M2 9h14M2 13h14" />
				</svg>
				<svg class="menu-icon-close hidden" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
					<path d="M4 4l10 10M14 4l-10 10" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile nav panel -->
	<nav
		id="mobile-nav"
		aria-label="Primary mobile"
		class="hidden border-t hairline bg-bone md:hidden"
	>
		<ul class="section-shell flex flex-col divide-y divide-[color:var(--color-stone)] py-2">
			{nav.map((item) => (
				<li>
					<a
						href={item.href}
						class:list={[
							'flex items-center justify-between py-4 font-display text-lg transition-colors',
							isActive(item.href) ? 'text-ink' : 'text-charcoal hover:text-ink',
						]}
					>
						{item.label}
						<span aria-hidden="true" class="text-muted">→</span>
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<script is:inline>
	(() => {
		const btn = document.getElementById('menu-toggle');
		const panel = document.getElementById('mobile-nav');
		if (!btn || !panel) return;
		const iconOpen = btn.querySelector('.menu-icon-open');
		const iconClose = btn.querySelector('.menu-icon-close');
		btn.addEventListener('click', () => {
			const open = panel.classList.toggle('hidden') === false;
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			iconOpen?.classList.toggle('hidden', open);
			iconClose?.classList.toggle('hidden', !open);
		});
	})();
</script>
