---
import BrookCross from './BrookCross.astro';

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/visit', label: 'Visit' },
	{ href: '/watch', label: 'Watch' },
];
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header
	class="sticky top-0 z-50 border-b bg-midnight text-paper"
	style="border-color: rgba(242, 237, 226, 0.10);"
>
	<div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-5 md:px-14 md:py-6">
		<!-- Wordmark + cross -->
		<a href="/" class="inline-flex items-center gap-3 text-paper no-underline md:gap-3.5">
			<BrookCross size={26} color="currentColor" />
			<span class="flex flex-col items-start gap-1.5">
				<span
					class="font-tight text-[26px] font-medium leading-none"
					style="letter-spacing: -0.02em;"
				>BROOKSIDE</span>
				<span
					class="font-tight text-[6.5px] font-normal uppercase leading-none text-paper/[0.68]"
					style="letter-spacing: 0.34em;"
				>Church of God</span>
			</span>
		</a>

		<!-- Desktop nav -->
		<div class="hidden items-center gap-8 md:flex">
			{nav.map((item) => (
				<a
					href={item.href}
					class:list={[
						'inline-flex items-center gap-2.5 font-body text-xs font-medium uppercase no-underline transition-colors',
						isActive(item.href) ? 'text-paper' : 'text-paper/65 hover:text-paper/90',
					]}
					style="letter-spacing: 0.22em;"
				>
					{isActive(item.href) && (
						<span class="block h-[5px] w-[5px] rounded-full bg-moss"></span>
					)}
					{item.label}
				</a>
			))}
			<span class="block h-[18px] w-px bg-paper/20"></span>
			<a
				href="/give"
				class="inline-flex items-center gap-2.5 font-body text-xs font-medium uppercase text-moss no-underline transition-opacity hover:opacity-80"
				style="letter-spacing: 0.22em;"
			>
				<span class="block h-1.5 w-1.5 rounded-full bg-moss"></span>
				Give
			</a>
		</div>

		<!-- Mobile hamburger -->
		<button
			type="button"
			id="menu-toggle"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
			class="flex h-10 w-10 items-center justify-center rounded-full border text-paper md:hidden"
			style="border-color: rgba(242, 237, 226, 0.18);"
		>
			<svg class="menu-icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
				<path d="M2 5h14M2 9h14M2 13h14" />
			</svg>
			<svg class="menu-icon-close hidden" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
				<path d="M4 4l10 10M14 4l-10 10" />
			</svg>
		</button>
	</div>

	<!-- Mobile nav panel -->
	<nav
		id="mobile-nav"
		aria-label="Primary mobile"
		class="hidden border-t md:hidden"
		style="border-color: rgba(242, 237, 226, 0.10);"
	>
		<ul class="mx-auto flex max-w-[1200px] flex-col px-6 py-2" style="border-color: rgba(242, 237, 226, 0.10);">
			{nav.map((item) => (
				<li class="border-b last:border-b-0" style="border-color: rgba(242, 237, 226, 0.08);">
					<a
						href={item.href}
						class:list={[
							'flex items-center justify-between py-4 font-display text-lg transition-colors',
							isActive(item.href) ? 'text-paper' : 'text-paper/75 hover:text-paper',
						]}
					>
						{item.label}
						<span aria-hidden="true" class="text-paper/40">→</span>
					</a>
				</li>
			))}
			<li>
				<a
					href="/give"
					class="flex items-center justify-between py-4 font-display text-lg text-moss transition-colors"
				>
					Give
					<span aria-hidden="true" class="text-moss/60">→</span>
				</a>
			</li>
		</ul>
	</nav>
</header>

<script is:inline>
	(() => {
		const btn = document.getElementById('menu-toggle');
		const panel = document.getElementById('mobile-nav');
		if (!btn || !panel) return;
		const iconOpen = btn.querySelector('.menu-icon-open');
		const iconClose = btn.querySelector('.menu-icon-close');
		btn.addEventListener('click', () => {
			const open = panel.classList.toggle('hidden') === false;
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			iconOpen?.classList.toggle('hidden', open);
			iconClose?.classList.toggle('hidden', !open);
		});
	})();
</script>
