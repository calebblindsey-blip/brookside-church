---
/**
 * The site shell, in Codex's design (ported September 2026 from
 * calebblindsey-blip/brookside-church-website; plan in Compass at
 * projects/personal/brookside-church-website/PLAN.md).
 *
 * This is the only layout. BaseLayout (Reverent & Modern) and Direction B's
 * shared rules were deleted at the end of the port; every page carries the
 * analytics tag through this file.
 *
 * Fonts are imported as JS side effects rather than @import in CSS: @fontsource
 * @import inside Tailwind-scoped CSS fails under rolldown. Keep this pattern.
 * DM Sans is the opsz build so the display sizes get the optical-size axis the
 * brand wordmark was set with; Instrument Serif is one weight with a true italic,
 * and both styles load so every <em> uses that italic rather than a slant.
 */
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
/*
 * The latin faces, imported again as URLs so they can be preloaded.
 *
 * The CSS above is what declares them; this is only how their hashed build
 * filenames become knowable at author time. Vite rewrites both to the same
 * emitted asset, so the preload and the @font-face point at one file and the
 * browser fetches it once.
 */
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifLatinItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Motion from '../components/Motion.astro';
import ChurchSchema from '../components/ChurchSchema.astro';

interface Props {
	title?: string;
	description?: string;
	/** Page-level class on the shell, e.g. "home" for the page current's layout. */
	class?: string;
	/**
	 * The 404 page only. Pages serves /404.html with a 404 status for unknown
	 * paths, but a direct request for /404 is a 200, so without this Google can
	 * index "Page not found" as a result. A noindex page carries no canonical.
	 */
	noindex?: boolean;
}

const {
	title = 'Brookside Church of God',
	description = 'A Christ-centered church family in Brookside, Alabama. Sunday School at 9:45 AM, Morning Worship at 10:45 AM, or watch online anytime.',
	class: pageClass,
	noindex = false,
} = Astro.props;

const fullTitle =
	title === 'Brookside Church of God' ? title : `${title} · Brookside Church of God`;

/*
 * Social preview. Until this shipped, every link shared to Facebook or sent in
 * a text rendered with no image at all, on both this build and the live
 * Squarespace site.
 *
 * The image resolves against `site` in astro.config.mjs, so the URL is the
 * apex, not the pages.dev host. That is correct for where this is going and
 * wrong for right now: previews will not resolve until the DNS cutover lands.
 * Do not "fix" it by hardcoding pages.dev, which would break at cutover.
 */
/*
 * Analytics. The SAME GA4 property the Squarespace site has used since December
 * 2022, deliberately, and this is the whole point of it.
 *
 * WHY NOT A NEW PROPERTY. A new one starts the trend series over on the day
 * DNS moves, which is the exact day 292 indexed podcast URLs collapse into
 * /watch/. A successful consolidation and a traffic collapse both look like
 * "the numbers went down", and with a fresh property there is no way to tell
 * them apart. Reusing the ID is what makes the migration falsifiable.
 *
 * WHY NOT CLOUDFLARE WEB ANALYTICS, which design.md picked. That decision was
 * made in April without accounting for GA4 already running on the live site, so
 * it reads as a privacy choice but would in practice have been a continuity
 * loss with no privacy gain. Superseded 2026-08-24; the reasoning is recorded
 * in design.md rather than only here.
 *
 * WHY NOT COOKIELESS MODE. gtag with client_storage:'none' looks like it
 * threads the needle. It does not: with no persisted client id, sessions cannot
 * be stitched and session counts inflate, which breaks the one comparison this
 * tag exists to support.
 *
 * THIS FIRES ON THE PAGES.DEV PREVIEW TOO, on purpose. The tag has to be
 * verified working before the cutover, not after, and preview volume is
 * trivial. Segment it out at analysis time with the hostName dimension rather
 * than with a GA4 data filter, which is not retroactive and silently drops real
 * traffic when it is drawn too wide.
 */
const GA_MEASUREMENT_ID = 'G-1FL38RQRQL';

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = new URL('/og-brookside.jpg', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/*
			Font preloads, first in the head and before anything else can compete.

			WHAT THIS FIXES, measured rather than assumed. On an emulated Pixel 5 at
			4x CPU throttle and slow 4G, /what-we-believe scored CLS 0.143 against a
			0.1 budget. Blocking every .woff2 request dropped it to 0.0015, which is
			what identified the cause: the fonts are declared inside bundled CSS, so
			the browser cannot discover them until that CSS parses, and the page has
			already painted in system-ui by then. Sixteen articles of text then
			reflow when the real faces arrive.

			Only the two latin subsets are preloaded. Preloading latin-ext and
			vietnamese as well would spend bandwidth on files this congregation will
			not use, and a preload the browser does not consume within a few seconds
			is a console warning and wasted transfer.

			crossorigin is required even though these are same-origin: fonts are
			fetched in CORS mode, and without it the preload is ignored and the file
			is fetched a second time.
		*/}
		<link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={serifLatinItalic} as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		{/*
			Two things here are load-bearing and both fail SILENTLY if changed.

			`is:inline` stops Astro bundling these into a module. A bundled gtag
			renders fine, errors nothing, and sends no hit at all.

			`window.gtag = ...` rather than Google's own `function gtag()`.
			`define:vars` wraps the script in an IIFE to scope the injected
			constant, which puts a bare function declaration inside the closure
			instead of on window. The config call below still works, so page
			views arrive and everything looks correct, but every later
			`gtag('event', ...)` from any other script hits an undefined global
			and does nothing. That is the key-event tracking this site still has
			to add, so the assignment is explicit.
		*/}
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
		<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
			window.dataLayer = window.dataLayer || [];
			window.gtag = function gtag() { window.dataLayer.push(arguments); };
			window.gtag('js', new Date());
			window.gtag('config', GA_MEASUREMENT_ID);
		</script>
		{/*
			Contact intent, measured.

			The old Squarespace /contact-us page took 607 sessions and shipped no
			working <form> at all, and nobody noticed for years, because nothing
			on it was ever instrumented. There was no number to look at. That is
			the actual failure worth not repeating: not the missing form, the
			missing measurement.

			ONE DELEGATED LISTENER RATHER THAN PER-LINK MARKUP. These links live
			in the footer and on /visit today and will land on other pages later.
			Annotating each one means the next person to add a phone number
			silently adds an unmeasured one, which is how the original hole
			opened. Listening on document catches every link that ever exists,
			including ones rendered after this runs.

			Attached in <head> deliberately: the listener is on document, not on
			the anchors, so it does not care whether the DOM has been parsed yet.
		*/}
		<script is:inline>
			document.addEventListener('click', function (e) {
				var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
				if (!a) return;
				var href = a.getAttribute('href') || '';
				/* An explicit name wins over sniffing. The giving links go to
				   Church Center and PayPal, and matching those by hostname would
				   put a vendor list in here that rots the day the church changes
				   processor. A link that knows what it is says so. */
				var name = a.getAttribute('data-ga-event');
				if (!name) {
					if (href.indexOf('tel:') === 0) name = 'phone_click';
					else if (href.indexOf('mailto:') === 0) name = 'email_click';
					else if (/google\.[a-z.]+\/maps|maps\.app\.goo\.gl/.test(href)) name = 'directions_click';
				}
				if (!name) return;
				/* Optional-call: if the tag is blocked by an extension, a dead
				   gtag must not take the click's default behaviour down with it.
				   Calling the phone still has to work when analytics does not. */
				if (window.gtag) window.gtag('event', name, {
					link_url: href,
					page_path: window.location.pathname,
				});
			});
		</script>
		{/*
			Three icons, not one. The SVG is what modern browsers take. The .ico is
			what everything else asks for by name whether it is declared or not, so
			a missing one is a 404 and a blank tab rather than a graceful fallback.
			The touch icon is the only one with a background, because iOS
			composites transparency onto black. All three are generated from
			favicon.svg by engine/scripts/make-brookside-favicons.mjs in Compass.
		*/}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Brookside Church of God" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="632" />
		<meta
			property="og:image:alt"
			content="Brookside Church of God on Cardiff Street: a brick building with a white gable, a bell tower, and two crosses against a blue sky."
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="theme-color" content="#fcfcf9" />
		<ChurchSchema />
	</head>
	<body>
		{/*
			One shell for every page: skip link first, then header, main, footer, and
			the fixed motion control last so it never sits ahead of the content in tab
			order. `decoration` is for page-level art that sits between header and
			main (the home page's current). `main` is not positioned, so section
			offsets stay relative to the shell, which the current's layout depends on.
		*/}
		<div class:list={['site', pageClass]} data-site>
			<a class="skip-link" href="#content">Skip to content</a>
			<SiteHeader />
			<slot name="decoration" />
			<main id="content" tabindex="-1"><slot /></main>
			<SiteFooter />
			<Motion />
		</div>
	</body>
</html>
