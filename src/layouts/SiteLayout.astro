---
/**
 * The Direction B layout. New pages use this.
 *
 * `BaseLayout.astro` is the legacy Reverent & Modern shell and still carries
 * /visit and /design-system until those are migrated. The two do not share
 * tokens, components, or CSS, so they can coexist without bleeding into each
 * other. Delete BaseLayout once the last page is off it.
 *
 * Fonts are imported here as JS side effects rather than @import in CSS:
 * @fontsource @import inside Tailwind-scoped CSS fails under rolldown. Keep
 * this pattern.
 */
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/public-sans';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Thread from '../components/Thread.astro';

interface Props {
	title?: string;
	description?: string;
	/** Selector the line's crossbar forms at. Omit for pages with no scripture. */
	crossAt?: string;
}

const {
	title = 'Brookside Church of God',
	description = 'A church in Brookside, Alabama, working through the Bible a passage at a time. Sunday worship 10:45 AM.',
	crossAt,
} = Astro.props;

const fullTitle =
	title === 'Brookside Church of God' ? title : `${title} · Brookside Church of God`;

/*
 * Social preview. Until this shipped, every link shared to Facebook or sent in
 * a text rendered with no image at all, on both this build and the live
 * Squarespace site.
 *
 * The image resolves against `site` in astro.config.mjs, so the URL is the
 * apex, not the pages.dev host. That is correct for where this is going and
 * wrong for right now: previews will not resolve until the DNS cutover lands.
 * Do not "fix" it by hardcoding pages.dev, which would break at cutover.
 */
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = new URL('/og-brookside.jpg', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{/*
			Three icons, not one. The SVG is what modern browsers take. The .ico is
			what everything else asks for by name whether it is declared or not, so
			a missing one is a 404 and a blank tab rather than a graceful fallback.
			The touch icon is the only one with a background, because iOS
			composites transparency onto black. All three are generated from
			favicon.svg by engine/scripts/make-brookside-favicons.mjs in Compass.
		*/}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Brookside Church of God" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="632" />
		<meta
			property="og:image:alt"
			content="Brookside Church of God on Cardiff Street: a brick building with a white gable, a bell tower, and two crosses against a blue sky."
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#fafaf8" />
	</head>
	<body>
		<Thread crossAt={crossAt} />
		<SiteHeader />
		<main><slot /></main>
		<SiteFooter />
	</body>
</html>
